def main(argv=None) -> int:
    argv = list(sys.argv[1:] if argv is None else argv)
    if not argv or argv[0] in ("help", "-h", "--help"):
        print_help()
        return 0
    cmd, rest = argv[0], argv[1:]
    if cmd in EXPECTED:
        return run_scan(cmd, rest)
    if cmd == "list":
        return cmd_list(rest)
    if cmd == "show":
        return cmd_show(rest)
    if cmd == "status":
        return cmd_status(rest)
    if cmd == "rules":
        return cmd_rules(rest)
    if cmd == "doctor":
        return cmd_doctor(rest)
    print(f"RALAT: perintah tidak dikenali: {cmd}", file=sys.stderr)
    print("Guna `kimscan help` untuk senarai perintah.", file=sys.stderr)
    return 1


if __name__ == "__main__":
    sys.exit(main())

def cmd_status(argv: list) -> int:
    parser = argparse.ArgumentParser(prog="kimscan status", add_help=False)
    parser.add_argument("id")
    parser.add_argument("fp")
    parser.add_argument("status", choices=STATUSES)
    parser.add_argument("-h", "--help", action="store_true")
    try:
        args = parser.parse_args(argv)
    except SystemExit:
        return 1
    if args.help:
        print(
            "Guna: kimscan status <id> <fp> baru|diterima|dibetulkan\n\n"
            "Tukar status satu dapatan. Status disimpan dalam sesi dan "
            "diwarisi oleh imbasan seterusnya bagi kind+sasaran yang sama."
        )
        return 0
    session, err = find_session(args.id)
    if session is None:
        return fail(err or "sesi tidak dijumpai")
    target_fp = None
    for f in session.get("findings", []) or []:
        if f.get("fp") == args.fp:
            target_fp = f
            break
    if target_fp is None:
        return fail(f"fp '{args.fp}' tidak dijumpai dalam sesi {session.get('id')}")
    target_fp["status"] = args.status
    write_json(session_path(session["id"]), session)
    write_report(session, os.path.join(sessions_root(), session["id"], "report.md"))
    ledger = load_ledger()
    ledger[ledger_key(str(session.get("kind")), str(session.get("target")), args.fp)] = {
        "status": args.status,
        "when": now_iso(),
    }
    save_ledger(ledger)
    print(
        f"Status {args.fp} dalam sesi {session['id']} ditukar kepada "
        f"'{args.status}'."
    )
    return 0


def cmd_rules(argv: list) -> int:
    parser = argparse.ArgumentParser(prog="kimscan rules", add_help=False)
    parser.add_argument("--missing", action="store_true")
    parser.add_argument("-h", "--help", action="store_true")
    try:
        args = parser.parse_args(argv)
    except SystemExit:
        return 1
    if args.help:
        print(
            "Guna: kimscan rules [--missing]\n\n"
            "Senaraikan kamus rule BM, atau rule id yang pernah dilihat tetapi "
            "tiada dalam kamus."
        )
        return 0
    rules = load_rules()
    if not args.missing:
        print(f"Kamus rule BM: {len(rules)} entri ({RULES_PATH})")
        for key in sorted(rules):
            tool, _, rule = key.partition("|")
            print(f"  {tool:<10} {rule}")
        return 0

    seen = {}
    for session in all_sessions():
        for f in session.get("findings", []) or []:
            tool = str(f.get("tool") or "")
            rule = str(f.get("rule") or "")
            if not tool or not rule:
                continue
            key = (tool, rule)
            rec = seen.setdefault(key, {"count": 0, "sessions": set()})
            rec["count"] += 1
            rec["sessions"].add(str(session.get("id")))
    missing = sorted(
        (tool, rule, rec) for (tool, rule), rec in seen.items()
        if f"{tool}|{rule}" not in rules
    )
    print(f"Kamus rule BM: {len(rules)} entri")
    print(f"Rule id dilihat dalam sesi: {len(seen)}")
    print(f"Rule id tiada penjelasan: {len(missing)}")
    if not missing:
        print("Tiada rule id hilang — semua rule yang dilihat ada dalam kamus.")
        return 0
    for tool, rule, rec in missing:
        n_sess = len(rec["sessions"])
        print(f"  {tool}/{rule}  ({rec['count']} dapatan, {n_sess} sesi)")
    return 0



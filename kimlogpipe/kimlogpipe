def cmd_report(_args):
    events = load_events()
    fpath = findings_path()
    doc = None
    if fpath.is_file():
        try:
            doc = json.loads(fpath.read_text(encoding="utf-8"))
        except json.JSONDecodeError:
            doc = None

    log("=" * 62)
    log("LAPORAN KIMLOGPIPE v1")
    log("=" * 62)
    log(f"Dijana            : {now_iso()}")
    log(f"Stor              : {data_dir()}")
    log("")

    log("PERISTIWA MENGIKUT SUMBER")
    if not events:
        log("  (tiada peristiwa; jalankan `kimlogpipe ingest ...`)")
    else:
        counts = Counter(e.get("source", "") for e in events)
        for source, n in sorted(counts.items()):
            log(f"  {source or '(tidak diketahui)'}: {n}")
        log(f"  Jumlah: {len(events)}")
    log("")

    log("DAPATAN MENGIKUT PERATURAN")
    if doc is None:
        log("  (belum ada findings.json; jalankan `kimlogpipe detect` dahulu)")
    else:
        if doc.get("since"):
            log(f"  Tetingkap --since: {doc['since']}")
        for r in doc.get("rules", []):
            status = r.get("status")
            if status == "found":
                log(
                    f"  {r['rule']} [{r.get('severity','')}]: "
                    f"{len(r.get('findings', []))} dapatan"
                )
                for f in r.get("findings", []):
                    log(
                        f"    - kunci={f.get('key') or '(tiada)'} "
                        f"kiraan={f.get('count')} {f.get('first_ts')} .. {f.get('last_ts')}"
                    )
                    log(f"      {f.get('summary_bm','')}")
            elif status == "no_match":
                log(f"  {r['rule']} [{r.get('severity','')}]: tiada padanan")
                if r.get("reason"):
                    log(f"      sebab: {r['reason']}")
            elif status == "disabled":
                log(f"  {r['rule']}: dimatikan")
            else:
                log(
                    f"  {r['rule']} [{r.get('severity','')}]: "
                    f"tidak dapat dinilai"
                )
                if r.get("reason"):
                    log(f"      sebab: {r['reason']}")
    log("")

    findings = [] if doc is None else doc.get("findings", [])
    log("KUNCI TERATAS (src_ip/pengguna)")
    key_counts = Counter()
    for f in findings:
        key = f.get("key") or ""
        if key:
            key_counts[key] += int(f.get("count", 0) or 0)
    if key_counts:
        key, n = key_counts.most_common(1)[0]
        log(f"  {key} ({n} peristiwa dalam dapatan)")
    else:
        log("  tiada kunci (tiada dapatan)")
    log("")

    log("NOTA KAVEAT")
    log("  - journald tidak kekal secara lalai (Storage=volatile); log lama hilang")
    log("    selepas reboot jika journal tidak disimpan secara berterusan.")
    log("  - PerSourcePenalties sshd boleh memotong log; percubaan gagal mungkin")
    log("    muncul sebagai 'drop connection' dan bukan 'Invalid user'. Kedua-dua")
    log("    isyarat dikira oleh ssh_bruteforce.")
    log("  - Dalam VM NAT QEMU, semua sumber luar kelihatan sebagai 10.0.2.2;")
    log("    kunci src_ip tidak membezakan hos sebenar di luar NAT.")
    log("  - Peraturan yang tiada data dilaporkan 'tidak dapat dinilai', bukan")
    log("    'tiada serangan'. Tiada dapatan direka.")
    log("=" * 62)



def build_parser():
    p = argparse.ArgumentParser(
        prog="kimlogpipe",
        description="Normalisasi log sistem dan pengesanan berasaskan peraturan (v1).",
    )
    p.add_argument("--version", action="version", version=f"KimLogPipe {VERSION}")
    sub = p.add_subparsers(dest="command", required=True)

    ing = sub.add_parser("ingest", help="serap log ke events.jsonl")
    ing.add_argument("--source", required=True, choices=["journald", "auditd"])
    ing.add_argument("--file", help="fail fixture; tanpa ini mod langsung digunakan")
    ing.set_defaults(func=cmd_ingest)

    rl = sub.add_parser("rules", help="senaraikan peraturan dan ambang")
    rl.set_defaults(func=cmd_rules)

    det = sub.add_parser("detect", help="jalankan semua peraturan")
    det.add_argument("--since", help="tetingkap masa, contoh 5m, 2h, 1d")
    det.set_defaults(func=cmd_detect)

    rep = sub.add_parser("report", help="laporan manusia dalam Bahasa Melayu")
    rep.set_defaults(func=cmd_report)
    return p


def main(argv=None):
    args = build_parser().parse_args(argv)
    args.func(args)
    return 0


if __name__ == "__main__":
    if hasattr(signal, "SIGPIPE"):
        signal.signal(signal.SIGPIPE, signal.SIG_DFL)
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        print("\nDihentikan.", file=sys.stderr)
        sys.exit(130)

def events_path() -> Path:
    return data_dir() / "events.jsonl"


def findings_path() -> Path:
    return data_dir() / "findings.json"


def raw_path() -> Path:
    return data_dir() / "rawlines.jsonl"


def load_events():
    path = events_path()
    if not path.is_file():
        return []
    out = []
    with path.open("r", encoding="utf-8", errors="replace") as fh:
        for line in fh:
            line = line.strip()
            if not line:
                continue
            try:
                obj = json.loads(line)
            except json.JSONDecodeError:
                continue
            if isinstance(obj, dict):
                out.append(obj)
    return out


def load_raw_map() -> dict:
    path = raw_path()
    out = {}
    if not path.is_file():
        return out
    with path.open("r", encoding="utf-8", errors="replace") as fh:
        for line in fh:
            try:
                obj = json.loads(line)
            except json.JSONDecodeError:
                continue
            if isinstance(obj, dict) and "raw_ref" in obj:
                out[obj["raw_ref"]] = obj.get("line", "")
    return out


def atomic_write(path: Path, text: str) -> None:
    tmp = path.with_name(f".{path.name}.tmp.{os.getpid()}")
    with tmp.open("w", encoding="utf-8") as fh:
        fh.write(text)
        fh.flush()
        os.fsync(fh.fileno())
    os.replace(tmp, path)


def store_events(new_events, new_raw) -> tuple[int, int]:
    """Tambah peristiwa baharu, dedupe ikut ts+source+action+raw_ref."""
    existing = load_events()
    seen = {
        (e.get("ts"), e.get("source"), e.get("action"), e.get("raw_ref"))
        for e in existing
    }
    added = 0
    for ev in new_events:
        key = (ev["ts"], ev["source"], ev["action"], ev["raw_ref"])
        if key in seen:
            continue
        seen.add(key)
        existing.append(ev)
        added += 1
    dupes = len(new_events) - added
    lines = "".join(
        json.dumps(e, ensure_ascii=False, separators=(",", ":")) + "\n"
        for e in existing
    )
    atomic_write(events_path(), lines)

    raw_map = load_raw_map()
    changed = False
    for ref, line in new_raw.items():
        if ref not in raw_map:
            raw_map[ref] = line
            changed = True
    if changed:
        raw_text = "".join(
            json.dumps({"raw_ref": k, "line": v}, ensure_ascii=False) + "\n"
            for k, v in raw_map.items()
        )
        atomic_write(raw_path(), raw_text)
    return added, dupes



def ingest_journald_file(path: Path):
    events, raw_map = [], {}
    invalid = 0
    lines_read = 0
    try:
        fh = path.open("r", encoding="utf-8", errors="replace")
    except OSError as exc:
        die(f"tidak dapat membaca {path}: {exc}")
    with fh:
        for lineno, raw in enumerate(fh, 1):
            lines_read += 1
            raw = raw.rstrip("\n")
            if not raw.strip():
                continue
            try:
                rec = json.loads(raw)
            except json.JSONDecodeError:
                invalid += 1
                continue
            raw_ref = f"{path}:{lineno}"
            event, reason = parse_journald_line(rec, raw_ref)
            if event is None:
                invalid += 1
                continue
            events.append(event)
            raw_map[raw_ref] = raw
    return events, raw_map, invalid, lines_read


def ingest_journald_live():
    cmd = ["journalctl", "-o", "json", "--no-pager", "-n", str(JOURNAL_LINES)]
    try:
        proc = subprocess.run(cmd, capture_output=True, text=True, timeout=60)
    except FileNotFoundError:
        die("journalctl tidak dijumpai (bukan sistem systemd?)")
    except subprocess.TimeoutExpired:
        die("journalctl tamat masa selepas 60s")
    if proc.returncode != 0:
        die(f"journalctl gagal: {proc.stderr.strip() or 'kod ' + str(proc.returncode)}")
    events, raw_map = [], {}
    invalid = 0
    lines_read = 0
    for raw in proc.stdout.splitlines():
        lines_read += 1
        try:
            rec = json.loads(raw)
        except json.JSONDecodeError:
            invalid += 1
            continue
        cursor = str(rec.get("__CURSOR", "") or "")
        if not cursor:
            cursor = "journalctl:seq=" + str(rec.get("__SEQNUM", "?"))
        event, reason = parse_journald_line(rec, cursor)
        if event is None:
            invalid += 1
            continue
        events.append(event)
        raw_map[cursor] = raw
    return events, raw_map, invalid, lines_read


def ingest_audit_file(path: Path):
    return parse_audit_file(path)


def cmd_ingest(args):
    if args.file:
        path = Path(args.file).expanduser().resolve()
        if not path.is_file():
            die(f"fail tidak dijumpai: {path}")
        if args.source == "journald":
            events, raw_map, invalid, lines_read = ingest_journald_file(path)
        else:
            events, raw_map, invalid, lines_read = ingest_audit_file(path)
        label = f"fail: {path}"
    else:
        if args.source == "journald":
            events, raw_map, invalid, lines_read = ingest_journald_live()
            label = f"live: journalctl -n {JOURNAL_LINES}"
        else:
            path = Path(AUDIT_LOG)
            if not path.is_file():
                die(f"fail audit langsung tidak dijumpai: {path}")
            events, raw_map, invalid, lines_read = ingest_audit_file(path)
            label = f"live: {path}"

    added, dupes = store_events(events, raw_map)
    total = len(load_events())
    log(f"Sumber            : {args.source} ({label})")
    log(f"Baris dibaca      : {lines_read}")
    log(f"Peristiwa dihurai : {len(events)}")
    log(f"Peristiwa baharu  : {added}")
    log(f"Pendua dilangkau  : {dupes}")
    log(f"Baris tidak sah   : {invalid}")
    log(f"Jumlah dalam stor : {total}")
    log(f"Stor              : {data_dir()}")



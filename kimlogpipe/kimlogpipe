def evidence_for(events, raw_map):
    out = []
    for ev in events:
        ref = ev.get("raw_ref", "")
        line = raw_map.get(ref)
        if line is None and ":" in ref:
            # Fallback: baca semula fail sumber jika sidecar tiada.
            fname, _, lineno = ref.rpartition(":")
            try:
                with open(fname, "r", encoding="utf-8", errors="replace") as fh:
                    for i, raw in enumerate(fh, 1):
                        if i == int(lineno):
                            line = raw.rstrip("\n")
                            break
            except (OSError, ValueError):
                line = None
        if line is None:
            line = ""
        out.append({"raw_ref": ref, "line": line[:2000]})
    return out


def finding(rule, count, first_ts, last_ts, key, evidence, summary):
    return {
        "rule": rule["name"],
        "severity": rule["severity"],
        "count": count,
        "first_ts": first_ts,
        "last_ts": last_ts,
        "key": key,
        "evidence": evidence,
        "summary_bm": summary,
    }


def eval_threshold(rule, events, raw_map):
    signals = set(rule.get("signals") or [])
    try:
        threshold = int(rule["threshold"])
        window = int(rule["window_seconds"])
    except (KeyError, TypeError, ValueError):
        return "not_evaluable", "konfigurasi threshold/window_seconds tidak sah", []
    if not events:
        return "not_evaluable", "tiada peristiwa dalam stor/tetingkap", []
    cands = [e for e in events if e.get("action") in signals]
    if not cands:
        if any(e.get("src_ip") for e in events):
            return (
                "no_match",
                "0 isyarat kegagalan (fixture hanya mengandungi log masuk berjaya)",
                [],
            )
        return "not_evaluable", "medan src_ip tiada dalam set peristiwa", []
    cands_ip = [e for e in cands if e.get("src_ip")]
    if not cands_ip:
        return "not_evaluable", "medan src_ip tiada pada isyarat kegagalan", []

    findings = []
    by_key = {}
    for e in cands_ip:
        by_key.setdefault(e["src_ip"], []).append(e)
    for key, items in by_key.items():
        items.sort(key=lambda e: epoch_of(e["ts"]))
        best = None
        for i in range(len(items)):
            j = i
            while j < len(items) and (
                epoch_of(items[j]["ts"]) - epoch_of(items[i]["ts"])
            ) <= window:
                j += 1
            n = j - i
            if n >= threshold and (best is None or n > best[0]):
                best = (n, i, j)
        if best is None:
            continue
        n, i, j = best
        win = items[i:j]
        summary = (
            f"{n} isyarat kegagalan pengesahan SSH daripada {key} "
            f"dalam tetingkap {window} saat (ambang {threshold})."
        )
        findings.append(
            finding(
                rule,
                n,
                win[0]["ts"],
                win[-1]["ts"],
                key,
                evidence_for(win, raw_map),
                summary,
            )
        )
    if not findings:
        return (
            "no_match",
            f"{len(cands_ip)} isyarat kegagalan, tiada kunci mencapai ambang "
            f"{threshold}/{window}s",
            [],
        )
    return "found", "", findings


def eval_sudo(rule, events, raw_map):
    actions = set(rule.get("actions") or ["sudo_fail", "su_fail"])
    domain_actions = set(rule.get("domain_actions") or ["sudo", "sudo_fail", "su", "su_fail"])
    if not events:
        return "not_evaluable", "tiada peristiwa dalam stor/tetingkap", []
    domain = [e for e in events if e.get("action") in domain_actions]
    if not domain:
        return (
            "not_evaluable",
            "tiada rekod sudo/su dalam set peristiwa (medan action sudo/su tiada)",
            [],
        )
    failed = [e for e in domain if e.get("action") in actions]
    if not failed:
        return (
            "no_match",
            f"{len(domain)} rekod sudo/su, tiada kegagalan pengesahan",
            [],
        )
    findings = []
    by_user = {}
    for e in failed:
        by_user.setdefault(e.get("user", ""), []).append(e)
    for user, items in by_user.items():
        items.sort(key=lambda e: epoch_of(e["ts"]))
        label = user or "(pengguna tidak diketahui)"
        summary = f"{len(items)} pengesahan sudo/su gagal untuk {label}."
        findings.append(
            finding(
                rule,
                len(items),
                items[0]["ts"],
                items[-1]["ts"],
                user,
                evidence_for(items, raw_map),
                summary,
            )
        )
    return "found", "", findings


def eval_exec_watch(rule, events, raw_map):
    if not events:
        return "not_evaluable", "tiada peristiwa dalam stor/tetingkap", []
    execs = [e for e in events if str(e.get("action", "")).startswith("execve:")]
    if not execs:
        return (
            "not_evaluable",
            "tiada rekod execve (medan syscall/exe tiada dalam set peristiwa)",
            [],
        )
    watch = {str(w).lower() for w in (rule.get("watch") or [])}
    matched = []
    for e in execs:
        binary = e["action"].split(":", 1)[1].lower()
        if binary in watch:
            matched.append(e)
    if not matched:
        return (
            "no_match",
            f"{len(execs)} rekod execve, tiada sepadan senarai pantau",
            [],
        )
    findings = []
    grouped = {}
    for e in matched:
        binary = e["action"].split(":", 1)[1]
        grouped.setdefault((e.get("user", ""), binary), []).append(e)
    for (user, binary), items in grouped.items():
        items.sort(key=lambda e: epoch_of(e["ts"]))
        label = user or "(pengguna tidak diketahui)"
        summary = (
            f"Pelaksanaan binari dalam senarai pantau: {binary} oleh {label} "
            f"({len(items)} kali)."
        )
        findings.append(
            finding(
                rule,
                len(items),
                items[0]["ts"],
                items[-1]["ts"],
                user,
                evidence_for(items, raw_map),
                summary,
            )
        )
    return "found", "", findings


def eval_aide(rule, events, raw_map):
    if not events:
        return "not_evaluable", "tiada peristiwa dalam stor/tetingkap", []
    matches = [e for e in events if e.get("action") == "aide_change"]
    if not matches:
        return (
            "not_evaluable",
            "tiada baris laporan AIDE (medan action aide_change tiada)",
            [],
        )
    findings = []
    grouped = {}
    for e in matches:
        grouped.setdefault(e.get("user", ""), []).append(e)
    for user, items in grouped.items():
        items.sort(key=lambda e: epoch_of(e["ts"]))
        label = user or "(pengguna tidak diketahui)"
        summary = f"AIDE melaporkan perubahan fail ({len(items)} baris) untuk {label}."
        findings.append(
            finding(
                rule,
                len(items),
                items[0]["ts"],
                items[-1]["ts"],
                user,
                evidence_for(items, raw_map),
                summary,
            )
        )
    return "found", "", findings


EVALUATORS = {
    "threshold": eval_threshold,
    "any_failed": eval_sudo,
    "exec_watch": eval_exec_watch,
    "any_match": eval_aide,
}


def parse_since(text: str) -> float:
    m = re.fullmatch(r"(\d+)([smhd])", text.strip().lower())
    if not m:
        die("nilai --since tidak sah; guna contoh 30s, 5m, 2h, 1d")
    val, unit = int(m.group(1)), m.group(2)
    mult = {"s": 1, "m": 60, "h": 3600, "d": 86400}[unit]
    return val * mult


def cmd_detect(args):
    rules_doc = load_rules()
    all_events = load_events()
    raw_map = load_raw_map()
    since_desc = None
    events = all_events
    if args.since:
        seconds = parse_since(args.since)
        cutoff = datetime.now(timezone.utc).timestamp() - seconds
        events = [e for e in all_events if epoch_of(e["ts"]) >= cutoff]
        since_desc = args.since

    if not all_events:
        log("Stor peristiwa kosong. Jalankan `kimlogpipe ingest ...` dahulu.")
    log(
        f"Peristiwa dinilai: {len(events)}"
        + (f" (--since {since_desc})" if since_desc else " (semua)")
    )
    log("")

    results = []
    flat = []
    for rule in rules_doc["rules"]:
        if not rule.get("enabled", True):
            results.append(
                {
                    "rule": rule["name"],
                    "severity": rule["severity"],
                    "status": "disabled",
                    "reason": "peraturan dimatikan dalam rules.yaml",
                    "findings": [],
                }
            )
            log(f"{rule['name']}: dimatikan")
            continue
        evaluator = EVALUATORS.get(rule.get("type"))
        if evaluator is None:
            status, reason, found = (
                "not_evaluable",
                f"jenis peraturan tidak dikenali: {rule.get('type')}",
                [],
            )
        else:
            status, reason, found = evaluator(rule, events, raw_map)
        if status == "found":
            log(f"{rule['name']}: {len(found)} dapatan")
            for f in found:
                log(
                    f"  - [{f['severity']}] kunci={f['key'] or '(tiada)'} "
                    f"kiraan={f['count']} {f['first_ts']} .. {f['last_ts']}"
                )
                log(f"    {f['summary_bm']}")
        elif status == "no_match":
            log(f"{rule['name']}: tiada padanan ({reason})")
        elif status == "disabled":
            log(f"{rule['name']}: dimatikan")
        else:
            log(f"{rule['name']}: tidak dapat dinilai ({reason})")
        results.append(
            {
                "rule": rule["name"],
                "severity": rule["severity"],
                "status": status,
                "reason": reason,
                "findings": found,
            }
        )
        flat.extend(found)

    doc = {
        "generated_at": now_iso(),
        "since": since_desc,
        "event_count": len(events),
        "rules": results,
        "findings": flat,
    }
    atomic_write(
        findings_path(),
        json.dumps(doc, ensure_ascii=False, indent=2) + "\n",
    )
    log("")
    log(f"Jumlah dapatan: {len(flat)}")
    log(f"Fail dapatan  : {findings_path()}")



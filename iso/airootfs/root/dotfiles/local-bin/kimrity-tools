#!/bin/sh
# kimrity-tools — list of tools that actually exist (PATH + ~/.local/bin), 1-day cache.
cache="${XDG_CACHE_HOME:-$HOME/.cache}/kimrity/tools.txt"

age=999999
[ -s "$cache" ] && age=$(( $(date +%s) - $(stat -c %Y "$cache") ))

if [ "$age" -gt 86400 ]; then
    mkdir -p "$(dirname "$cache")"
    tmp="$cache.tmp.$$"   # per-process name: two concurrent callers cannot half-write $cache
    {
        printf '%s\n' "$PATH" | tr ':' '\n'
        printf '%s\n' "$HOME/.local/bin"
    } | while IFS= read -r d; do
        [ -n "$d" ] && [ -d "$d" ] || continue
        # -L: many /usr/bin entries are symlinks (sh, python3); -type f alone hides them.
        find -L "$d" -maxdepth 1 -type f -perm -u+x -printf '%f\n' 2>/dev/null
    done | grep -vE '\.(sh|py|conf|txt|desktop|bak|old)$' | sort -u > "$tmp"
    [ -s "$tmp" ] && mv "$tmp" "$cache"
    rm -f "$tmp"
fi

cat "$cache"

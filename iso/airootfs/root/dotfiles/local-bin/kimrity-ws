#!/bin/sh
# kimrity-ws — edit workspace presets. Every command prints the whole file to stdout.
# Row format: preset|label|ws|tool|command
#   list    <preset>
#   set     <preset> <row> <ws>          change the tab of one row
#   settool <preset> <row> <tool>        change the tool (binary)
#   setargs <preset> <row> <command>     change the command / link
#   add     <preset> <ws> <tool> [command]
#   del     <preset> <row>
#   all     <preset> <ws>                every app of the preset into one tab
set -u

conf="${KIMRITY_WORKSPACES:-$HOME/.config/kimrity/workspaces.conf}"
cmd="${1:?command: list|set|settool|setargs|add|del|all}"
preset="${2:?preset: F1|F2|F3}"

[ -r "$conf" ] || { echo "missing file: $conf" >&2; exit 1; }

tmp=$(mktemp) || exit 1
trap 'rm -f "$tmp"' EXIT

check_ws() {
    case "$1" in
        [1-9]) ;;
        *) echo "ws must be 1..9" >&2; exit 2 ;;
    esac
}

# split a row -> p|l|w|tool|command (legacy 4-field rows get normalized)
split_row() {
    p=${1%%|*}
    rest=${1#*|}
    l=${rest%%|*}
    rest=${rest#*|}
    w=${rest%%|*}
    rest=${rest#*|}
    tool=${rest%%|*}
    args=${rest#*|}
    if [ "$args" = "$rest" ]; then
        args=""
        temp=$tool
        tool=${temp%% *}
        [ "$temp" != "$tool" ] && args=${temp#* }
    fi
}

write_row() {
    printf '%s|%s|%s|%s|%s\n' "$1" "$2" "$3" "$4" "$5" >> "$tmp"
}

case "$cmd" in
    list) : ;;

    set|settool|setargs|del)
        row_no="${3:?row}"
        case "$row_no" in ''|*[!0-9]*) echo "row must be a number" >&2; exit 2 ;; esac
        value="${4:-}"
        [ "$cmd" = set ] && check_ws "$value"
        n=0
        while IFS= read -r line || [ -n "$line" ]; do
            case "$line" in
                ''|'#'*) printf '%s\n' "$line" >> "$tmp"; continue ;;
            esac
            split_row "$line"
            if [ "$p" = "$preset" ]; then
                n=$((n + 1))
                if [ "$n" -eq "$row_no" ]; then
                    case "$cmd" in
                        set)     w=$value ;;
                        settool) tool=$value ;;
                        setargs) args=$value ;;
                        del)     continue ;;
                    esac
                fi
            fi
            write_row "$p" "$l" "$w" "$tool" "$args"
        done < "$conf"
        mv "$tmp" "$conf"
        ;;

    add)
        ws="${3:?ws}"
        tool="${4:?tool}"
        args="${5:-}"
        check_ws "$ws"
        label=$(grep "^${preset}|" "$conf" | head -1 | cut -d'|' -f2)
        printf '%s|%s|%s|%s|%s\n' "$preset" "${label:-$preset}" "$ws" "$tool" "$args" >> "$conf"
        ;;

    all)
        ws="${3:?ws}"
        check_ws "$ws"
        while IFS= read -r line || [ -n "$line" ]; do
            case "$line" in
                ''|'#'*) printf '%s\n' "$line" >> "$tmp"; continue ;;
            esac
            split_row "$line"
            [ "$p" = "$preset" ] && w=$ws
            write_row "$p" "$l" "$w" "$tool" "$args"
        done < "$conf"
        mv "$tmp" "$conf"
        ;;

    *)
        echo "unknown command: $cmd" >&2
        exit 1
        ;;
esac

# always return the current state so the UI does not depend on a cache
cat "$conf"

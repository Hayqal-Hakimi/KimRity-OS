#!/usr/bin/env bash
# kimrity-gate — NDJSON wrapper for the KimRity Security Gate CLI.
#
# Usage:
#   kimrity-gate <repo|web|server> <target> [authorized]
#
# Every stdout line is one JSON object (NDJSON) so the Quickshell panel
# can display scanner progress. The final verdict is read from the real
# gate.json — no findings are invented.
set -u

kind="${1:-}"
target="${2:-}"
auth="${3:-}"

json_str() {
    python3 -c 'import json, sys; sys.stdout.write(json.dumps(sys.argv[1]))' "$1"
}

emit_error() {
    printf '{"phase":"error","message":%s}\n' "$(json_str "$1")"
    exit 2
}

if [ -z "$kind" ] || [ -z "$target" ]; then
    emit_error "usage: kimrity-gate <repo|web|server> <target> [authorized]"
fi

case "$kind" in
    repo|web|server) ;;
    *) emit_error "invalid kind: $kind (use repo|web|server)" ;;
esac

if { [ "$kind" = "web" ] || [ "$kind" = "server" ]; } && [ "$auth" != "authorized" ]; then
    emit_error "a $kind scan requires the 'authorized' argument"
fi

# Resolve the CLI. Do not use `command -v kimrity-gate` — that is this script itself.
cli="${KIMRITY_GATE_CLI:-/usr/local/bin/kimrity-gate}"
cli_cmd=()
if [ -x "$cli" ] && [ ! -d "$cli" ]; then
    cli_cmd=("$cli")
elif [ -f "$cli" ] && [ "${cli##*.}" = "py" ]; then
    cli_cmd=(python3 "$cli")
elif [ -f "$HOME/Documents/projects/os-security-ai/gate/gate.py" ]; then
    cli_cmd=(python3 "$HOME/Documents/projects/os-security-ai/gate/gate.py")
else
    emit_error "KimRity Gate CLI not found (set KIMRITY_GATE_CLI)"
fi

ts="$(date -u +%Y%m%dT%H%M%SZ)"
out="$HOME/.local/share/kimrity/gate/$ts"
mkdir -p "$out" || emit_error "cannot create the output folder: $out"

# The CLI (trivy) looks for its config in CWD; an inherited CWD can be /root
# -> "permission denied". Run from $HOME and make sure a repo target is an
# absolute path.
if [ "$kind" = "repo" ]; then
    target="$(readlink -f "$target" 2>/dev/null || printf '%s' "$target")"
fi
cd "$HOME" 2>/dev/null || cd /

json_path="$out/gate.json"
log_path="$out/.gate.log"
err_path="$out/.gate.err"

printf '{"phase":"start","kind":%s,"target":%s,"out":%s}\n' \
    "$(json_str "$kind")" "$(json_str "$target")" "$(json_str "$out")"

cli_args=(--kind "$kind" --out "$out")
if [ "$auth" = "authorized" ]; then
    cli_args+=(--authorized)
fi

# A `[gate] <name> ...` line from the CLI means a scanner started. The
# previous scanner is considered finished; a real failed status is corrected
# after gate.json is read.
prev=""
"${cli_cmd[@]}" "${cli_args[@]}" "$target" 2>"$err_path" | while IFS= read -r line; do
    printf '%s\n' "$line" >>"$log_path"

    name=""
    case "$line" in
        "[gate] "*" ...")
            name="${line#\[gate\] }"
            name="${name% ...}"
            ;;
    esac

    if [ -n "$name" ]; then
        if [ -n "$prev" ]; then
            printf '{"phase":"scanner","name":%s,"status":"done"}\n' "$(json_str "$prev")"
        fi
        printf '{"phase":"scanner","name":%s,"status":"running"}\n' "$(json_str "$name")"
        prev="$name"
    fi
done
cli_rc=${PIPESTATUS[0]}

if [ ! -f "$json_path" ]; then
    python3 - "$err_path" "$cli_rc" <<'PY'
import json, sys

try:
    with open(sys.argv[1], encoding="utf-8", errors="replace") as fh:
        lines = [ln.strip() for ln in fh if ln.strip()]
except OSError:
    lines = []

reason = lines[-1] if lines else "CLI failed with no output (rc=%s)" % sys.argv[2]
print(json.dumps({"phase": "error", "message": reason[:300]}))
PY
    exit 2
fi

# Scanner statuses + final verdict: everything comes from the real gate.json.
python3 - "$json_path" "$out" <<'PY'
import json
import sys

path, out = sys.argv[1], sys.argv[2]
try:
    with open(path, encoding="utf-8") as fh:
        result = json.load(fh)
except Exception as exc:  # noqa: BLE001 - report it, do not guess
    print(json.dumps({"phase": "error", "message": "invalid gate.json: %s" % exc}))
    raise SystemExit(2)

errors = result.get("tool_errors") or {}
tools = (result.get("meta") or {}).get("tools") or {}
names = list(tools) + [name for name in errors if name not in tools]
for name in names:
    status = "failed" if name in errors else "done"
    row = {"phase": "scanner", "name": name, "status": status}
    if status == "failed":
        reason = str(errors.get(name, "")).splitlines()
        row["reason"] = (reason[0] if reason else "failed")[:300]
    print(json.dumps(row), flush=True)

counts = result.get("counts") or {}
print(json.dumps({
    "phase": "done",
    "verdict": result.get("verdict", ""),
    "counts": {k: int(counts.get(k, 0) or 0) for k in ("high", "medium", "low")},
    "out": out,
    "json": path,
}), flush=True)
PY
parse_rc=$?

if [ "$parse_rc" -ne 0 ]; then
    exit 2
fi

exit 0

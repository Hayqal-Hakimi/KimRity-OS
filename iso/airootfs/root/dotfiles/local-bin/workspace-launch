#!/bin/sh
# workspace-launch — lancar semua app satu preset, masing-masing ke workspace sendiri.
# Format: preset|label|ws|nama|perintah   (limit 4 medan lama masih diterima)
# Guna: workspace-launch F1 [--dry-run]
set -u

preset="${1:?guna: workspace-launch F1|F2|F3 [--dry-run]}"
dry=0
[ "${2:-}" = "--dry-run" ] && dry=1

conf="${KIMRITY_WORKSPACES:-$HOME/.config/kimrity/workspaces.conf}"

# Hyprland mengeksport ini untuk keybind; sesi SSH tidak. Cari sendiri jika tiada.
if [ -z "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]; then
    sig=$(ls -1 "${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/hypr" 2>/dev/null | head -1)
    [ -n "$sig" ] && export HYPRLAND_INSTANCE_SIGNATURE="$sig"
fi
[ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ] || { echo "Hyprland tidak dikesan" >&2; exit 1; }
[ -r "$conf" ] || { echo "tiada fail: $conf" >&2; exit 1; }

lines=$(grep "^${preset}|" "$conf" 2>/dev/null) || true
[ -n "$lines" ] || { echo "preset ${preset} tiada dalam $conf" >&2; exit 1; }

printf '%s\n' "$lines" | while IFS='|' read -r p label ws tool args; do
    # baris lama: medan ke-4 = perintah penuh (cth "kitty -e btop")
    if [ -z "${args:-}" ] && [ -n "${tool:-}" ]; then
        case "$tool" in
            *" "*) args=${tool#* }; tool=${tool%% *} ;;
        esac
    fi
    # baris lama: link sahaja → buka dengan pelayar
    case "$tool" in
        http://*|https://*) args=$tool; tool=firefox ;;
    esac
    [ -n "$tool" ] || continue
    if ! command -v "$tool" >/dev/null 2>&1; then
        echo "tool tiada dalam sistem: $tool" >&2
        continue
    fi
    cmd="$tool${args:+ $args}"
    if [ "$dry" = 1 ]; then
        printf '%s %-10s [tab %s] %s\n' "$p" "$tool" "$ws" "$cmd"
    else
        hyprctl dispatch exec "[workspace $ws] $cmd" >/dev/null 2>&1 || \
            echo "gagal lancar: $cmd" >&2
        sleep 0.2
    fi
done

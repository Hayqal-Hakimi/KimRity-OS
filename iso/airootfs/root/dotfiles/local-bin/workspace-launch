#!/bin/sh
# workspace-launch — launch every app of one preset, each into its own workspace.
# Format: preset|label|ws|name|command   (legacy 4-field rows still accepted)
# Usage: workspace-launch F1 [--dry-run]
set -u

preset="${1:?usage: workspace-launch F1|F2|F3 [--dry-run]}"
dry=0
[ "${2:-}" = "--dry-run" ] && dry=1

conf="${KIMRITY_WORKSPACES:-$HOME/.config/kimrity/workspaces.conf}"

# Hyprland exports this for keybinds; SSH sessions do not. Look it up when missing.
if [ -z "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]; then
    sig=$(ls -1 "${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/hypr" 2>/dev/null | head -1)
    [ -n "$sig" ] && export HYPRLAND_INSTANCE_SIGNATURE="$sig"
fi
[ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ] || { echo "Hyprland not detected" >&2; exit 1; }
[ -r "$conf" ] || { echo "missing file: $conf" >&2; exit 1; }

lines=$(grep "^${preset}|" "$conf" 2>/dev/null) || true
[ -n "$lines" ] || { echo "preset ${preset} missing in $conf" >&2; exit 1; }

printf '%s\n' "$lines" | while IFS='|' read -r p label ws tool args; do
    # legacy row: field 4 = full command (e.g. "kitty -e btop")
    if [ -z "${args:-}" ] && [ -n "${tool:-}" ]; then
        case "$tool" in
            *" "*) args=${tool#* }; tool=${tool%% *} ;;
        esac
    fi
    # legacy row: bare link -> open with the browser
    case "$tool" in
        http://*|https://*) args=$tool; tool=firefox ;;
    esac
    [ -n "$tool" ] || continue
    if ! command -v "$tool" >/dev/null 2>&1; then
        echo "tool not installed: $tool" >&2
        continue
    fi
    cmd="$tool${args:+ $args}"
    if [ "$dry" = 1 ]; then
        printf '%s %-10s [tab %s] %s\n' "$p" "$tool" "$ws" "$cmd"
    else
        hyprctl dispatch exec "[workspace $ws] env DISPLAY=${DISPLAY:-:0} _JAVA_AWT_WM_NONREPARENTING=1 $cmd" >/dev/null 2>&1 || \
            echo "launch failed: $cmd" >&2
        sleep 0.2
    fi
done

def latest_session():
    sessions = all_sessions()
    if not sessions:
        return None
    sessions.sort(key=lambda s: (str(s.get("started") or ""), str(s.get("id") or "")))
    return sessions[-1]


def cmd_posture(argv: list) -> int:
    parser = argparse.ArgumentParser(prog="kimscan posture", add_help=False)
    parser.add_argument("--accept", "--baseline", dest="accept", action="store_true")
    parser.add_argument("--show-baseline", action="store_true")
    parser.add_argument("--strict", action="store_true")
    parser.add_argument("--json", action="store_true")
    parser.add_argument("--fail-on", choices=["critical", "high", "medium"], default="high")
    parser.add_argument("-h", "--help", action="store_true")
    try:
        args = parser.parse_args(argv)
    except SystemExit:
        return 1

    if args.help:
        print(
            "Usage: kimscan posture [--accept] [--show-baseline] [--strict] "
            "[--json] [--fail-on critical|high|medium]\n"
            "\n"
            "Inspect this host without root: auditd, audit watches, the KimAI\n"
            "pipeline, wildcard listeners, sshd, accounts, sudoers, PATH,\n"
            "sysctl and temporary directories.\n"
            "\n"
            "  --accept          save the current state as the baseline\n"
            "  --show-baseline   print the saved baseline without scanning\n"
            "  --strict          incomplete coverage (a skipped check) makes\n"
            "                    the verdict CONDITIONAL instead of PASS\n"
            "\n"
            "Checks that need root (shadow hashes, sudoers) are reported as\n"
            "not evaluated — never as clean.\n"
            "\n"
            "Baseline: $XDG_DATA_HOME/kimscanning/posture/baseline.json"
        )
        return 0

    if args.show_baseline:
        base = load_baseline()
        if not base:
            print("No baseline yet. Save one with: kimscan posture --accept")
            return 0
        items = base.get("items") or {}
        print(f"Baseline: {baseline_file()}")
        print(f"Saved   : {base.get('saved')} by {base.get('user')} on {base.get('host')}")
        print(f"Items   : {len(items)}")
        for key in sorted(items):
            print(f"  [{items[key].get('severity')}] {key}")
        return 0

    sid = new_session_id()
    started = now_iso()
    records, items = [], []
    for check in POSTURE_CHECKS:
        found, record = check()
        items.extend(found)
        records.append(record)
    finished = now_iso()

    counts = {"critical": 0, "high": 0, "medium": 0, "low": 0, "info": 0}
    for item in items:
        severity = str(item.get("severity", "info")).lower()
        counts[severity] = counts.get(severity, 0) + 1

    skipped = [r for r in records if r.get("status") == "skipped"]
    user = getpass.getuser() if hasattr(getpass, "getuser") else os.environ.get("USER", "?")
    uname = os.uname()

    current = posture_map(items)
    base = load_baseline()
    saved_items = base.get("items") if isinstance(base.get("items"), dict) else {}
    drift = posture_diff(current, saved_items) if saved_items else []
    baseline_info = {
        "present": bool(saved_items),
        "saved": base.get("saved", ""),
        "user": base.get("user", ""),
        "items": len(saved_items),
        "new": sum(1 for d in drift if d["kind"] == "new"),
        "changed": sum(1 for d in drift if d["kind"] == "changed"),
        "gone": sum(1 for d in drift if d["kind"] == "gone"),
    }

    verdict = posture_verdict(items, records, args.fail_on, args.strict)
    session = {
        "id": sid,
        "kind": "posture",
        "target": uname.nodename,
        "profile": "posture-local",
        "authorized": {"granted": False, "who": user, "when": started, "scope": None},
        "started": started,
        "finished": finished,
        "verdict": verdict,
        "scanners": records,
        "counts": counts,
        "findings": items,
        "host": {
            "hostname": uname.nodename,
            "kernel": uname.release,
            "user": user,
            "user_is_root": os.geteuid() == 0,
        },
        "coverage": {
            "checks": len(records),
            "evaluated": len(records) - len(skipped),
            "skipped": len(skipped),
            "skipped_checks": skipped,
        },
        "baseline": baseline_info,
        "drift": drift,
    }

    sdir = os.path.join(sessions_root(), sid)
    try:
        os.makedirs(sdir, exist_ok=True)
        write_json(os.path.join(sdir, "session.json"), session)
        write_report(session, os.path.join(sdir, "report.md"))
    except OSError as exc:
        return fail(f"cannot store the session: {exc}")

    had_previous = bool(saved_items)
    if args.accept:
        try:
            os.makedirs(os.path.dirname(baseline_file()), exist_ok=True)
            write_json(baseline_file(), {
                "saved": finished,
                "user": user,
                "host": uname.nodename,
                "kernel": uname.release,
                "items": current,
            })
        except OSError as exc:
            return fail(f"cannot write the baseline: {exc}")
        baseline_info.update({"present": True, "saved": finished,
                              "user": user, "items": len(current)})
        session["baseline"] = baseline_info

    if args.json:
        print(json.dumps(session, ensure_ascii=False, indent=2))
    else:
        print_posture(session)
        if args.accept:
            print("\nBASELINE SAVED")
            if had_previous:
                print(f"  {len(current)} item(s): {baseline_info['new']} new, "
                      f"{baseline_info['changed']} changed, "
                      f"{baseline_info['gone']} gone since the previous baseline")
            else:
                print(f"  {len(current)} item(s) — first baseline "
                      "(nothing to compare against yet)")
            for d in drift:
                mark = {"new": "+", "gone": "-", "changed": "~"}.get(d.get("kind"), "?")
                print(f"    {mark} {d.get('key')}  [{d.get('severity') or '-'}]")
            print("  Accepted state is now the reference for the next run.")
    return VERDICT_EXIT.get(verdict, 3)


def cmd_report(argv: list) -> int:
    parser = argparse.ArgumentParser(prog="kimscan report", add_help=False)
    parser.add_argument("id", nargs="?")
    parser.add_argument("--out", default=None)
    parser.add_argument("-h", "--help", action="store_true")
    try:
        args = parser.parse_args(argv)
    except SystemExit:
        return 1
    if args.help:
        print(
            "Usage: kimscan report [<id>] [--out PATH]\n"
            "\n"
            "Print the markdown report for one session, or the newest session\n"
            "when no id is given. --out writes it to a file instead of stdout.\n"
            "Every session already has report.md next to its session.json."
        )
        return 0
    if args.id:
        session, err = find_session(args.id)
        if session is None:
            return fail(err or "session not found")
    else:
        session = latest_session()
        if session is None:
            return fail("no sessions yet — run: kimscan posture  (or kimscan repo <folder>)")
    text = report_text(session)
    if args.out:
        path = os.path.abspath(args.out)
        if os.path.isdir(path):
            path = os.path.join(path, f"{session['id']}.md")
        try:
            os.makedirs(os.path.dirname(path) or ".", exist_ok=True)
            with open(path, "w", encoding="utf-8") as fh:
                fh.write(text)
        except OSError as exc:
            return fail(f"cannot write the report: {exc}")
        print(f"Report written: {path}")
    else:
        print(text, end="")
    return 0



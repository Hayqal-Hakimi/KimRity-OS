def baseline_file() -> str:
    return os.path.join(data_root(), "posture", "baseline.json")


def load_baseline() -> dict:
    data = read_json(baseline_file())
    return data if isinstance(data, dict) else {}


def posture_map(items) -> dict:
    return {
        str(i.get("key")): {
            "severity": str(i.get("severity")),
            "what": str(i.get("what", "")),
        }
        for i in items
    }


def posture_diff(current: dict, saved: dict) -> list:
    drift = []
    for key in sorted(set(current) - set(saved)):
        drift.append({"kind": "new", "key": key,
                      "severity": current[key]["severity"],
                      "detail": current[key]["what"]})
    for key in sorted(set(saved) - set(current)):
        drift.append({"kind": "gone", "key": key,
                      "severity": saved[key].get("severity", ""),
                      "detail": saved[key].get("what", "")})
    for key in sorted(set(current) & set(saved)):
        if current[key]["severity"] != saved[key].get("severity"):
            drift.append({
                "kind": "changed", "key": key,
                "severity": current[key]["severity"],
                "detail": f"{saved[key].get('severity')} -> {current[key]['severity']}",
            })
    return drift


def posture_verdict(items, records, fail_on: str, strict: bool) -> str:
    threshold = SEV_RANK_ANY[fail_on]
    severities = [str(i.get("severity", "info")).lower() for i in items]
    if any(SEV_RANK_ANY.get(s, 4) <= threshold for s in severities):
        return "FAIL"
    if "medium" in severities:
        return "CONDITIONAL"
    if strict and any(r.get("status") == "skipped" for r in records):
        return "CONDITIONAL"
    return "PASS"



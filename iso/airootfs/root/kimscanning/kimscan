def print_session(session: dict) -> None:
    verdict = session.get("verdict", "?")
    counts = session.get("counts", {})
    print("=" * 68)
    print(f" KIMSCANNING {VERSION}   |   {verdict}")
    print("=" * 68)
    print(f"Session   : {session.get('id')}")
    print(f"Kind      : {session.get('kind')}  ({session.get('profile')})")
    print(f"Target    : {session.get('target')}")
    if session.get("kind") in ("file", "installer"):
        print(f"SHA-256   : {session.get('sha256') or '-'}")
        print(f"Size      : {session.get('size_bytes', '-')} bytes")
        print(f"File type : {session.get('file_type') or '-'}")
    print(f"Time      : {session.get('started')} -> {session.get('finished')}")
    auth = session.get("authorized", {})
    if session.get("kind") in ("web", "server"):
        status = "yes" if auth.get("granted") else "no"
        print(f"Authorized: {status} (scope: {auth.get('scope') or '-'})")
    print(
        "Counts    : "
        f"critical={counts.get('critical', 0)} "
        f"high={counts.get('high', 0)} "
        f"medium={counts.get('medium', 0)} "
        f"low={counts.get('low', 0)}"
    )

    print("\nTOOLS:")
    for scanner in session.get("scanners", []):
        rc = scanner.get("rc")
        rc_text = "-" if rc is None else str(rc)
        print(
            f"  {scanner.get('name', '?'):<10} "
            f"{scanner.get('status', '?'):<8} rc={rc_text:<3} "
            f"{scanner.get('reason', '')}"
        )

    findings = session.get("findings", [])
    print(f"\nFINDINGS ({len(findings)}):")
    if not findings:
        print("  No findings reported.")
        return

    current_file = None
    for n, f in enumerate(display_order(session), 1):
        file = str(f.get("file") or "?")
        if file != current_file:
            print(f"\n  {file}")
            current_file = file
        sev = str(f.get("severity", "unknown")).upper()
        line = f.get("line") or 0
        print(
            f"    [{n}] [{sev}] {f.get('tool')}/{f.get('rule')} "
            f"(line {line}) — status: {f.get('status')}"
        )
        exp = f.get("explanation")
        if isinstance(exp, dict):
            print(f"      WHAT    : {exp.get('what', '')}")
            print(f"      WHY     : {exp.get('why', '')}")
            print(f"      FIX     : {exp.get('fix', '')}")
        else:
            print("      WHAT    : [no explanation]")
            print("      WHY     : [no explanation]")
            print("      FIX     : [no explanation]")
        print(f"      EVIDENCE: {f.get('evidence', '')}")
    print("\n  Mark an action: kimscan status %s <number> accepted" % session.get("id"))


def print_posture(session: dict) -> None:
    """Terminal view of a posture run: what was checked, found, and changed."""
    counts = session.get("counts", {})
    host = session.get("host") or {}
    coverage = session.get("coverage") or {}
    baseline = session.get("baseline") or {}
    print("=" * 68)
    print(f" KIMSCANNING {VERSION}   |   {session.get('verdict')}")
    print("=" * 68)
    print(f"Session   : {session.get('id')}")
    print(f"Kind      : posture  ({session.get('profile')})")
    print(
        f"Host      : {host.get('hostname')}  (kernel {host.get('kernel')}, "
        f"user {host.get('user')}{' — root' if host.get('user_is_root') else ''})"
    )
    print(f"Time      : {session.get('started')} -> {session.get('finished')}")
    print(
        f"Coverage  : {coverage.get('evaluated', 0)} of "
        f"{coverage.get('checks', 0)} checks evaluated"
    )
    for rec in coverage.get("skipped_checks") or []:
        print(f"            - {rec.get('name')}: {rec.get('reason')}")
    print(
        "Checks    : "
        + "  ".join(
            f"{r.get('name')}={r.get('status')}" for r in session.get("scanners", [])
        )
    )
    print(
        "Counts    : "
        f"critical={counts.get('critical', 0)} "
        f"high={counts.get('high', 0)} "
        f"medium={counts.get('medium', 0)} "
        f"low={counts.get('low', 0)} "
        f"info={counts.get('info', 0)}"
    )

    findings = session.get("findings", [])
    print(f"\nFINDINGS ({len(findings)}):")
    if not findings:
        print("  Nothing above the noise floor in the checks that ran.")
    order = {"critical": 0, "high": 1, "medium": 2, "low": 3, "info": 4}
    for n, f in enumerate(
        sorted(findings, key=lambda x: (order.get(str(x.get("severity")), 9), str(x.get("key")))),
        1,
    ):
        print(f"  [{n}] [{str(f.get('severity')).upper()}] {f.get('rule')}/{f.get('key')}")
        print(f"      WHAT    : {f.get('what', '')}")
        print(f"      WHY     : {f.get('why', '')}")
        print(f"      FIX     : {f.get('fix', '')}")
        if f.get("detail"):
            print(f"      WHERE   : {f.get('detail')}")

    print("\nBASELINE:")
    if not baseline.get("present"):
        print("  none yet — save the current state with: kimscan posture --accept")
    else:
        print(
            f"  saved {baseline.get('saved')} by {baseline.get('user')} "
            f"({baseline.get('items', 0)} item(s))"
        )
        drift = session.get("drift") or []
        if not drift:
            print("  no drift: this run matches the saved baseline")
        else:
            print(
                f"  drift: {baseline.get('new', 0)} new, "
                f"{baseline.get('changed', 0)} changed, "
                f"{baseline.get('gone', 0)} gone"
            )
            for d in drift:
                mark = {"new": "+", "gone": "-", "changed": "~"}.get(d.get("kind"), "?")
                print(f"    {mark} {d.get('key')}  [{d.get('severity') or '-'}] {d.get('detail', '')}")
    print("\n  Markdown: kimscan report %s" % session.get("id"))


def report_text(session: dict) -> str:
    """Markdown report for one session (artifact scan or posture run)."""
    counts = session.get("counts", {})
    lines = [
        "# KimScanning Report",
        "",
        f"**Session:** `{session.get('id')}`  ",
        f"**Kind:** {session.get('kind')} ({session.get('profile')})  ",
        f"**Target:** `{session.get('target')}`  ",
        f"**Time:** {session.get('started')} -> {session.get('finished')}  ",
        f"**Verdict:** **{session.get('verdict')}**",
        "",
    ]
    if session.get("kind") in ("file", "installer"):
        lines += [
            f"**SHA-256:** `{session.get('sha256') or '-'}`  ",
            f"**Size:** {session.get('size_bytes', '-')} bytes  ",
            f"**File type:** {session.get('file_type') or '-'}  ",
            "",
        ]
    auth = session.get("authorized", {})
    if session.get("kind") in ("web", "server"):
        lines += [
            f"**Authorized:** {'yes' if auth.get('granted') else 'no'}  ",
            f"**Scope:** `{auth.get('scope') or '-'}`  ",
            "",
        ]

    lines += [
        "## Issue counts",
        "",
        "| Level | Count |",
        "|---|---:|",
        f"| critical | {counts.get('critical', 0)} |",
        f"| high | {counts.get('high', 0)} |",
        f"| medium | {counts.get('medium', 0)} |",
        f"| low | {counts.get('low', 0)} |",
        "",
        "## Tools",
        "",
        "| Tool | Status | RC | Reason |",
        "|---|---|---:|---|",
    ]
    for scanner in session.get("scanners", []):
        reason = str(scanner.get("reason", "")).replace("|", "/")
        rc = scanner.get("rc")
        lines.append(
            f"| {scanner.get('name')} | {scanner.get('status')} | "
            f"{'-' if rc is None else rc} | {reason} |"
        )

    if session.get("kind") == "posture":
        host = session.get("host") or {}
        lines += [
            "",
            "## Host",
            "",
            f"**Hostname:** `{host.get('hostname') or '-'}`  ",
            f"**Kernel:** `{host.get('kernel') or '-'}`  ",
            f"**User:** `{host.get('user') or '-'}`"
            f"{' (root)' if host.get('user_is_root') else ''}  ",
        ]
        coverage = session.get("coverage") or {}
        lines += [
            "",
            "## Coverage",
            "",
            f"{coverage.get('evaluated', 0)} of {coverage.get('checks', 0)} checks "
            f"evaluated, {coverage.get('skipped', 0)} not evaluated.",
            "",
        ]
        for rec in coverage.get("skipped_checks") or []:
            lines.append(f"- `{rec.get('name')}` — {rec.get('reason')}")
        baseline = session.get("baseline") or {}
        lines += ["", "## Drift since baseline", ""]
        if not baseline.get("present"):
            lines.append("_No baseline yet. Run `kimscan posture --accept`._")
        elif not session.get("drift"):
            lines.append("_No drift: the host matches the saved baseline._")
        else:
            lines += [
                f"Baseline saved `{baseline.get('saved')}` by "
                f"`{baseline.get('user')}` — {baseline.get('new', 0)} new, "
                f"{baseline.get('changed', 0)} changed, "
                f"{baseline.get('gone', 0)} gone.",
                "",
                "| Change | Key | Severity | Detail |",
                "|---|---|---|---|",
            ]
            for d in session.get("drift", []):
                detail = str(d.get("detail", "")).replace("|", "/")
                lines.append(
                    f"| {d.get('kind')} | `{d.get('key')}` | "
                    f"{d.get('severity') or '-'} | {detail} |"
                )

    findings = session.get("findings", [])
    lines += ["", f"## Findings ({len(findings)})", ""]
    if not findings:
        lines.append("_No findings reported._")
    else:
        grouped = {}
        for f in findings:
            grouped.setdefault(str(f.get("file") or "?"), []).append(f)
        for file in sorted(grouped):
            lines += [f"### `{file}`", ""]
            rows = sorted(
                grouped[file],
                key=lambda x: (
                    SEV_RANK.get(str(x.get("severity", "unknown")).lower(), 99),
                    str(x.get("tool", "")),
                    int(x.get("line") or 0),
                    str(x.get("rule", "")),
                ),
            )
            for f in rows:
                sev = str(f.get("severity", "unknown")).upper()
                lines += [
                    f"#### [{sev}] `{f.get('tool')}/{f.get('rule')}` — "
                    f"line {f.get('line') or 0}",
                    "",
                    f"- **Status:** {f.get('status')}",
                    f"- **First seen:** {f.get('first_seen')}",
                    f"- **Last seen:** {f.get('last_seen')}",
                ]
                exp = f.get("explanation")
                if isinstance(exp, dict):
                    lines += [
                        f"- **WHAT:** {exp.get('what', '')}",
                        f"- **WHY:** {exp.get('why', '')}",
                        f"- **FIX:** {exp.get('fix', '')}",
                    ]
                else:
                    lines += [
                        "- **WHAT:** [no explanation]",
                        "- **WHY:** [no explanation]",
                        "- **FIX:** [no explanation]",
                    ]
                lines += [f"- **Evidence:** {f.get('evidence', '')}", ""]
    return "\n".join(lines).rstrip() + "\n"


def write_report(session: dict, path: str) -> None:
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path, "w", encoding="utf-8") as fh:
        fh.write(report_text(session))



def json_emit(obj: dict) -> None:
    print(json.dumps(obj, ensure_ascii=False, separators=(",", ":")), flush=True)


def fail(message: str) -> int:
    print(f"ERROR: {message}", file=sys.stderr)
    return 1


INSTALLER_SUFFIXES = (".sh", ".deb", ".rpm", ".AppImage", ".run", ".bin", ".exe")


def is_installer_path(path: str) -> bool:
    """Supported extensions, or a bare Arch build artifact without an extension."""
    if os.path.basename(path) == "PKGBUILD" or path.endswith(INSTALLER_SUFFIXES):
        return True
    file_exe = shutil.which("file")
    if not file_exe:
        return False
    try:
        result = subprocess.run([file_exe, "-b", path], capture_output=True,
                                text=True, timeout=30)
        return result.returncode == 0 and "ELF" in result.stdout
    except (OSError, subprocess.TimeoutExpired):
        return False


def run_file_checks(path: str, run_malware_checks: bool):
    """Run local checks that gate.py does not provide.

    Return metadata, scanner records, and extra findings. YARA needs a
    rules file; it only runs when KIMSCAN_YARA_RULES points to one.
    """
    metadata = {"sha256": None, "size_bytes": os.path.getsize(path), "file_type": None}
    scanners, findings = [], []

    def missing(name: str):
        scanners.append({"name": name, "status": "skipped", "rc": None,
                         "reason": "available: no"})

    file_exe = shutil.which("file")
    if not file_exe:
        missing("file")
    else:
        try:
            p = subprocess.run([file_exe, "-b", path], capture_output=True,
                               text=True, timeout=30)
            if p.returncode == 0:
                metadata["file_type"] = p.stdout.strip()
                scanners.append({"name": "file", "status": "done", "rc": 0,
                                 "reason": metadata["file_type"] or "done"})
            else:
                scanners.append({"name": "file", "status": "failed", "rc": p.returncode,
                                 "reason": (p.stderr or p.stdout or "file failed").strip()[:300]})
        except (OSError, subprocess.TimeoutExpired) as exc:
            scanners.append({"name": "file", "status": "failed", "rc": None,
                             "reason": str(exc)[:300]})

    sha_exe = shutil.which("sha256sum")
    if not sha_exe:
        missing("sha256sum")
    else:
        try:
            p = subprocess.run([sha_exe, path], capture_output=True, text=True, timeout=30)
            digest = p.stdout.split()[0] if p.returncode == 0 and p.stdout.split() else None
            if digest and len(digest) == 64:
                metadata["sha256"] = digest
                scanners.append({"name": "sha256sum", "status": "done", "rc": 0,
                                 "reason": "done"})
            else:
                scanners.append({"name": "sha256sum", "status": "failed", "rc": p.returncode,
                                 "reason": (p.stderr or p.stdout or "sha256sum failed").strip()[:300]})
        except (OSError, subprocess.TimeoutExpired) as exc:
            scanners.append({"name": "sha256sum", "status": "failed", "rc": None,
                             "reason": str(exc)[:300]})

    for name in ("clamscan", "yara"):
        exe = shutil.which(name)
        if not exe:
            missing(name)
            continue
        if not run_malware_checks:
            scanners.append({"name": name, "status": "skipped", "rc": None,
                             "reason": "only for binaries or installers"})
            continue
        if name == "yara":
            rules = os.environ.get("KIMSCAN_YARA_RULES")
            if not rules or not os.path.isfile(rules):
                scanners.append({"name": "yara", "status": "skipped", "rc": None,
                                 "reason": "no rules file (set KIMSCAN_YARA_RULES)"})
                continue
            command = [exe, rules, path]
        else:
            command = [exe, "--no-summary", path]
        try:
            p = subprocess.run(command, capture_output=True, text=True, timeout=300)
        except (OSError, subprocess.TimeoutExpired) as exc:
            scanners.append({"name": name, "status": "failed", "rc": None,
                             "reason": str(exc)[:300]})
            continue
        output = (p.stdout or p.stderr or "").strip()
        if p.returncode == 0:
            scanners.append({"name": name, "status": "done", "rc": 0, "reason": "done"})
        elif p.returncode == 1:
            scanners.append({"name": name, "status": "done", "rc": 1,
                             "reason": "match found"})
            findings.append({
                "tool": name, "rule": "malware-match", "severity": "high",
                "file": path, "line": 0,
                "message": output[:500] or "malware match detected",
            })
        else:
            scanners.append({"name": name, "status": "failed", "rc": p.returncode,
                             "reason": output[:300] or f"{name} failed"})
    return metadata, scanners, findings


def run_scan(kind: str, argv: list) -> int:
    parser = argparse.ArgumentParser(prog=f"kimscan {kind}", add_help=False)
    parser.add_argument("target")
    parser.add_argument("--authorized", action="store_true")
    parser.add_argument("--scope", default=None)
    parser.add_argument("--json", action="store_true")
    parser.add_argument("--fail-on", choices=["critical", "high", "medium"], default="high")
    parser.add_argument("-h", "--help", action="store_true")
    try:
        args = parser.parse_args(argv)
    except SystemExit:
        return 1

    if args.help:
        print_scan_help(kind)
        return 0

    if kind in ("web", "server") and not args.authorized:
        return fail(
            f"the {kind} scan is an active scan and requires --authorized. "
            "Confirm first that you have written authorization to "
            "scan this target."
        )

    target = args.target
    if kind == "repo":
        target = os.path.abspath(target)
        if not os.path.isdir(target):
            return fail(f"not a directory: {target}")
    elif kind in ("file", "installer"):
        target = os.path.abspath(target)
        if not os.path.isfile(target):
            return fail(f"not a file: {target}")
        if kind == "installer" and not is_installer_path(target):
            return fail("installer must be .sh, .deb, .rpm, .AppImage, .run, .bin, .exe, or PKGBUILD")
    elif kind == "web":
        if not target.startswith(("http://", "https://")):
            return fail("web target must start with http:// or https://")
    else:
        if not target.strip():
            return fail("server target must not be empty")

    if args.scope and not os.path.isfile(args.scope):
        return fail(f"cannot read scope file: {args.scope}")
    if not os.path.isfile(GATE):
        return fail(f"gate.py not found: {GATE}")

    gate_kind = "repo" if kind in ("file", "installer") else kind
    gate_target = target
    staging_dir = None
    if kind in ("file", "installer"):
        # gate.py only accepts a folder for --kind repo (single-file scans
        # are rejected); copy the single file to a temp dir and drop it after.
        try:
            staging_dir = tempfile.mkdtemp(prefix="kimscan-file-")
            staged_file = os.path.join(staging_dir, os.path.basename(target))
            shutil.copy2(target, staged_file)
            gate_target = staging_dir
        except OSError as exc:
            if staging_dir:
                shutil.rmtree(staging_dir, ignore_errors=True)
            return fail(f"cannot prepare the file for the gate: {exc}")

    sid = new_session_id()
    sdir = os.path.join(sessions_root(), sid)
    raw_dir = os.path.join(sdir, "raw")
    gate_out = os.path.join(sdir, ".gate")
    try:
        os.makedirs(raw_dir, exist_ok=True)
    except OSError as exc:
        return fail(f"cannot create the session: {exc}")

    started = now_iso()
    auth = {
        "granted": bool(args.authorized),
        "who": getpass.getuser() if hasattr(getpass, "getuser") else os.environ.get("USER", "?"),
        "when": started,
        "scope": args.scope,
    }

    if args.json:
        json_emit(
            {
                "phase": "start",
                "id": sid,
                "kind": kind,
                "target": target,
                "started": started,
            }
        )

    # gate.py runs as a Python script; if that path is a binary/wrapper
    # (e.g. /usr/local/bin/kimrity-gate), run it directly.
    runner = [sys.executable, GATE] if GATE.endswith(".py") else [GATE]
    cmd = runner + [
        gate_target,
        "--kind",
        gate_kind,
        "--out",
        gate_out,
        "--fail-on",
        args.fail_on,
        "--quiet",
    ]
    if args.authorized:
        cmd.append("--authorized")
    if args.scope:
        cmd += ["--scope", args.scope]

    # Semgrep stores settings below XDG_CONFIG_HOME. Keep Gate's child-tool
    # state inside the session, rather than allowing an inherited host setting
    # to write outside the session (especially important for temporary HOME).
    gate_env = os.environ.copy()
    gate_env["XDG_CONFIG_HOME"] = os.path.join(sdir, ".config")
    try:
        proc = subprocess.run(cmd, capture_output=True, text=True, timeout=3600,
                              env=gate_env)
    except (OSError, subprocess.TimeoutExpired) as exc:
        shutil.rmtree(sdir, ignore_errors=True)
        if staging_dir:
            shutil.rmtree(staging_dir, ignore_errors=True)
        return fail(f"could not run the gate: {exc}")

    gate_json_path = os.path.join(gate_out, "gate.json")
    gate = read_json(gate_json_path)
    if not isinstance(gate, dict):
        detail = (proc.stderr or proc.stdout or "").strip()
        shutil.rmtree(sdir, ignore_errors=True)
        if staging_dir:
            shutil.rmtree(staging_dir, ignore_errors=True)
        return fail(f"gate failed to produce gate.json (rc={proc.returncode}). {detail[:400]}")

    # Move raw evidence into the session.
    raw_src = os.path.join(gate_out, ".raw")
    if os.path.isdir(raw_src):
        for name in os.listdir(raw_src):
            src = os.path.join(raw_src, name)
            dst = os.path.join(raw_dir, name)
            try:
                shutil.move(src, dst)
            except OSError:
                pass
    try:
        shutil.copy2(gate_json_path, os.path.join(raw_dir, "gate.json"))
    except OSError:
        pass
    gate_report = os.path.join(gate_out, "report.md")
    if os.path.isfile(gate_report):
        try:
            shutil.copy2(gate_report, os.path.join(raw_dir, "gate-report.md"))
        except OSError:
            pass
    shutil.rmtree(gate_out, ignore_errors=True)

    file_meta, extra_scanners, extra_findings = {}, [], []
    if kind in ("file", "installer"):
        file_type = ""
        # file(1) classifies source/config files as text; only binaries and
        # explicit installer requests receive the malware scanner attempts.
        try:
            preview = subprocess.run(["file", "-b", target], capture_output=True,
                                     text=True, timeout=30)
            file_type = preview.stdout.lower() if preview.returncode == 0 else ""
        except (OSError, subprocess.TimeoutExpired):
            pass
        file_meta, extra_scanners, extra_findings = run_file_checks(
            target, kind == "installer" or "text" not in file_type
        )
        if staging_dir:
            shutil.rmtree(staging_dir, ignore_errors=True)
            staging_dir = None

    meta = gate.get("meta") or {}
    tools = meta.get("tools") or {}
    errors = gate.get("tool_errors") or {}
    scanners = []
    for name in EXPECTED.get(gate_kind, []):
        if name not in tools:
            scanners.append(
                {"name": name, "status": "skipped", "rc": None,
                 "reason": "not run by the gate"}
            )
        elif name in errors or tools.get(name) is None:
            scanners.append(
                {"name": name, "status": "failed", "rc": 1,
                 "reason": str(errors.get(name, "tool failed to run"))[:300]}
            )
        else:
            scanners.append(
                {"name": name, "status": "done", "rc": 0, "reason": "done"}
            )
    scanners.extend(extra_scanners)

    rules = load_rules()
    ledger = load_ledger()

    # History for the same kind+target, oldest -> newest.
    history = [
        s for s in all_sessions()
        if s.get("kind") == kind and s.get("target") == target and s.get("id") != sid
    ]
    history.sort(key=lambda s: (str(s.get("started") or ""), str(s.get("id") or "")))
    prior = {}
    for old in history:
        old_started = old.get("started") or started
        for pf in old.get("findings", []) or []:
            fp = pf.get("fp")
            if not fp:
                continue
            rec = prior.get(fp)
            first_seen = pf.get("first_seen") or old_started
            if rec is None:
                prior[fp] = {
                    "status": pf.get("status", "new"),
                    "first_seen": first_seen,
                }
            else:
                rec["status"] = pf.get("status", "new")
                if first_seen and (
                    not rec["first_seen"] or str(first_seen) < str(rec["first_seen"])
                ):
                    rec["first_seen"] = first_seen

    finished = now_iso()
    findings = []
    for item in (gate.get("findings", []) or []) + extra_findings:
        tool = str(item.get("tool", "?"))
        rule = str(item.get("rule", "?"))
        file = str(item.get("file", "?"))
        if kind in ("file", "installer") and os.path.basename(file) == os.path.basename(target):
            file = target
        try:
            line = int(item.get("line") or 0)
        except (TypeError, ValueError):
            line = 0
        message = str(item.get("message", ""))[:500]
        fp = hashlib.sha1(
            f"{tool}|{rule}|{file}|{line}".encode("utf-8")
        ).hexdigest()[:12]
        old = prior.get(fp)
        status = old["status"] if old else "new"
        first_seen = old["first_seen"] if old else started
        overwrite = ledger.get(ledger_key(kind, target, fp))
        if isinstance(overwrite, dict) and overwrite.get("status") in STATUSES:
            status = overwrite["status"]
        if status not in STATUSES:
            status = "new"
        evidence = f"{file}:{line} — {message}".strip(" —")
        findings.append(
            {
                "fp": fp,
                "tool": tool,
                "rule": rule,
                "severity": str(item.get("severity", "unknown")).lower(),
                "file": file,
                "line": line,
                "message": message,
                "evidence": evidence,
                "explanation": rules.get(f"{tool}|{rule}"),
                "status": status,
                "first_seen": first_seen,
                "last_seen": finished,
            }
        )

    raw_counts = gate.get("counts") or {}
    for item in extra_findings:
        severity = str(item.get("severity", "unknown")).lower()
        raw_counts[severity] = int(raw_counts.get(severity, 0) or 0) + 1
    verdict = GATE_VERDICT.get(str(gate.get("verdict")), "FAIL")
    if extra_findings:
        verdict = "FAIL"
    session = {
        "id": sid,
        "kind": kind,
        "target": target,
        "file_path": target if kind in ("file", "installer") else None,
        "profile": f"{kind}-standard",
        "authorized": auth,
        "started": started,
        "finished": finished,
        "verdict": verdict,
        "scanners": scanners,
        "counts": {
            "critical": int(raw_counts.get("critical", 0) or 0),
            "high": int(raw_counts.get("high", 0) or 0),
            "medium": int(raw_counts.get("medium", 0) or 0),
            "low": int(raw_counts.get("low", 0) or 0),
        },
        "findings": findings,
    }
    if kind in ("file", "installer"):
        session.update(file_meta)

    write_json(os.path.join(sdir, "session.json"), session)
    write_report(session, os.path.join(sdir, "report.md"))

    code = VERDICT_EXIT.get(session["verdict"], 3)
    if args.json:
        for scanner in scanners:
            json_emit(
                {
                    "phase": "scanner",
                    "name": scanner["name"],
                    "status": scanner["status"],
                    "rc": scanner["rc"],
                    "reason": scanner["reason"],
                }
            )
        json_emit(
            {
                "phase": "done",
                "id": sid,
                "verdict": session["verdict"],
                "counts": session["counts"],
                "exit": code,
            }
        )
    else:
        print_session(session)
    return code


# ---------------------------------------------------------------- posture
#
# Posture runs as the logged-in user, reads only files that are readable
# without root, and says so when a check could not be evaluated. That is the
# point of the mirror: never claim "clean" for something it could not see.

SYSROOT = os.environ.get("KIMSCAN_POSTURE_ROOT") or "/"
SS_FIXTURE = os.environ.get("KIMSCAN_POSTURE_SS") or ""
MIN_AUDIT_WATCHES = 8
SEV_RANK_ANY = {"critical": 0, "high": 1, "medium": 2, "low": 3, "info": 4}

# Ports that are dangerous when reachable from the network. A plain wildcard
# listener is only "low"; these carry their own reason.
RISKY_PORTS = {
    21: ("medium", "FTP sends the password in clear text."),
    23: ("high", "Telnet sends everything, including the password, in clear text."),
    111: ("medium", "rpcbind exposes RPC services to whoever can reach the port."),
    445: ("high", "SMB is a common lateral-movement and ransomware target."),
    2375: ("high", "The Docker API without TLS lets anyone start containers as root."),
    3306: ("medium", "A database port reachable from the network widens the attack surface."),
    3389: ("medium", "RDP is a frequent target for password spraying."),
    5432: ("medium", "A database port reachable from the network widens the attack surface."),
    5900: ("medium", "VNC is often unauthenticated or weakly authenticated."),
}

SYSCTL_EXPECT = [
    ("kernel.kptr_restrict", 1, "kernel addresses are readable by unprivileged users"),
    ("kernel.dmesg_restrict", 1, "the kernel log is readable by unprivileged users"),
    ("kernel.yama.ptrace_scope", 1, "any process of the same user can be traced and read"),
    ("fs.protected_hardlinks", 1, "hardlink attacks against files you own are possible"),
    ("fs.protected_symlinks", 1, "symlink attacks in world-writable directories are possible"),
    ("net.ipv4.conf.all.accept_redirects", 0, "the host accepts ICMP redirects"),
]


def sys_path(*parts) -> str:
    """Path below the posture root (``/`` normally, a fixture in tests)."""
    return os.path.join(SYSROOT, *parts)


def _run(cmd, timeout=10):
    try:
        proc = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout)
        return proc.returncode, (proc.stdout or "") + (proc.stderr or "")
    except (OSError, subprocess.TimeoutExpired) as exc:
        return 127, str(exc)


def _read(path: str, limit: int = 1_000_000):
    try:
        with open(path, "r", encoding="utf-8", errors="replace") as fh:
            return fh.read(limit)
    except OSError:
        return None


def posture_item(check, key, severity, what, why, fix, detail=""):
    return {
        "tool": "posture",
        "rule": check,
        "key": key,
        "severity": severity,
        "what": what,
        "why": why,
        "fix": fix,
        "detail": detail,
    }


def check_auditd_service():
    if SYSROOT != "/":
        return [], {"name": "auditd", "status": "skipped",
                    "reason": "fixture root: service state is not simulated"}
    _rc, out = _run(["systemctl", "is-active", "auditd"])
    state = out.strip().splitlines()[0].strip() if out.strip() else "no answer"
    if state != "active":
        return [posture_item(
            "auditd", "service:auditd", "high",
            "The audit daemon is not running.",
            "No auditd means no etc_watch and no privilege-change record; "
            "KimLogPipe can only read journald, so file changes go unseen.",
            "sudo systemctl enable --now auditd",
            f"systemctl is-active auditd -> {state}",
        )], {"name": "auditd", "status": "done", "reason": f"state={state}"}
    return [], {"name": "auditd", "status": "done", "reason": f"state={state}"}


def check_audit_rules():
    items = []
    rules_dir = sys_path("etc", "audit", "rules.d")
    try:
        names = sorted(n for n in os.listdir(rules_dir) if n.endswith(".rules"))
    except OSError:
        return items, {"name": "audit-rules", "status": "skipped",
                       "reason": f"{rules_dir} is not readable"}
    watches, unreadable = 0, []
    for name in names:
        text = _read(os.path.join(rules_dir, name))
        if text is None:
            unreadable.append(name)
            continue
        for line in text.splitlines():
            stripped = line.strip()
            if stripped.startswith(("-w ", "-a ", "-A ")):
                watches += 1
    if unreadable and not watches:
        return items, {"name": "audit-rules", "status": "skipped",
                       "reason": "rule file(s) not readable: " + ", ".join(unreadable)}
    if watches < MIN_AUDIT_WATCHES:
        items.append(posture_item(
            "audit-rules", "audit:watches", "medium",
            f"Only {watches} audit watch rule(s) are installed.",
            "etc_watch needs watches on the identity files; without them a "
            "change to /etc/passwd, /etc/shadow or /etc/sudoers leaves no trace "
            "for KimLogPipe to report.",
            "Restore /etc/audit/rules.d/kimrity.rules from the installer (or "
            "the ISO), then run: sudo augenrules --load",
            f"{watches} rule(s) in {len(names)} file(s) under {rules_dir}",
        ))
    log_group = ""
    conf = _read(sys_path("etc", "audit", "auditd.conf"))
    if conf is not None:
        for line in conf.splitlines():
            if line.strip().startswith("log_group"):
                log_group = line.split("=", 1)[-1].strip()
                break
        if log_group and log_group != "systemd-journal":
            items.append(posture_item(
                "audit-rules", "audit:log_group", "medium",
                f"The audit log is owned by group '{log_group}', not 'systemd-journal'.",
                "KimLogPipe runs as your user and needs the log group to read "
                "/var/log/audit/audit.log; with the wrong group etc_watch is "
                "silently unavailable.",
                "Set 'log_group = systemd-journal' in /etc/audit/auditd.conf, "
                "then: sudo systemctl kill -s HUP auditd",
                f"log_group = {log_group}",
            ))
    detail = f"{watches} watch rule(s)"
    if conf is None:
        detail += "; auditd.conf not readable (needs root)"
    return items, {"name": "audit-rules", "status": "done", "reason": detail}


def check_pipeline():
    if SYSROOT != "/" or not os.environ.get("XDG_RUNTIME_DIR"):
        return [], {"name": "pipeline", "status": "skipped",
                    "reason": "no user session to inspect"}
    items = []
    run_dir = os.environ["XDG_RUNTIME_DIR"]
    states = {}
    for unit, role in (("kimai", "approval broker"), ("kimlogpipe", "log pipeline")):
        _rc, out = _run(["systemctl", "--user", "is-active", unit])
        state = out.strip().splitlines()[0].strip() if out.strip() else "no answer"
        states[unit] = state
        if state != "active":
            items.append(posture_item(
                "pipeline", f"service:{unit}", "medium",
                f"{unit}.service ({role}) is not running.",
                "Without both user services the host stops explaining itself: "
                "findings are recorded but nothing is delivered for approval.",
                f"systemctl --user enable --now {unit}.service",
                f"systemctl --user is-active {unit} -> {state}",
            ))
    sock = os.path.join(run_dir, "kimai.sock")
    try:
        st = os.stat(sock)
    except OSError:
        if states.get("kimai") == "active":
            items.append(posture_item(
                "pipeline", "socket:kimai", "high",
                "KimAI is running but its socket is missing.",
                "KimLogPipe delivers events over this socket; without it every "
                "finding falls back to tools-only mode.",
                "Check the KimAI log: journalctl --user -u kimai -n 40",
                f"{sock} does not exist",
            ))
    else:
        mode = stat.S_IMODE(st.st_mode)
        if mode != 0o600:
            items.append(posture_item(
                "pipeline", "socket:kimai-mode", "high",
                f"The KimAI socket mode is {mode:04o}, not 0600.",
                "The socket is the trust boundary: 0600 plus SO_PEERCRED is "
                "what stops other local users from feeding the broker.",
                "chmod 600 " + sock,
                f"mode {mode:04o}",
            ))
        if st.st_uid != os.getuid():
            items.append(posture_item(
                "pipeline", "socket:kimai-owner", "high",
                "The KimAI socket is owned by another user.",
                "A socket owned by someone else means the broker you talk to is "
                "not the one your session started.",
                "Remove the stale socket and restart KimAI: systemctl --user restart kimai",
                f"uid {st.st_uid} != {os.getuid()}",
            ))
    return items, {"name": "pipeline", "status": "done",
                   "reason": " ".join(f"{k}={v}" for k, v in states.items())}


def _ss_lines():
    if SS_FIXTURE:
        text = _read(SS_FIXTURE)
        return (text or "").splitlines()
    rc, out = _run(["ss", "-ltnH"])
    if rc != 0:
        return None
    return out.splitlines()


def check_listeners():
    lines = _ss_lines()
    if lines is None:
        return [], {"name": "listeners", "status": "skipped",
                    "reason": "ss is not available"}
    items = []
    wildcard = 0
    for line in lines:
        parts = line.split()
        if len(parts) < 4:
            continue
        local = parts[3]
        host, _, port_text = local.rpartition(":")
        try:
            port = int(port_text)
        except ValueError:
            continue
        host = host.strip("[]")
        if host in ("127.0.0.1", "::1", "localhost"):
            continue
        if host not in ("0.0.0.0", "::", "*"):
            continue
        wildcard += 1
        severity, why = RISKY_PORTS.get(
            port,
            ("low", "Any host that can reach this machine can connect to this port."),
        )
        name = ""
        try:
            import socket as _socket  # local import: only used for a label
            name = _socket.getservbyport(port, "tcp")
        except OSError:
            pass
        # [::] keeps its brackets in the key: listen:[::]:22 reads as an
        # address, listen::::22 does not.
        label = f"[{host}]" if ":" in host else host
        items.append(posture_item(
            "listeners", f"listen:{label}:{port}", severity,
            f"A service listens on every interface, port {port}"
            f"{' (' + name + ')' if name else ''}.",
            why,
            "Bind the service to 127.0.0.1 if only local programs need it, or "
            "close the port with the firewall.",
            f"{local} (ss -ltn)",
        ))
    return items, {"name": "listeners", "status": "done",
                   "reason": f"{wildcard} wildcard listener(s)"}


def _sshd_values():
    main = _read(sys_path("etc", "ssh", "sshd_config"))
    if main is None:
        return None
    text = main
    dropin = sys_path("etc", "ssh", "sshd_config.d")
    try:
        for name in sorted(os.listdir(dropin)):
            if name.endswith(".conf"):
                part = _read(os.path.join(dropin, name))
                if part:
                    text += "\n" + part
    except OSError:
        pass
    values = {}
    for line in text.splitlines():
        stripped = line.strip()
        if not stripped or stripped.startswith("#"):
            continue
        parts = stripped.split(None, 1)
        if len(parts) == 2:
            # sshd keeps the FIRST value it reads.
            values.setdefault(parts[0].lower(), parts[1].strip())
    return values


def check_sshd():
    values = _sshd_values()
    if values is None:
        return [], {"name": "sshd", "status": "skipped",
                    "reason": "openssh-server is not installed"}
    items = []
    root_login = values.get("permitrootlogin", "prohibit-password").lower()
    if root_login == "yes":
        items.append(posture_item(
            "sshd", "sshd:permitrootlogin", "high",
            "SSH allows the root account to log in with a password.",
            "A guessed root password hands over the whole machine, and root "
            "logins defeat the point of a personal account with sudo.",
            "Set 'PermitRootLogin prohibit-password' in /etc/ssh/sshd_config "
            "and restart sshd.",
            f"PermitRootLogin {root_login}",
        ))
    password_auth = values.get("passwordauthentication", "yes").lower()
    if password_auth == "yes":
        items.append(posture_item(
            "sshd", "sshd:passwordauthentication", "medium",
            "SSH accepts passwords.",
            "Passwords can be guessed over the network; keys cannot. KimLogPipe "
            "detects the brute force, but detection is not prevention.",
            "Use keys, then set 'PasswordAuthentication no' and restart sshd.",
            f"PasswordAuthentication {password_auth}",
        ))
    if values.get("permitemptypasswords", "no").lower() == "yes":
        items.append(posture_item(
            "sshd", "sshd:permitemptypasswords", "high",
            "SSH accepts accounts with an empty password.",
            "An empty password is not a password: anyone who knows the username gets in.",
            "Set 'PermitEmptyPasswords no' and restart sshd.",
            "PermitEmptyPasswords yes",
        ))
    return items, {"name": "sshd", "status": "done",
                   "reason": f"permitrootlogin={root_login}"}


def _account_lines():
    text = _read(sys_path("etc", "passwd"))
    if text is None:
        return None
    rows = []
    for line in text.splitlines():
        parts = line.split(":")
        if len(parts) >= 4:
            rows.append(parts)
    return rows


def check_accounts():
    rows = _account_lines()
    if rows is None:
        return [], {"name": "accounts", "status": "skipped",
                    "reason": "/etc/passwd is not readable"}
    items = []
    for parts in rows:
        name, password, uid = parts[0], parts[1], parts[2]
        if uid == "0" and name != "root":
            items.append(posture_item(
                "accounts", f"account:uid0:{name}", "critical",
                f"Account '{name}' has UID 0 (root privileges).",
                "UID 0 is root; a second UID 0 account is a hidden backdoor that "
                "keeps working after the root password is changed.",
                "Remove the account or change its UID: sudo usermod -u <new-uid> " + name,
                f"{name}:x:{uid}:...",
            ))
        if password == "":
            items.append(posture_item(
                "accounts", f"account:emptypass:{name}", "critical",
                f"Account '{name}' has an empty password field.",
                "An empty password field lets anyone log in as this account "
                "without a secret.",
                "Lock the account: sudo passwd -l " + name,
                f"{name}::... in /etc/passwd",
            ))
    return items, {"name": "accounts", "status": "done",
                   "reason": f"{len(rows)} account(s)"}


def check_shadow():
    text = _read(sys_path("etc", "shadow"))
    if text is None:
        return [], {"name": "shadow", "status": "skipped",
                    "reason": "needs root to read /etc/shadow"}
    items = []
    for line in text.splitlines():
        parts = line.split(":")
        if len(parts) >= 2 and parts[1] == "":
            items.append(posture_item(
                "shadow", f"account:no-hash:{parts[0]}", "critical",
                f"Account '{parts[0]}' has no password hash.",
                "An empty hash means the login succeeds without a password.",
                "Lock the account or set a password: sudo passwd -l " + parts[0],
                f"{parts[0]}:<empty>:...",
            ))
    return items, {"name": "shadow", "status": "done",
                   "reason": f"{len(text.splitlines())} hash line(s)"}


def check_sudoers():
    files = [sys_path("etc", "sudoers")]
    dropin = sys_path("etc", "sudoers.d")
    try:
        files += [os.path.join(dropin, n) for n in sorted(os.listdir(dropin))]
    except OSError:
        pass
    readable, hits, unreadable = [], [], []
    for path in files:
        if not os.path.isfile(path):
            continue
        text = _read(path)
        if text is None:
            unreadable.append(os.path.basename(path))
            continue
        readable.append(os.path.basename(path))
        for line in text.splitlines():
            stripped = line.strip()
            if not stripped or stripped.startswith("#"):
                continue
            if "nopasswd" in stripped.lower():
                hits.append(stripped[:120])
    if not readable:
        return [], {"name": "sudoers", "status": "skipped",
                    "reason": "needs root to read /etc/sudoers and /etc/sudoers.d"}
    items = []
    for line in hits:
        items.append(posture_item(
            "sudoers", f"sudoers:nopasswd:{line.split()[0]}", "medium",
            "A sudo rule runs without asking for a password.",
            "NOPASSWD turns any process running as your user into root, which "
            "is how a small compromise becomes a full one.",
            "Remove NOPASSWD unless it is a deliberate, time-limited grant.",
            line,
        ))
    return items, {"name": "sudoers", "status": "done",
                   "reason": f"{len(readable)} file(s) readable"}


def check_path():
    items = []
    seen = set()
    for entry in os.environ.get("PATH", "").split(":"):
        if not entry or entry in seen:
            continue
        seen.add(entry)
        try:
            st = os.stat(entry)
        except OSError:
            continue
        mode = stat.S_IMODE(st.st_mode)
        if mode & 0o002 and not mode & 0o1000:
            items.append(posture_item(
                "path", f"path:worldwritable:{entry}", "high",
                f"Directory '{entry}' is in PATH and is world-writable.",
                "Anyone who can write there can replace a command your shell or "
                "an admin script will run next.",
                f"chmod o-w {entry}",
                f"mode {mode:04o}",
            ))
    return items, {"name": "path", "status": "done",
                   "reason": f"{len(seen)} dir(s)"}


def check_sysctl():
    checked, missing, items = 0, 0, []
    for name, wanted, why in SYSCTL_EXPECT:
        path = sys_path("proc", "sys", *name.split("."))
        text = _read(path)
        if text is None:
            missing += 1
            continue
        try:
            value = int(text.strip())
        except ValueError:
            missing += 1
            continue
        checked += 1
        weak = value < wanted if wanted == 1 else value != wanted
        if weak:
            items.append(posture_item(
                "sysctl", f"sysctl:{name}", "low",
                f"{name} = {value}.",
                why + ".",
                f"Set it: sudo sysctl -w {name}={wanted} (persist it in "
                "/etc/sysctl.d/99-kimrity.conf)",
                f"{name}={value}, expected {'>=' if wanted == 1 else '='}{wanted}",
            ))
    if checked == 0:
        return [], {"name": "sysctl", "status": "skipped",
                    "reason": "no readable values under /proc/sys"}
    return items, {"name": "sysctl", "status": "done",
                   "reason": f"{checked} value(s), {missing} unavailable"}


def check_filesystem():
    items = []
    checked = 0
    for target in ("/tmp", "/var/tmp", "/dev/shm"):
        try:
            st = os.stat(sys_path(target.lstrip("/")))
        except OSError:
            continue
        checked += 1
        mode = stat.S_IMODE(st.st_mode)
        if mode & 0o002 and not mode & 0o1000:
            items.append(posture_item(
                "filesystem", f"fs:worldwritable:{target}", "high",
                f"{target} is world-writable without the sticky bit.",
                "Without the sticky bit any user can delete or replace files "
                "that belong to someone else.",
                f"sudo chmod +t {target}",
                f"mode {mode:04o}",
            ))
    if checked == 0:
        return [], {"name": "filesystem", "status": "skipped",
                    "reason": "no temporary directories found"}
    return items, {"name": "filesystem", "status": "done",
                   "reason": f"{checked} dir(s)"}


def check_disk():
    if SYSROOT != "/":
        return [], {"name": "disk", "status": "skipped",
                    "reason": "fixture root: block devices are not simulated"}
    _rc, source = _run(["findmnt", "-n", "-o", "SOURCE", "/"])
    source = source.strip().splitlines()[0].strip() if source.strip() else ""
    encrypted = source.startswith("/dev/mapper/") or "/dev/dm-" in source
    if not encrypted:
        _rc, types = _run(["lsblk", "-rno", "TYPE"])
        encrypted = any(line.strip() == "crypt" for line in types.splitlines())
    if encrypted:
        return [], {"name": "disk", "status": "done", "reason": f"root={source} (encrypted)"}
    return [posture_item(
        "disk", "disk:root-unencrypted", "info",
        "The root filesystem is not on an encrypted device.",
        "Anyone with physical access can read or modify the disk, including "
        "the KimAI events and the audit trail.",
        "Plan LUKS for the next install; nothing to do on this running system.",
        f"findmnt -o SOURCE / -> {source or 'unknown'}",
    )], {"name": "disk", "status": "done", "reason": f"root={source or 'unknown'}"}



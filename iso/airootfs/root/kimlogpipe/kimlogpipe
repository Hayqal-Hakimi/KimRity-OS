def ingest_journald_file(path: Path):
    events, raw_map = [], {}
    invalid = 0
    lines_read = 0
    try:
        fh = path.open("r", encoding="utf-8", errors="replace")
    except OSError as exc:
        die(f"cannot read {path}: {exc}")
    with fh:
        for lineno, raw in enumerate(fh, 1):
            lines_read += 1
            raw = raw.rstrip("\n")
            if not raw.strip():
                continue
            try:
                rec = json.loads(raw)
            except json.JSONDecodeError:
                invalid += 1
                continue
            raw_ref = f"{path}:{lineno}"
            event, _reason = parse_journald_line(rec, raw_ref)
            if event is None:
                invalid += 1
                continue
            events.append(event)
            raw_map[raw_ref] = raw
    return events, raw_map, invalid, lines_read


def ingest_journald_live():
    cmd = ["journalctl", "-o", "json", "--no-pager", "-n", str(JOURNAL_LINES)]
    try:
        proc = subprocess.run(cmd, capture_output=True, text=True, timeout=60)
    except FileNotFoundError:
        die("journalctl not found (this is not a systemd system?)")
    except subprocess.TimeoutExpired:
        die("journalctl timed out after 60s")
    if proc.returncode != 0:
        die(f"journalctl failed: {proc.stderr.strip() or 'code ' + str(proc.returncode)}")
    events, raw_map = [], {}
    invalid = 0
    lines_read = 0
    for raw in proc.stdout.splitlines():
        lines_read += 1
        try:
            rec = json.loads(raw)
        except json.JSONDecodeError:
            invalid += 1
            continue
        cursor = str(rec.get("__CURSOR", "") or "")
        if not cursor:
            cursor = "journalctl:seq=" + str(rec.get("__SEQNUM", "?"))
        event, _reason = parse_journald_line(rec, cursor)
        if event is None:
            invalid += 1
            continue
        events.append(event)
        raw_map[cursor] = raw
    return events, raw_map, invalid, lines_read


def ingest_audit_file(path: Path):
    return parse_audit_file(path)


def cmd_ingest(args):
    if args.file:
        path = Path(args.file).expanduser().resolve()
        if not path.is_file():
            die(f"file not found: {path}")
        if args.source == "journald":
            events, raw_map, invalid, lines_read = ingest_journald_file(path)
        else:
            events, raw_map, invalid, lines_read = ingest_audit_file(path)
        label = f"file: {path}"
    else:
        if args.source == "journald":
            events, raw_map, invalid, lines_read = ingest_journald_live()
            label = f"live: journalctl -n {JOURNAL_LINES}"
        else:
            path = Path(AUDIT_LOG)
            if not path.is_file():
                die(f"live audit file not found: {path}")
            events, raw_map, invalid, lines_read = ingest_audit_file(path)
            label = f"live: {path}"

    added, dupes = store_events(events, raw_map)
    total = len(load_events())
    log(f"Source            : {args.source} ({label})")
    log(f"Lines read        : {lines_read}")
    log(f"Events parsed     : {len(events)}")
    log(f"New events        : {added}")
    log(f"Duplicates skipped: {dupes}")
    log(f"Invalid lines     : {invalid}")
    log(f"Total in store    : {total}")
    log(f"Store             : {data_dir()}")


# ---------------------------------------------------------------------------
# Rule engine
# ---------------------------------------------------------------------------


def evidence_for(events, raw_map):
    out = []
    for ev in events:
        ref = ev.get("raw_ref", "")
        line = raw_map.get(ref)
        if line is None and ":" in ref:
            # Fallback: read the source file again when the sidecar is gone.
            fname, _, lineno = ref.rpartition(":")
            try:
                with open(fname, "r", encoding="utf-8", errors="replace") as fh:
                    for i, raw in enumerate(fh, 1):
                        if i == int(lineno):
                            line = raw.rstrip("\n")
                            break
            except (OSError, ValueError):
                line = None
        if line is None:
            line = ""
        out.append({"raw_ref": ref, "line": line[:2000]})
    return out


def finding(rule, count, first_ts, last_ts, key, evidence, summary):
    return {
        "rule": rule["name"],
        "severity": rule["severity"],
        "count": count,
        "first_ts": first_ts,
        "last_ts": last_ts,
        "key": key,
        "evidence": evidence,
        "summary": summary,
    }


def _not_evaluable(reason):
    return "not_evaluable", reason, []


def eval_threshold(rule, events, raw_map):
    signals = set(rule.get("signals") or [])
    key_field = rule.get("key") or "src_ip"
    try:
        threshold = int(rule["threshold"])
        window = int(rule["window_seconds"])
    except (KeyError, TypeError, ValueError):
        return _not_evaluable("threshold/window_seconds is not a valid number")
    if not events:
        return _not_evaluable("no events in the store/window")
    cands = [e for e in events if e.get("action") in signals]
    if not cands:
        if any(e.get("src_ip") for e in events):
            return (
                "no_match",
                "0 failure signals (the fixture only holds successful logins)",
                [],
            )
        return _not_evaluable("the src_ip field is absent from the event set")
    cands_ip = [e for e in cands if e.get(key_field)]
    if not cands_ip:
        return _not_evaluable("the %s field is absent on failure signals" % key_field)

    findings = []
    by_key = {}
    for e in cands_ip:
        by_key.setdefault(e[key_field], []).append(e)
    for key, items in by_key.items():
        items.sort(key=lambda e: epoch_of(e["ts"]))
        stamps = [epoch_of(e["ts"]) for e in items]
        best = None
        j = 0
        for i in range(len(items)):
            if j < i:
                j = i
            while j < len(items) and stamps[j] - stamps[i] <= window:
                j += 1
            n = j - i
            if n >= threshold and (best is None or n > best[0]):
                best = (n, i, j)
        if best is None:
            continue
        n, i, j = best
        win = items[i:j]
        summary = (
            f"{n} failed SSH authentication signals from {key} "
            f"within {window}s (threshold {threshold})."
        )
        findings.append(
            finding(
                rule,
                n,
                win[0]["ts"],
                win[-1]["ts"],
                key,
                evidence_for(win, raw_map),
                summary,
            )
        )
    if not findings:
        return (
            "no_match",
            f"{len(cands_ip)} failure signals, no key reached the "
            f"{threshold}/{window}s threshold",
            [],
        )
    return "found", "", findings


def eval_any_failed(rule, events, raw_map):
    actions = set(rule.get("actions") or ["sudo_fail", "su_fail"])
    domain_actions = set(
        rule.get("domain_actions") or ["sudo", "sudo_fail", "su", "su_fail"]
    )
    if not events:
        return _not_evaluable("no events in the store/window")
    domain = [e for e in events if e.get("action") in domain_actions]
    if not domain:
        return _not_evaluable(
            "no sudo/su record in the event set (no sudo/su action field)"
        )
    failed = [e for e in domain if e.get("action") in actions]
    if not failed:
        return (
            "no_match",
            f"{len(domain)} sudo/su records, no authentication failure",
            [],
        )
    findings = []
    by_user = {}
    for e in failed:
        by_user.setdefault(e.get("user", ""), []).append(e)
    for user, items in by_user.items():
        items.sort(key=lambda e: epoch_of(e["ts"]))
        label = user or "(unknown user)"
        summary = f"{len(items)} failed sudo/su authentication for {label}."
        findings.append(
            finding(
                rule,
                len(items),
                items[0]["ts"],
                items[-1]["ts"],
                user,
                evidence_for(items, raw_map),
                summary,
            )
        )
    return "found", "", findings


def eval_exec_watch(rule, events, raw_map):
    if not events:
        return _not_evaluable("no events in the store/window")
    execs = [e for e in events if str(e.get("action", "")).startswith("execve:")]
    if not execs:
        return _not_evaluable(
            "no execve record (no syscall/exe field in the event set)"
        )
    watch = {str(w).lower() for w in (rule.get("watch") or [])}
    matched = []
    for e in execs:
        binary = e["action"].split(":", 1)[1].lower()
        if binary in watch:
            matched.append(e)
    if not matched:
        return (
            "no_match",
            f"{len(execs)} execve records, none matched the watch list",
            [],
        )
    findings = []
    grouped = {}
    for e in matched:
        binary = e["action"].split(":", 1)[1]
        grouped.setdefault((e.get("user", ""), binary), []).append(e)
    for (user, binary), items in grouped.items():
        items.sort(key=lambda e: epoch_of(e["ts"]))
        label = user or "(unknown user)"
        summary = (
            f"Watched binary executed: {binary} by {label} ({len(items)} times)."
        )
        findings.append(
            finding(
                rule,
                len(items),
                items[0]["ts"],
                items[-1]["ts"],
                user,
                evidence_for(items, raw_map),
                summary,
            )
        )
    return "found", "", findings


def eval_any_match(rule, events, raw_map):
    actions = set(rule.get("actions") or [])
    if not events:
        return _not_evaluable("no events in the store/window")
    matches = [e for e in events if e.get("action") in actions]
    if not matches:
        return (
            "no_match",
            f"no record with action {', '.join(sorted(actions)) or '(none)'}",
            [],
        )
    findings = []
    grouped = {}
    for e in matches:
        grouped.setdefault(e.get("path", "") or e.get("user", ""), []).append(e)
    for key, items in grouped.items():
        items.sort(key=lambda e: epoch_of(e["ts"]))
        label = key or "(no key)"
        summary = (
            f"{len(items)} watched-path change(s) for {label} "
            f"(latest: {items[-1].get('path') or 'unknown'})."
        )
        findings.append(
            finding(
                rule,
                len(items),
                items[0]["ts"],
                items[-1]["ts"],
                key,
                evidence_for(items, raw_map),
                summary,
            )
        )
    return "found", "", findings


EVALUATORS = {
    "threshold": eval_threshold,
    "any_failed": eval_any_failed,
    "exec_watch": eval_exec_watch,
    "any_match": eval_any_match,
}


def evaluate(rules, events, raw_map):
    """Run every rule. Return (per-rule results, flat findings)."""
    results, flat = [], []
    for rule in rules:
        if not rule.get("enabled", True):
            results.append(
                {
                    "rule": rule["name"],
                    "severity": rule["severity"],
                    "status": "disabled",
                    "reason": "disabled in rules.yaml",
                    "findings": [],
                }
            )
            continue
        evaluator = EVALUATORS.get(rule.get("type"))
        if evaluator is None:
            status, reason, found = (
                "not_evaluable",
                f"unknown rule type: {rule.get('type')}",
                [],
            )
        else:
            status, reason, found = evaluator(rule, events, raw_map)
        results.append(
            {
                "rule": rule["name"],
                "severity": rule["severity"],
                "status": status,
                "reason": reason,
                "findings": found,
            }
        )
        flat.extend(found)
    return results, flat


def parse_since(text: str) -> float:
    m = re.fullmatch(r"(\d+)([smhd])", text.strip().lower())
    if not m:
        die("invalid --since value; examples: 30s, 5m, 2h, 1d")
    val, unit = int(m.group(1)), m.group(2)
    mult = {"s": 1, "m": 60, "h": 3600, "d": 86400}[unit]
    return val * mult


def cmd_detect(args):
    rules_doc = load_rules()
    all_events = load_events()
    raw_map = load_raw_map()
    since_desc = None
    events = all_events
    if args.since:
        seconds = parse_since(args.since)
        cutoff = datetime.now(timezone.utc).timestamp() - seconds
        events = [e for e in all_events if epoch_of(e["ts"]) >= cutoff]
        since_desc = args.since

    if not all_events:
        log("The event store is empty. Run `kimlogpipe ingest ...` first.")
    log(
        f"Events evaluated: {len(events)}"
        + (f" (--since {since_desc})" if since_desc else " (all)")
    )
    log("")

    results, flat = evaluate(rules_doc["rules"], events, raw_map)
    for r in results:
        status = r["status"]
        if status == "found":
            log(f"{r['rule']}: {len(r['findings'])} finding(s)")
            for f in r["findings"]:
                log(
                    f"  - [{f['severity']}] key={f['key'] or '(none)'} "
                    f"count={f['count']} {f['first_ts']} .. {f['last_ts']}"
                )
                log(f"    {f['summary']}")
        elif status == "no_match":
            log(f"{r['rule']}: no match ({r['reason']})")
        elif status == "disabled":
            log(f"{r['rule']}: disabled")
        else:
            log(f"{r['rule']}: not evaluable ({r['reason']})")

    doc = {
        "generated_at": now_iso(),
        "since": since_desc,
        "event_count": len(events),
        "rules": results,
        "findings": flat,
    }
    atomic_write(findings_path(), json.dumps(doc, ensure_ascii=False, indent=2) + "\n")
    log("")
    log(f"Total findings: {len(flat)}")
    log(f"Findings file : {findings_path()}")



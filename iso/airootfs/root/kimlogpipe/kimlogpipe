# KimAI client (tools-only fallback when the broker is down)
# ---------------------------------------------------------------------------


def kimai_socket_path() -> Path:
    override = os.environ.get("KIMAI_SOCKET", "").strip()
    if override:
        return Path(override)
    candidates = []
    xdg = os.environ.get("XDG_RUNTIME_DIR", "").strip()
    if xdg:
        candidates.append(Path(xdg) / "kimai.sock")
    candidates.append(Path("/run/user/%d" % os.getuid()) / "kimai.sock")
    candidates.append(Path.home() / ".cache" / "kimai" / "kimai.sock")
    for candidate in candidates:
        if candidate.exists():
            return candidate
    return candidates[0]


def kimai_emit(kind, severity, summary, data, timeout=2.0):
    """Send one finding to KimAI. Return (ok, detail). Never raises."""
    path = kimai_socket_path()
    if not path.exists():
        return False, "socket not found at %s" % path
    request = {
        "id": uuid.uuid4().hex,
        "op": "event",
        "args": {
            "source": APP,
            "kind": kind,
            "severity": severity,
            "summary": summary,
            "data": data,
        },
    }
    client = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    client.settimeout(timeout)
    try:
        client.connect(str(path))
        client.sendall((json.dumps(request, ensure_ascii=False) + "\n").encode("utf-8"))
        raw = client.makefile("rb").readline()
        if not raw:
            return False, "empty response"
        response = json.loads(raw.decode("utf-8"))
        if not isinstance(response, dict):
            return False, "invalid response"
        if not response.get("ok"):
            return False, str(response.get("error", "unknown error"))
        return True, response.get("result", {}).get("event_id", "")
    except (OSError, TimeoutError, ValueError):
        return False, "KimAI did not answer"
    finally:
        try:
            client.close()
        except OSError:
            pass



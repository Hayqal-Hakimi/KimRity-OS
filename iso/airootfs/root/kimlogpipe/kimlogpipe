def data_dir() -> Path:
    """Storage directory. XDG_DATA_HOME first, then ~/.local/share."""
    xdg = os.environ.get("XDG_DATA_HOME", "").strip()
    base = Path(xdg) if xdg else Path.home() / ".local" / "share"
    d = base / APP
    d.mkdir(parents=True, exist_ok=True, mode=0o700)
    return d


def iso_ts(epoch: float) -> str:
    """Epoch -> ISO8601 UTC with microseconds (e.g. 2026-10-26T10:01:59.317763Z)."""
    dt = datetime.fromtimestamp(epoch, timezone.utc)
    return dt.isoformat(timespec="microseconds").replace("+00:00", "Z")


def epoch_of(ts: str) -> float:
    return datetime.fromisoformat(ts.replace("Z", "+00:00")).timestamp()


def now_iso() -> str:
    return iso_ts(datetime.now(timezone.utc).timestamp())


def log(msg: str) -> None:
    print(msg, flush=True)


def die(msg: str, code: int = 1) -> "NoReturn":
    print(f"ERROR: {msg}", file=sys.stderr, flush=True)
    sys.exit(code)


# ---------------------------------------------------------------------------
# Mini YAML parser (fallback when PyYAML is absent). Supports only the subset
# used by rules.yaml: maps, lists, scalars and inline lists.
# ---------------------------------------------------------------------------


def _strip_comment(line: str) -> str:
    out = []
    quote = None
    for ch in line:
        if quote:
            out.append(ch)
            if ch == quote:
                quote = None
        else:
            if ch in ("'", '"'):
                quote = ch
                out.append(ch)
            elif ch == "#":
                break
            else:
                out.append(ch)
    return "".join(out).rstrip()


def _split_inline(text: str):
    parts, buf, quote = [], [], None
    for ch in text:
        if quote:
            buf.append(ch)
            if ch == quote:
                quote = None
        elif ch in ("'", '"'):
            quote = ch
            buf.append(ch)
        elif ch == ",":
            parts.append("".join(buf))
            buf = []
        else:
            buf.append(ch)
    if buf:
        parts.append("".join(buf))
    return parts


def _scalar(text: str):
    s = text.strip()
    if not s:
        return None
    if s.startswith("[") and s.endswith("]"):
        inner = s[1:-1].strip()
        return [] if not inner else [_scalar(x) for x in _split_inline(inner)]
    if len(s) >= 2 and s[0] == s[-1] and s[0] in ("'", '"'):
        return s[1:-1]
    low = s.lower()
    if low in ("true", "yes"):
        return True
    if low in ("false", "no"):
        return False
    if low in ("null", "~"):
        return None
    try:
        return int(s)
    except ValueError:
        pass
    try:
        return float(s)
    except ValueError:
        pass
    return s


_KV_LINE = re.compile(r"^[A-Za-z_][\w-]*\s*:")


def _parse_block(lines, i, indent):
    if i >= len(lines):
        return None, i
    if lines[i][1].startswith("- "):
        arr = []
        while i < len(lines) and lines[i][0] == indent and lines[i][1].startswith("- "):
            content = lines[i][1][2:].strip()
            if not content:
                i += 1
                if i < len(lines) and lines[i][0] > indent:
                    val, i = _parse_block(lines, i, lines[i][0])
                else:
                    val = None
                arr.append(val)
            elif _KV_LINE.match(content):
                key, _, rest = content.partition(":")
                item = {}
                key, rest = key.strip(), rest.strip()
                i += 1
                if rest:
                    item[key] = _scalar(rest)
                elif i < len(lines) and lines[i][0] > indent:
                    val, i = _parse_block(lines, i, lines[i][0])
                    item[key] = val
                else:
                    item[key] = None
                while (
                    i < len(lines)
                    and lines[i][0] > indent
                    and not lines[i][1].startswith("- ")
                ):
                    k, _, r = lines[i][1].partition(":")
                    k, r = k.strip(), r.strip()
                    i += 1
                    if r:
                        item[k] = _scalar(r)
                    elif i < len(lines) and lines[i][0] > indent:
                        val, i = _parse_block(lines, i, lines[i][0])
                        item[k] = val
                    else:
                        item[k] = None
                arr.append(item)
            else:
                arr.append(_scalar(content))
                i += 1
        return arr, i

    obj = {}
    while i < len(lines) and lines[i][0] == indent:
        content = lines[i][1]
        if content.startswith("- "):
            break
        k, sep, r = content.partition(":")
        if not sep:
            i += 1
            continue
        k, r = k.strip(), r.strip()
        i += 1
        if r:
            obj[k] = _scalar(r)
        elif i < len(lines) and lines[i][0] > indent:
            val, i = _parse_block(lines, i, lines[i][0])
            obj[k] = val
        else:
            obj[k] = None
    return obj, i


def mini_yaml_load(text: str):
    lines = []
    for raw in text.splitlines():
        stripped = _strip_comment(raw)
        if not stripped.strip() or stripped.strip() in ("---", "..."):
            continue
        indent = len(stripped) - len(stripped.lstrip(" "))
        lines.append((indent, stripped.strip()))
    if not lines:
        return None
    value, _ = _parse_block(lines, 0, lines[0][0])
    return value


def load_rules() -> dict:
    if not RULES_PATH.is_file():
        die(f"rules file not found: {RULES_PATH}")
    text = RULES_PATH.read_text(encoding="utf-8")
    force_mini = os.environ.get("KIMLOGPIPE_FORCE_MINI_YAML") == "1"
    data = None
    if not force_mini:
        try:
            import yaml  # type: ignore

            data = yaml.safe_load(text)
        except Exception:
            data = None
    if data is None:
        try:
            data = mini_yaml_load(text)
        except Exception as exc:  # pragma: no cover - fail-fast
            die(f"could not parse rules.yaml: {exc}")
    if not isinstance(data, dict) or not isinstance(data.get("rules"), list):
        die("invalid rules.yaml: the 'rules' key (a list) is required")
    names = set()
    for r in data["rules"]:
        if not isinstance(r, dict):
            die("invalid rules.yaml: every rule must be a map")
        for key in ("name", "type", "severity"):
            if not r.get(key):
                die(f"invalid rules.yaml: a rule is missing '{key}'")
        if r["name"] in names:
            die(f"invalid rules.yaml: duplicate rule name '{r['name']}'")
        names.add(r["name"])
    return data


# ---------------------------------------------------------------------------
# journald parser
# ---------------------------------------------------------------------------

J_SSH_FAIL = (
    "failed password",
    "failed publickey",
    "authentication failure",
    "too many authentication failures",
    "error: pam: authentication failure",
)


def _first(patterns, text):
    for pat in patterns:
        m = re.search(pat, text)
        if m:
            return m.group(1)
    return ""


def journald_user(msg: str) -> str:
    user = _first(
        [
            r"\bacct=\"?([^\s\",;]+)",
            r"\buser=([^\s,;]+)",
            r"\bfor (?:invalid )?user ([^\s(,;]+)",
            r"\bfor ([^\s(,;]+) from",
            r"\bInvalid user ([^\s,;]+)",
        ],
        msg,
    )
    return "" if user.lower() in PLACEHOLDERS else user


def _prefix_user(msg: str) -> str:
    """User from the 'sudo: root : ...' / 'root : ...' prefix."""
    m = re.match(r"^(?:sudo|su)(?:\[\d+\])?:\s+([A-Za-z0-9_.@-]+)\s*:", msg)
    if m:
        return m.group(1)
    m = re.match(r"^\s*([A-Za-z0-9_.@-]+)\s*:", msg)
    if m and m.group(1).lower() not in ("sudo", "su", "pam_unix"):
        return m.group(1)
    return ""


def journald_ip(msg: str) -> str:
    """Remote address from a log line.

    sshd uses more than one shape, so the patterns are ordered from the most
    specific to the most generic:

        Failed password for root from 203.0.113.9 port 41022 ssh2
        drop connection #0 from [10.0.2.2]:60362 on [10.0.2.15]:22 penalty:
        Connection closed by 10.0.2.2 port 60206 [preauth]
        Connection closed by authenticating user root 10.0.2.2 port 60316

    The last form is why the generic ``<ipv4> port <n>`` fallback exists: the
    words "authenticating user root" sit between "by" and the address.
    """
    ip = _first(
        [
            r"\bfrom \[?([0-9A-Fa-f:.]+)\]? port \d+",
            r"\bfrom \[([0-9A-Fa-f:.]+)\]:\d+",
            r"\bby \[?([0-9A-Fa-f:.]+)\]? port \d+",
            r"\brhost=([^\s;]+)",
            r"\baddr=([^\s;'\"]+)",
            r"([0-9]{1,3}(?:\.[0-9]{1,3}){3}) port \d+",
        ],
        msg,
    )
    return "" if ip.lower() in PLACEHOLDERS else ip


def classify_journald(rec: dict):
    """Return (action, outcome, user, src_ip) for one journald record."""
    msg = str(rec.get("MESSAGE", "") or "")
    ident = str(rec.get("SYSLOG_IDENTIFIER", "") or "")
    comm = str(rec.get("_COMM", "") or "")
    low = msg.lower()
    ident_l = ident.lower()
    comm_l = comm.lower()
    user = journald_user(msg)
    ip = journald_ip(msg)
    sshish = ident_l.startswith("sshd") or comm_l.startswith("sshd") or "sshd" in low

    if sshish:
        if "accepted " in low:
            return "ssh_login", "success", user, ip
        if "invalid user" in low:
            return "ssh_invalid_user", "failed", user, ip
        if any(k in low for k in J_SSH_FAIL):
            return "ssh_auth_failed", "failed", user, ip
        # PerSourcePenalties truncates the log: a failed attempt can show up
        # as "drop connection" or "Connection closed ... [preauth]".
        if "drop connection" in low or ("closed by" in low and "[preauth]" in low):
            return "ssh_drop", "failed", user, ip
        if "session opened" in low:
            return "ssh_session_open", "success", user, ip
        if "session closed" in low:
            return "ssh_session_close", "success", user, ip
        if (
            "server listening" in low
            or "starting openssh" in low
            or "started openssh" in low
        ):
            return "ssh_service", "success", user, ip

    sudoish = (
        ident_l == "sudo"
        or comm_l == "sudo"
        or "pam_unix(sudo:" in low
        or low.startswith("sudo:")
        or low.startswith("sudo[")
    )
    if sudoish:
        if not user:
            user = _prefix_user(msg)
        if any(
            k in low
            for k in (
                "authentication failure",
                "incorrect password",
                "not in sudoers",
                "failed",
                "error",
            )
        ):
            return "sudo_fail", "failed", user, ip
        return "sudo", "success" if "command=" in low else "unknown", user, ip

    suish = (
        ident_l == "su"
        or comm_l == "su"
        or "pam_unix(su:" in low
        or "failed su" in low
        or low.startswith("su:")
    )
    if suish:
        if not user:
            user = _prefix_user(msg)
        if any(
            k in low
            for k in ("authentication failure", "failed", "incorrect password")
        ):
            return "su_fail", "failed", user, ip
        return "su", "unknown", user, ip

    if "authentication failure" in low:
        return "auth_failed", "failed", user, ip
    return "log", "unknown", user, ip


def journald_ts(rec: dict):
    raw = rec.get("__REALTIME_TIMESTAMP") or rec.get("_SOURCE_REALTIME_TIMESTAMP")
    if raw is None:
        return None
    try:
        return int(raw) / 1_000_000.0
    except (TypeError, ValueError):
        return None


def parse_journald_line(rec: dict, raw_ref: str):
    """journald record -> uniform event, or (None, reason)."""
    if not isinstance(rec, dict):
        return None, "JSON is not an object"
    epoch = journald_ts(rec)
    if epoch is None:
        return None, "__REALTIME_TIMESTAMP missing or invalid"
    action, outcome, user, ip = classify_journald(rec)
    event = {
        "ts": iso_ts(epoch),
        "source": "journald",
        "host": str(rec.get("_HOSTNAME", "") or ""),
        "user": user,
        "src_ip": ip,
        "action": action,
        "outcome": outcome,
        "raw_ref": raw_ref,
        "path": "",
    }
    return event, None


# ---------------------------------------------------------------------------
# auditd parser
# ---------------------------------------------------------------------------

AUDIT_HDR = re.compile(
    r"^(?:node=(\S+)\s+)?type=([A-Z0-9_]+)\s+msg=audit\((\d+(?:\.\d+)?):(\d+)\):\s*(.*)$"
)
AUDIT_KV = re.compile(r"([A-Za-z_][\w-]*)=(\"(?:[^\"\\]|\\.)*\"|'[^']*'|\S+)")
AUDIT_INNER_TYPES = {
    "USER_AUTH",
    "USER_ACCT",
    "USER_LOGIN",
    "USER_START",
    "USER_END",
    "USER_CMD",
    "CRED_ACQ",
    "CRED_DISP",
    "SERVICE_START",
    "SERVICE_STOP",
}
SYSCALL_NAMES = {"59": "execve", "322": "execveat"}  # x86_64
AUDIT_PRIORITY = [
    "USER_AUTH",
    "USER_ACCT",
    "USER_LOGIN",
    "USER_START",
    "USER_END",
    "USER_CMD",
    "SERVICE_START",
    "SERVICE_STOP",
    "CRED_ACQ",
    "CRED_DISP",
    "SYSCALL",
    "EXECVE",
    "BPF",
    "PATH",
    "PROCTITLE",
]


def parse_kv(text: str) -> dict:
    out = {}
    for m in AUDIT_KV.finditer(text):
        val = m.group(2)
        if len(val) >= 2 and val[0] == val[-1] and val[0] in ("'", '"'):
            val = val[1:-1]
        out[m.group(1)] = val
    return out


def audit_epoch(sec: str) -> float:
    if "." in sec:
        whole, frac = sec.split(".", 1)
        return int(whole) + (int(frac) / (10 ** len(frac)))
    return float(sec)


def parse_audit_line(line: str):
    m = AUDIT_HDR.match(line)
    if not m:
        return None
    node, rtype, sec, serial, rest = m.groups()
    fields = parse_kv(rest)
    if node:
        fields.setdefault("node", node)
    inner = {}
    if rtype in AUDIT_INNER_TYPES and "msg" in fields:
        inner = parse_kv(fields["msg"])
    return {
        "type": rtype,
        "ts": audit_epoch(sec),
        "serial": serial,
        "fields": fields,
        "inner": inner,
        "line": line,
    }


def audit_user(recs) -> str:
    inner = {}
    for r in recs:
        inner.update(r["inner"])
    acct = inner.get("acct", "")
    if acct and acct.lower() not in PLACEHOLDERS:
        return acct
    for r in recs:
        for key in ("AUID", "UID"):
            val = r["fields"].get(key, "")
            if val and val.lower() not in PLACEHOLDERS:
                return val
    for r in recs:
        for key in ("auid", "uid"):
            val = r["fields"].get(key, "")
            if val and val.lower() not in PLACEHOLDERS:
                return val
    return ""


def audit_ip(recs) -> str:
    for r in recs:
        for key in ("addr", "hostname"):
            val = r["inner"].get(key, "")
            if val and val.lower() not in PLACEHOLDERS:
                return val
    return ""


def audit_outcome(recs) -> str:
    for r in recs:
        for key in ("res", "result", "success"):
            val = (r["inner"].get(key) or r["fields"].get(key) or "").lower()
            if val in ("success", "yes", "1"):
                return "success"
            if val in ("failed", "no", "0"):
                return "failed"
    return "unknown"


def pick_primary(recs):
    for rtype in AUDIT_PRIORITY:
        for r in recs:
            if r["type"] == rtype:
                return r
    return recs[0]


def audit_watch_key(recs) -> str:
    for r in recs:
        val = r["fields"].get("key", "")
        if val and val.lower() not in PLACEHOLDERS:
            return val
    return ""


def audit_path(recs) -> str:
    """Affected path, preferring the real target over a PARENT record.

    A watched write produces ``item=0 name=/etc/hosts nametype=CREATE`` and
    ``item=1 name=/etc/ nametype=PARENT``. Returning the parent directory would
    hide which file actually changed.
    """
    fallback = ""
    for r in recs:
        if r["type"] != "PATH":
            continue
        val = r["fields"].get("name", "")
        if not val or val.lower() in PLACEHOLDERS:
            continue
        if r["fields"].get("nametype", "").upper() == "PARENT":
            fallback = fallback or val
            continue
        return val
    if fallback:
        return fallback
    for r in recs:
        val = r["fields"].get("name", "")
        if val and val.lower() not in PLACEHOLDERS:
            return val
    return ""


def build_audit_event(recs, source_label: str):
    primary = pick_primary(recs)
    by_type = {}
    for r in recs:
        by_type.setdefault(r["type"], r)

    outcome = audit_outcome(recs)
    user = audit_user(recs)
    ip = audit_ip(recs)
    path = audit_path(recs)
    watch_key = audit_watch_key(recs)

    # Loading a watch rule (augenrules --load, auditctl -w) emits a
    # CONFIG_CHANGE record that carries the same key as the watch itself, plus
    # a SYSCALL and a PATH record with nametype=PARENT. That is rule
    # bookkeeping, not a file change, so it must not be reported as etc_change.
    if watch_key and "CONFIG_CHANGE" in by_type:
        action = "audit_rule_load"
    elif watch_key == ETC_WATCH_KEY and path:
        action = "etc_change"
    elif "USER_AUTH" in by_type:
        r = by_type["USER_AUTH"]
        exe = r["inner"].get("exe") or r["fields"].get("exe", "")
        base = os.path.basename(exe)
        if base == "sudo":
            action = "sudo_fail" if outcome == "failed" else "sudo"
        elif base == "su":
            action = "su_fail" if outcome == "failed" else "su"
        else:
            action = "user_auth"
    elif "USER_CMD" in by_type:
        r = by_type["USER_CMD"]
        exe = r["inner"].get("exe") or r["fields"].get("exe", "")
        action = "sudo_cmd" if os.path.basename(exe) == "sudo" else "user_cmd"
    elif "SYSCALL" in by_type or "EXECVE" in by_type:
        sc = by_type.get("SYSCALL")
        name = ""
        if sc:
            name = str(sc["fields"].get("SYSCALL", "")).lower()
            if not name:
                name = SYSCALL_NAMES.get(str(sc["fields"].get("syscall", "")), "")
        if name in ("execve", "execveat"):
            exe = ""
            if sc:
                exe = sc["fields"].get("exe", "")
            if not exe and "EXECVE" in by_type:
                exe = by_type["EXECVE"]["fields"].get("a0", "")
            base = os.path.basename(exe.strip("\"'")) or "unknown"
            action = f"execve:{base}"
        else:
            action = f"syscall:{name or 'unknown'}"
    else:
        action = recs[0]["type"].lower()

    return {
        "ts": iso_ts(primary["ts"]),
        "source": "auditd",
        "host": next(
            (
                r["fields"].get("node", "")
                for r in recs
                if r["fields"].get("node", "").lower() not in PLACEHOLDERS
            ),
            "",
        ),
        "user": user,
        "src_ip": ip,
        "action": action,
        "outcome": outcome,
        "raw_ref": f"{source_label}:{primary['lineno']}",
        "path": path,
    }


def parse_audit_file(path: Path):
    events, raw_map, invalid, lines_read = [], {}, 0, 0
    groups = {}  # serial -> list of records (insertion order preserved)
    try:
        fh = path.open("r", encoding="utf-8", errors="replace")
    except OSError as exc:
        die(f"cannot read {path}: {exc}")
    with fh:
        for lineno, raw in enumerate(fh, 1):
            lines_read += 1
            raw = raw.rstrip("\n")
            if not raw.strip():
                continue
            rec = parse_audit_line(raw)
            if rec is None:
                invalid += 1
                continue
            rec["lineno"] = lineno
            rec["raw"] = raw
            groups.setdefault(rec["serial"], []).append(rec)
    for _serial, recs in groups.items():
        primary = pick_primary(recs)
        event = build_audit_event(recs, str(path))
        events.append(event)
        raw_map[event["raw_ref"]] = primary["raw"]
    return events, raw_map, invalid, lines_read



def cmd_report(_args):
    events = load_events()
    fpath = findings_path()
    doc = None
    if fpath.is_file():
        try:
            doc = json.loads(fpath.read_text(encoding="utf-8"))
        except json.JSONDecodeError:
            doc = None

    log("=" * 62)
    log(f"KIMLOGPIPE v{VERSION} REPORT")
    log("=" * 62)
    log(f"Generated         : {now_iso()}")
    log(f"Store             : {data_dir()}")
    log(f"Events            : {len(events)}")
    if events:
        log(f"Latest event      : {max(e.get('ts', '') for e in events)}")
    log("")

    log("EVENTS BY SOURCE")
    if not events:
        log("  (no events; run `kimlogpipe ingest ...`)")
    else:
        counts = Counter(e.get("source", "") for e in events)
        for source, n in sorted(counts.items()):
            log(f"  {source or '(unknown)'}: {n}")
        log(f"  Total: {len(events)}")
    log("")

    log("FINDINGS BY RULE")
    if doc is None:
        log("  (no findings.json yet; run `kimlogpipe detect` first)")
    else:
        if doc.get("since"):
            log(f"  --since window: {doc['since']}")
        for r in doc.get("rules", []):
            status = r.get("status")
            if status == "found":
                log(
                    f"  {r['rule']} [{r.get('severity', '')}]: "
                    f"{len(r.get('findings', []))} finding(s)"
                )
                for f in r.get("findings", []):
                    log(
                        f"    - key={f.get('key') or '(none)'} "
                        f"count={f.get('count')} {f.get('first_ts')} .. {f.get('last_ts')}"
                    )
                    log(f"      {f.get('summary', '')}")
                    for ev in f.get("evidence", [])[:3]:
                        log(f"      > {ev.get('raw_ref')}")
            elif status == "no_match":
                log(f"  {r['rule']} [{r.get('severity', '')}]: no match")
                if r.get("reason"):
                    log(f"      reason: {r['reason']}")
            elif status == "disabled":
                log(f"  {r['rule']}: disabled")
            else:
                log(f"  {r['rule']} [{r.get('severity', '')}]: not evaluable")
                if r.get("reason"):
                    log(f"      reason: {r['reason']}")
    log("")

    findings = [] if doc is None else doc.get("findings", [])
    log("TOP KEYS (src_ip / user / path)")
    key_counts = Counter()
    for f in findings:
        key = f.get("key") or ""
        if key:
            key_counts[key] += int(f.get("count", 0) or 0)
    if key_counts:
        key, n = key_counts.most_common(1)[0]
        log(f"  {key} ({n} events in findings)")
    else:
        log("  no key (no findings)")
    log("")

    log("CAVEATS")
    log("  - journald is not persistent by default (Storage=volatile); old logs")
    log("    are lost after a reboot unless the journal is stored persistently.")
    log("  - sshd PerSourcePenalties can truncate the log; a failed attempt may")
    log("    appear as 'drop connection' instead of 'Invalid user'. Both signals")
    log("    are counted by ssh_bruteforce.")
    log("  - In a QEMU NAT guest every external source looks like 10.0.2.2, so the")
    log("    src_ip key cannot tell real hosts apart behind the NAT.")
    log("  - A rule without data is reported as 'not evaluable', never as 'no")
    log("    attack'. No finding is invented.")
    log("=" * 62)


def cmd_rules(_args):
    doc = load_rules()
    log(f"KIMLOGPIPE v{VERSION} RULES")

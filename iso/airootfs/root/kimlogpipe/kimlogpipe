def _count_newlines(path: Path) -> int:
    """Count newlines in chunks, without holding the file in memory."""
    total = 0
    try:
        with path.open("rb") as fh:
            while True:
                chunk = fh.read(1024 * 1024)
                if not chunk:
                    break
                total += chunk.count(b"\n")
    except OSError:
        return 0
    return total


def _count_lines(path: Path) -> int:
    if not path.is_file():
        return 0
    total = 0
    try:
        with path.open("rb") as fh:
            for line in fh:
                if line.strip():
                    total += 1
    except OSError:
        return 0
    return total


def tail_lines(path: Path, count: int):
    """Return the last `count` non-empty lines without reading the whole file."""
    if not path.is_file() or count <= 0:
        return []
    try:
        with path.open("rb") as fh:
            fh.seek(0, os.SEEK_END)
            size = fh.tell()
            block = 65536
            data = b""
            pos = size
            while pos > 0 and data.count(b"\n") <= count:
                step = min(block, pos)
                pos -= step
                fh.seek(pos)
                data = fh.read(step) + data
        lines = data.splitlines()[-count:]
        return [ln.decode("utf-8", "replace") for ln in lines if ln.strip()]
    except OSError:
        return []


def load_events():
    path = events_path()
    if not path.is_file():
        return []
    out = []
    with path.open("r", encoding="utf-8", errors="replace") as fh:
        for line in fh:
            line = line.strip()
            if not line:
                continue
            try:
                obj = json.loads(line)
            except json.JSONDecodeError:
                continue
            if isinstance(obj, dict):
                out.append(obj)
    return out


def load_events_tail(count: int):
    out = []
    for line in tail_lines(events_path(), count):
        try:
            obj = json.loads(line)
        except json.JSONDecodeError:
            continue
        if isinstance(obj, dict):
            out.append(obj)
    return out


def load_raw_map() -> dict:
    path = raw_path()
    out = {}
    if not path.is_file():
        return out
    with path.open("r", encoding="utf-8", errors="replace") as fh:
        for line in fh:
            try:
                obj = json.loads(line)
            except json.JSONDecodeError:
                continue
            if isinstance(obj, dict) and "raw_ref" in obj:
                out[obj["raw_ref"]] = obj.get("line", "")
    return out


def atomic_write(path: Path, text: str) -> None:
    tmp = path.with_name(f".{path.name}.tmp.{os.getpid()}")
    with tmp.open("w", encoding="utf-8") as fh:
        fh.write(text)
        fh.flush()
        os.fsync(fh.fileno())
    os.chmod(tmp, 0o600)          # evidence holds raw log lines and secrets
    os.replace(tmp, path)


def _rotate_if_big(path: Path, limit: int = EVENT_ROTATE_BYTES) -> None:
    try:
        if path.is_file() and path.stat().st_size > limit:
            os.replace(path, path.with_name(path.name + ".1"))
    except OSError:
        pass


def store_events(new_events, new_raw) -> tuple:
    """Add new events, dedupe by ts+source+action+raw_ref (one-shot ingest)."""
    existing = load_events()
    seen = {
        (e.get("ts"), e.get("source"), e.get("action"), e.get("raw_ref"))
        for e in existing
    }
    added = 0
    for ev in new_events:
        key = (ev["ts"], ev["source"], ev["action"], ev["raw_ref"])
        if key in seen:
            continue
        seen.add(key)
        existing.append(ev)
        added += 1
    dupes = len(new_events) - added
    lines = "".join(
        json.dumps(e, ensure_ascii=False, separators=(",", ":")) + "\n"
        for e in existing
    )
    atomic_write(events_path(), lines)

    raw_map = load_raw_map()
    changed = False
    for ref, line in new_raw.items():
        if ref not in raw_map:
            raw_map[ref] = line
            changed = True
    if changed:
        raw_text = "".join(
            json.dumps({"raw_ref": k, "line": v}, ensure_ascii=False) + "\n"
            for k, v in raw_map.items()
        )
        atomic_write(raw_path(), raw_text)
    return added, dupes


def append_events(events, raw_pairs) -> None:
    """Append events and their raw evidence (live mode, no rewrite)."""
    if not events and not raw_pairs:
        return
    _rotate_if_big(events_path())
    _rotate_if_big(raw_path())
    if events:
        with events_path().open("a", encoding="utf-8") as fh:
            os.chmod(fh.name, 0o600)   # raw log lines live in the sibling file
            for ev in events:
                fh.write(json.dumps(ev, ensure_ascii=False, separators=(",", ":")) + "\n")
            fh.flush()
            os.fsync(fh.fileno())
    if raw_pairs:
        with raw_path().open("a", encoding="utf-8") as fh:
            os.chmod(fh.name, 0o600)   # full log lines: commands, paths, users
            for ref, line in raw_pairs:
                fh.write(
                    json.dumps({"raw_ref": ref, "line": line}, ensure_ascii=False) + "\n"
                )
            fh.flush()
            os.fsync(fh.fileno())


def load_state() -> dict:
    path = state_path()
    if not path.is_file():
        return {}
    try:
        data = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError):
        return {}
    return data if isinstance(data, dict) else {}


def save_state(state: dict) -> None:
    state["updated_at"] = now_iso()
    try:
        atomic_write(state_path(), json.dumps(state, ensure_ascii=False, indent=2) + "\n")
    except OSError:
        pass



def _rules_path() -> Path:
    """Find rules.yaml: explicit env, next to the script, then the install path."""
    override = os.environ.get("KIMLOGPIPE_RULES", "").strip()
    if override:
        return Path(override)
    for candidate in (
        SCRIPT_DIR / "rules.yaml",
        Path("/usr/local/share/kimlogpipe/rules.yaml"),
        Path("/etc/kimlogpipe/rules.yaml"),
    ):
        if candidate.is_file():
            return candidate
    return SCRIPT_DIR / "rules.yaml"



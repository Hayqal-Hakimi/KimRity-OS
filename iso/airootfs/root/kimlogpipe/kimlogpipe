def cmd_status(_args):
    state = load_state()
    stats = state.get("stats") or {}
    log(f"KIMLOGPIPE v{VERSION} STATUS")
    log("")
    log(f"Store             : {data_dir()}")
    log(f"Events in store   : {_count_lines(events_path())}")
    log(f"Findings recorded : {_count_lines(findings_log_path())}")
    if stats:
        log(f"Last live run     : {stats.get('started_at', '?')}")
        if stats.get("stopped_at"):
            log(f"Stopped at        : {stats['stopped_at']}")
        log(f"Live events       : {stats.get('events', 0)}")
        log(f"Live findings     : {stats.get('findings', 0)}")
        log(f"Last event        : {stats.get('last_event_ts') or '(none)'}")
        kimai = stats.get("kimai")
        kimai_label = "ok" if kimai else ("down" if kimai is False else "untried")
        log(f"KimAI             : {kimai_label} {stats.get('kimai_detail', '')}".rstrip())
        log(f"Audit log         : {'readable' if stats.get('audit_readable') else 'unreadable'}")
        log(f"Sources           : {', '.join(stats.get('sources') or [])}")
    else:
        log("Last live run     : (no state.json; `kimlogpipe follow` has not run)")
    path = kimai_socket_path()
    log(f"KimAI socket      : {path} ({'present' if path.exists() else 'missing'})")
    alerts = state.get("alerts") or {}
    log(f"Alert cooldowns   : {len(alerts)} key(s)")
    log(f"Last state update : {state.get('updated_at', '(never)')}")



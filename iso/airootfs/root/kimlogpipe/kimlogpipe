class JournaldFollower(threading.Thread):
    """Read `journalctl -f -o json` in a thread and push lines to a queue."""

    def __init__(self, cursor, out_queue):
        super().__init__(daemon=True)
        self.cursor = cursor or ""
        self.out = out_queue
        self.proc = None

    def run(self):
        cmd = ["journalctl", "-f", "-o", "json", "--no-pager"]
        if self.cursor:
            cmd += ["--after-cursor", self.cursor]
        else:
            cmd += ["-n", "0"]
        try:
            self.proc = subprocess.Popen(
                cmd,
                stdout=subprocess.PIPE,
                stderr=subprocess.PIPE,
                text=True,
                bufsize=1,
            )
        except FileNotFoundError:
            self.out.put(("error", "journalctl not found (systemd only)"))
            return
        except OSError as exc:
            self.out.put(("error", f"journalctl failed to start: {exc}"))
            return
        assert self.proc.stdout is not None
        # journalctl reports errors on stderr. With stderr=PIPE and nobody
        # reading it, a burst of errors fills the ~64 KiB pipe buffer, journalctl
        # blocks, and stdout stops too: the follower looks alive while ingesting
        # nothing (Build 16 audit).
        self._stderr_tail = []
        threading.Thread(target=self._drain_stderr, daemon=True).start()
        for line in self.proc.stdout:
            line = line.strip()
            if line:
                self.out.put(("line", line))
        detail = "\n".join(self._stderr_tail).strip()
        self.out.put(("error", detail or "journalctl exited"))

    def _drain_stderr(self) -> None:
        if self.proc is None or self.proc.stderr is None:
            return
        try:
            for line in self.proc.stderr:
                self._stderr_tail.append(line.rstrip())
                del self._stderr_tail[:-50]
        except (ValueError, OSError):
            pass

    def stop(self):
        if self.proc and self.proc.poll() is None:
            try:
                self.proc.terminate()
                self.proc.wait(timeout=3)
            except (OSError, subprocess.TimeoutExpired):
                try:
                    self.proc.kill()
                except OSError:
                    pass


class AuditTailer:
    """Read new lines from the audit log and survive rotation."""

    def __init__(self, path, offset=0, inode=0, lineno=0):
        self.path = Path(path)
        self.offset = int(offset or 0)
        self.inode = int(inode or 0)
        self.lineno = int(lineno or 0)

    def seek_end(self):
        """Start at the current end of the log (no backfill).

        Used on the very first run so a fresh monitor does not raise alerts for
        changes that happened before it was installed - the same rule the
        journald follower uses with ``-n 0``.
        """
        if not self.path.is_file():
            return False
        try:
            st = self.path.stat()
            with self.path.open("rb") as fh:
                fh.seek(0, os.SEEK_END)
                self.offset = fh.tell()
            self.inode = st.st_ino
            self.lineno = _count_newlines(self.path)
        except OSError:
            return False
        return True

    def poll(self):
        if not self.path.is_file():
            return []
        try:
            st = self.path.stat()
        except OSError:
            return []
        if self.inode and (st.st_ino != self.inode or st.st_size < self.offset):
            self.offset = 0
            self.lineno = 0
        self.inode = st.st_ino
        if st.st_size == self.offset:
            return []
        out = []
        try:
            with self.path.open("r", encoding="utf-8", errors="replace") as fh:
                fh.seek(self.offset)
                while True:
                    raw = fh.readline()
                    if not raw:
                        break
                    if not raw.endswith("\n"):
                        break  # partial line: wait for the writer to finish
                    # readline() keeps tell() usable; iterating the file does not.
                    self.offset = fh.tell()
                    self.lineno += 1
                    out.append((self.lineno, raw.rstrip("\n")))
        except OSError:
            return []
        return out


class AuditBuilder:
    """Group consecutive audit records that share a serial number."""

    def __init__(self, source_label):
        self.source_label = source_label
        self.serial = None
        self.recs = []
        self.started = 0.0
        self.counters = Counter()

    def add(self, lineno, raw):
        rec = parse_audit_line(raw)
        if rec is None:
            self.counters["invalid"] += 1
            return []
        rec["lineno"] = lineno
        rec["raw"] = raw
        done = []
        if self.serial is not None and rec["serial"] != self.serial:
            done = self.flush()
        self.serial = rec["serial"]
        self.recs.append(rec)
        self.started = time.monotonic()
        return done

    def flush(self):
        if not self.recs:
            return []
        recs = self.recs
        self.recs = []
        self.serial = None
        event = build_audit_event(recs, self.source_label)
        primary = pick_primary(recs)
        return [(event, primary["raw"])]

    def tick(self, timeout=1.0):
        if self.recs and time.monotonic() - self.started > timeout:
            return self.flush()
        return []


class FollowEngine:
    def __init__(self, rules_doc, sources, use_kimai=True):
        self.rules = rules_doc["rules"]
        self.sources = sources
        self.use_kimai = use_kimai
        self.ring = deque(load_events_tail(RING_SIZE), maxlen=RING_SIZE)
        self.raw_map = load_raw_map()
        self.state = load_state()
        self.alerts = dict(self.state.get("alerts") or {})
        self.cooldowns = {
            r["name"]: int(
                r.get("cooldown_seconds")
                or r.get("window_seconds")
                or DEFAULT_COOLDOWN
            )
            for r in self.rules
        }
        self.stop = threading.Event()
        self.started_at = now_iso()
        self.counters = Counter()
        self.total_events = _count_lines(events_path())
        self.total_findings = _count_lines(findings_log_path())
        self.last_event_ts = self.ring[-1]["ts"] if self.ring else ""
        self.kimai_state = None  # None = unknown, True/False = last result
        self.kimai_detail = ""
        self.journald_queue = queue.Queue()
        self.journald = None
        self.follower_failed = False
        self.audit = None
        self.audit_builder = AuditBuilder(AUDIT_LOG)
        self.audit_readable = True
        self.last_heartbeat = time.monotonic()
        self.dirty_state = False
        self.results = []
        self._restore_offsets()

    def _restore_offsets(self):
        j = self.state.get("journald") or {}
        a = self.state.get("audit") or {}
        if "journald" in self.sources:
            self.journald = JournaldFollower(
                j.get("cursor", ""), self.journald_queue
            )
        if "auditd" in self.sources:
            self.audit = AuditTailer(
                AUDIT_LOG,
                offset=a.get("offset", 0),
                inode=a.get("inode", 0),
                lineno=a.get("lineno", 0),
            )
            if not a and self.audit.seek_end():
                self.state["audit"] = {
                    "offset": self.audit.offset,
                    "inode": self.audit.inode,
                    "lineno": self.audit.lineno,
                }
                self.dirty_state = True
                log(
                    f"First run: starting at the end of {AUDIT_LOG} "
                    "(history is not replayed)."
                )

    # -- event collection ---------------------------------------------------

    def _drain_journald(self):
        events, raw_pairs = [], []
        while True:
            try:
                kind, payload = self.journald_queue.get_nowait()
            except queue.Empty:
                break
            if kind == "error":
                log(f"journald follower stopped: {payload}")
                # Exit non-zero: the unit is Restart=on-failure, so dying must
                # not look like a clean shutdown (Build 16 audit).
                self.follower_failed = True
                self.stop.set()
                return events, raw_pairs
            try:
                rec = json.loads(payload)
            except json.JSONDecodeError:
                self.counters["invalid_journald"] += 1
                continue
            cursor = str(rec.get("__CURSOR", "") or "")
            if not cursor:
                cursor = "journalctl:seq=" + str(rec.get("__SEQNUM", "?"))
            event, _reason = parse_journald_line(rec, cursor)
            if event is None:
                self.counters["invalid_journald"] += 1
                continue
            events.append(event)
            raw_pairs.append((cursor, payload))
            if cursor:
                self.state.setdefault("journald", {})["cursor"] = cursor
                self.dirty_state = True
        return events, raw_pairs

    def _drain_audit(self):
        if self.audit is None:
            return [], []
        events, raw_pairs = [], []
        try:
            new_lines = self.audit.poll()
        except OSError:
            self.audit_readable = False
            return [], []
        for lineno, raw in new_lines:
            for event, raw_line in self.audit_builder.add(lineno, raw):
                events.append(event)
                raw_pairs.append((event["raw_ref"], raw_line))
        for event, raw_line in self.audit_builder.tick():
            events.append(event)
            raw_pairs.append((event["raw_ref"], raw_line))
        if new_lines:
            self.state["audit"] = {
                "offset": self.audit.offset,
                "inode": self.audit.inode,
                "lineno": self.audit.lineno,
            }
            self.dirty_state = True
        return events, raw_pairs

    # -- findings -----------------------------------------------------------

    def _prune_alerts(self):
        if len(self.alerts) <= ALERT_STATE_LIMIT:
            return
        ordered = sorted(
            self.alerts.items(),
            key=lambda kv: kv[1].get("last_ts", ""),
            reverse=True,
        )
        self.alerts = dict(ordered[:ALERT_STATE_LIMIT])

    def _prune_raw_map(self):
        """Keep evidence only for events still in the ring."""
        live = {ev.get("raw_ref", "") for ev in self.ring}
        self.raw_map = {k: v for k, v in self.raw_map.items() if k in live}

    def _new_findings(self, flat):
        now = time.time()
        fresh = []
        for f in flat:
            key = f["rule"] + "|" + (f.get("key") or "")
            prev = self.alerts.get(key)
            cooldown = self.cooldowns.get(f["rule"], DEFAULT_COOLDOWN)
            if prev is None:
                fresh.append(f)
            elif (
                f["last_ts"] > prev.get("last_ts", "")
                and now - float(prev.get("alerted_at", 0)) >= cooldown
            ):
                fresh.append(f)
            if prev is None or f in fresh:
                self.alerts[key] = {
                    "alerted_at": now,
                    "count": f["count"],
                    "last_ts": f["last_ts"],
                    "severity": f["severity"],
                }
                self.dirty_state = True
        return fresh

    def _emit(self, fresh):
        if not fresh:
            return
        self.total_findings += len(fresh)
        with findings_log_path().open("a", encoding="utf-8") as fh:
            for f in fresh:
                row = dict(f)
                row["emitted_at"] = now_iso()
                fh.write(json.dumps(row, ensure_ascii=False) + "\n")
        doc = {
            "generated_at": now_iso(),
            "since": None,
            "event_count": len(self.ring),
            "rules": self.results,
            "findings": [f for f in self._flat_current()],
        }
        try:
            atomic_write(
                findings_path(), json.dumps(doc, ensure_ascii=False, indent=2) + "\n"
            )
        except OSError:
            pass
        for f in fresh:
            log(
                f"FINDING [{f['severity']}] {f['rule']} key={f['key'] or '(none)'} "
                f"count={f['count']} :: {f['summary']}"
            )
            self.counters["findings"] += 1
            if not self.use_kimai:
                continue
            ok, detail = kimai_emit(
                kind=f["rule"],
                severity=f["severity"],
                summary=f["summary"],
                data={
                    "rule": f["rule"],
                    "key": f["key"],
                    "count": f["count"],
                    "first_ts": f["first_ts"],
                    "last_ts": f["last_ts"],
                    "evidence": [
                        {"raw_ref": e["raw_ref"], "line": e["line"][:300]}
                        for e in f.get("evidence", [])[:3]
                    ],
                },
            )
            self.kimai_detail = detail
            if ok:
                if self.kimai_state is not True:
                    log(f"KimAI accepted the event ({detail}); broker reachable again.")
                self.kimai_state = True
            else:
                if self.kimai_state is not False:
                    log(
                        f"KimAI unavailable ({detail}); continuing in tools-only mode."
                    )
                self.kimai_state = False

    def _flat_current(self):
        flat = []
        for r in self.results:
            flat.extend(r.get("findings", []))
        return flat

    def _audit_readable_now(self):
        """True when the audit log can actually be opened by this user.

        ``is_file()`` is not enough: /var/log/audit is 0750, so a user who is
        not in the log group sees EACCES on the directory, not on the file.
        """
        try:
            with open(AUDIT_LOG, "rb"):
                return True
        except OSError:
            return False

    def _refresh_audit_state(self):
        """Re-check readability so a permission fix or log rotation recovers.

        Without this the pipeline would stay "unreadable" until a restart,
        which is how a real deployment loses etc_watch silently.
        """
        if self.audit is None:
            return
        readable = self._audit_readable_now()
        if readable == self.audit_readable:
            return
        self.audit_readable = readable
        self.dirty_state = True
        if readable:
            log(f"audit log {AUDIT_LOG} is readable again; tailing it now.")
        else:
            log(
                f"audit log {AUDIT_LOG} is no longer readable; "
                "continuing with journald only (etc_watch not evaluable)."
            )

    # -- main loop ----------------------------------------------------------

    def run(self):
        if self.journald is not None:
            self.journald.start()
        log(
            f"KimLogPipe {VERSION} following {', '.join(self.sources)} "
            f"(store {data_dir()})"
        )
        log(
            f"Loaded {len(self.ring)} recent event(s); "
            f"{self.total_events} in store, {self.total_findings} finding(s) recorded."
        )
        if self.audit is not None and not self._audit_readable_now():
            self.audit_readable = False
            log(
                f"audit log {AUDIT_LOG} is not readable; "
                "continuing with journald only (tools-only for etc_watch)."
            )

        while not self.stop.is_set():
            self._refresh_audit_state()
            events, raw_pairs = self._drain_journald()
            audit_events, audit_raw = self._drain_audit()
            events.extend(audit_events)
            raw_pairs.extend(audit_raw)

            if events:
                append_events(events, raw_pairs)
                raw_lookup = dict(raw_pairs)
                for ev in events:
                    self.ring.append(ev)
                    line = raw_lookup.get(ev["raw_ref"], "")
                    if line:
                        self.raw_map[ev["raw_ref"]] = line
                self.total_events += len(events)
                self.last_event_ts = events[-1]["ts"]

            if events:
                self.results, flat = evaluate(
                    self.rules, list(self.ring), self.raw_map
                )
                fresh = self._new_findings(flat)
                self._emit(fresh)

            now_mono = time.monotonic()
            if now_mono - self.last_heartbeat >= 60:
                self.last_heartbeat = now_mono
                kimai_label = (
                    "ok"
                    if self.kimai_state
                    else ("down" if self.kimai_state is False else "untried")
                )
                log(
                    f"heartbeat events={self.total_events} "
                    f"findings={self.total_findings} queue={len(self.ring)} "
                    f"kimai={kimai_label} audit="
                    f"{'ok' if self.audit_readable else 'unreadable'}"
                )
                self._prune_alerts()
                self._prune_raw_map()
                self.dirty_state = True

            if self.dirty_state:
                self.state["alerts"] = self.alerts
                self.state["stats"] = {
                    "events": self.total_events,
                    "findings": self.total_findings,
                    "last_event_ts": self.last_event_ts,
                    "kimai": self.kimai_state,
                    "kimai_detail": self.kimai_detail,
                    "audit_readable": self.audit_readable,
                    "started_at": self.started_at,
                    "sources": self.sources,
                }
                save_state(self.state)
                self.dirty_state = False

            time.sleep(min(FLUSH_SECONDS, 1.0))

        return self.shutdown()

    def shutdown(self):
        log("Stopping KimLogPipe.")
        if self.journald is not None:
            self.journald.stop()
        if self.audit is not None:
            for event, raw_line in self.audit_builder.flush():
                append_events([event], [(event["raw_ref"], raw_line)])
            self.state["audit"] = {
                "offset": self.audit.offset,
                "inode": self.audit.inode,
                "lineno": self.audit.lineno,
            }
        self.state["alerts"] = self.alerts
        self.state["stats"] = {
            "events": self.total_events,
            "findings": self.total_findings,
            "last_event_ts": self.last_event_ts,
            "kimai": self.kimai_state,
            "kimai_detail": self.kimai_detail,
            "audit_readable": self.audit_readable,
            "started_at": self.started_at,
            "stopped_at": now_iso(),
            "sources": self.sources,
        }
        save_state(self.state)
        return 1 if self.follower_failed else 0


def cmd_follow(args):
    rules_doc = load_rules()
    sources = ["journald", "auditd"] if args.source == "both" else [args.source]
    use_kimai = not args.no_kimai and os.environ.get("KIMLOGPIPE_KIMAI", "1") != "0"
    engine = FollowEngine(rules_doc, sources, use_kimai=use_kimai)

    def _handle(_signum, _frame):
        engine.stop.set()

    signal.signal(signal.SIGTERM, _handle)
    signal.signal(signal.SIGINT, _handle)
    return engine.run()



def build_parser():
    p = argparse.ArgumentParser(
        prog="kimlogpipe",
        description="Normalize system logs and run threshold rules (v2).",
    )
    p.add_argument("--version", action="version", version=f"KimLogPipe {VERSION}")
    sub = p.add_subparsers(dest="command", required=True)

    ing = sub.add_parser("ingest", help="ingest logs into events.jsonl (one-shot)")
    ing.add_argument("--source", required=True, choices=["journald", "auditd"])
    ing.add_argument("--file", help="fixture file; without it the live snapshot is used")
    ing.set_defaults(func=cmd_ingest)

    fol = sub.add_parser("follow", help="follow live logs and push findings to KimAI")
    fol.add_argument(
        "--source",
        default="both",
        choices=["both", "journald", "auditd"],
        help="which sources to follow (default: both)",
    )
    fol.add_argument(
        "--no-kimai",
        action="store_true",
        help="do not push findings to KimAI (tools-only)",
    )
    fol.set_defaults(func=cmd_follow)

    rl = sub.add_parser("rules", help="list rules and thresholds")
    rl.set_defaults(func=cmd_rules)

    det = sub.add_parser("detect", help="run all rules over the store")
    det.add_argument("--since", help="time window, e.g. 5m, 2h, 1d")
    det.set_defaults(func=cmd_detect)

    rep = sub.add_parser("report", help="human-readable report")
    rep.set_defaults(func=cmd_report)

    st = sub.add_parser("status", help="show live state and store counters")
    st.set_defaults(func=cmd_status)
    return p


def main(argv=None):
    args = build_parser().parse_args(argv)
    return args.func(args) or 0


if __name__ == "__main__":
    if hasattr(signal, "SIGPIPE"):
        signal.signal(signal.SIGPIPE, signal.SIG_DFL)
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        print("\nStopped.", file=sys.stderr, flush=True)
        sys.exit(130)

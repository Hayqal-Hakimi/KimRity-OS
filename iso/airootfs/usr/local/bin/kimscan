#!/usr/bin/env python3
"""KimScanning v1 — terminal wrapper around gate/gate.py.

KimScanning does not make its own security decisions. It runs the
KimRity Security Gate, stores every scan as a session object, explains
findings in English from a static dictionary (no AI), and keeps finding
statuses consistent across repeated scans.
"""

from __future__ import annotations

import argparse
import datetime
import getpass
import hashlib
import json
import os
import shutil
import subprocess
import sys
import tempfile
import time

SCRIPT_DIR = os.path.dirname(os.path.realpath(__file__))

def _first_existing(paths):
    for p in paths:
        if p and os.path.exists(p):
            return p
    return paths[0]

# gate.py: env → <script>/../gate/gate.py (repo) → /usr/local/gate/gate.py → kimrity-gate binary in PATH
_gate_candidates = [
    os.environ.get("KIMSCAN_GATE"),
    os.path.normpath(os.path.join(SCRIPT_DIR, "..", "gate", "gate.py")),
    "/usr/local/gate/gate.py",
    shutil.which("kimrity-gate"),
]
GATE = _first_existing([p for p in _gate_candidates if p])

# rule dictionary: env → <script>/rules/en.yaml → /usr/local/share/kimscanning/rules/en.yaml → ~/.config/kimscanning/rules/en.yaml
RULES_PATH = _first_existing([
    os.environ.get("KIMSCAN_RULES"),
    os.path.join(SCRIPT_DIR, "rules", "en.yaml"),
    "/usr/local/share/kimscanning/rules/en.yaml",
    "/usr/share/kimscanning/rules/en.yaml",
    os.path.expanduser("~/.config/kimscanning/rules/en.yaml"),
])

TOOLS = [
    "gitleaks", "semgrep", "trivy", "nuclei", "nikto", "nmap", "ssh-audit",
    "clamscan", "yara", "file", "sha256sum",
]
EXPECTED = {
    "repo": ["gitleaks", "semgrep", "trivy"],
    "web": ["nuclei", "nikto"],
    "server": ["nmap", "ssh-audit"],
    "file": ["gitleaks", "semgrep", "trivy", "clamscan", "yara", "file", "sha256sum"],
    "installer": ["gitleaks", "semgrep", "trivy", "clamscan", "yara", "file", "sha256sum"],
}
VERSION_ARGS = {
    "gitleaks": ["gitleaks", "version"],
    "semgrep": ["semgrep", "--version"],
    "trivy": ["trivy", "--version"],
    "nuclei": ["nuclei", "-version"],
    "nikto": ["nikto", "-Version"],
    "nmap": ["nmap", "--version"],
    "ssh-audit": ["ssh-audit", "--version"],
    "clamscan": ["clamscan", "--version"],
    "yara": ["yara", "--version"],
    "file": ["file", "--version"],
    "sha256sum": ["sha256sum", "--version"],
}
STATUSES = ("new", "accepted", "fixed")
SEV_ORDER = ["critical", "high", "medium", "low", "info", "unknown"]
SEV_RANK = {s: i for i, s in enumerate(SEV_ORDER)}


def display_order(session: dict) -> list:
    """Order of findings as displayed, i.e. numbered order 1..N.

    Used by printing and by `kimscan status <id> <number>` so that the number
    shown to the user always refers to the same finding.
    """
    findings = session.get("findings", []) or []
    grouped = {}
    for f in findings:
        grouped.setdefault(str(f.get("file") or "?"), []).append(f)
    ordered = []
    for file in sorted(grouped):
        ordered.extend(
            sorted(
                grouped[file],
                key=lambda x: (
                    SEV_RANK.get(str(x.get("severity", "unknown")).lower(), 99),
                    str(x.get("tool", "")),
                    int(x.get("line") or 0),
                    str(x.get("rule", "")),
                ),
            )
        )
    return ordered

VERDICT_EXIT = {"PASS": 0, "CONDITIONAL": 2, "FAIL": 3}
GATE_VERDICT = {
    "PASS": "PASS",
    "CONDITIONAL": "CONDITIONAL",
    "FAIL": "FAIL",
}


# ------------------------------------------------------------- utilities

def now_iso() -> str:
    return (
        datetime.datetime.now(datetime.timezone.utc)
        .replace(microsecond=0)
        .isoformat()
        .replace("+00:00", "Z")
    )


def session_stamp() -> str:
    return datetime.datetime.now(datetime.timezone.utc).strftime("%Y%m%dT%H%M%SZ")


def data_root() -> str:
    xdg = os.environ.get("XDG_DATA_HOME")
    if xdg:
        return os.path.join(xdg, "kimscanning")
    return os.path.expanduser("~/.local/share/kimscanning")


def sessions_root() -> str:
    return os.path.join(data_root(), "sessions")


def ledger_path() -> str:
    return os.path.join(data_root(), "status.json")


def write_json(path: str, obj) -> None:
    os.makedirs(os.path.dirname(path), exist_ok=True)
    tmp = path + ".tmp"
    with open(tmp, "w", encoding="utf-8") as fh:
        json.dump(obj, fh, ensure_ascii=False, indent=2)
        fh.write("\n")
    os.replace(tmp, path)


def read_json(path: str):
    try:
        with open(path, encoding="utf-8") as fh:
            return json.load(fh)
    except (OSError, json.JSONDecodeError):
        return None


def new_session_id() -> str:
    while True:
        sid = session_stamp()
        if not os.path.exists(os.path.join(sessions_root(), sid)):
            return sid
        time.sleep(1)


def all_sessions() -> list:
    root = sessions_root()
    if not os.path.isdir(root):
        return []
    out = []
    for sid in sorted(os.listdir(root)):
        session = read_json(os.path.join(root, sid, "session.json"))
        if isinstance(session, dict):
            out.append(session)
    return out


def find_session(arg: str):
    """Find a session by full id or a unique prefix."""
    root = sessions_root()
    if not os.path.isdir(root):
        return None, "No sessions stored."
    ids = sorted(
        d for d in os.listdir(root)
        if os.path.isfile(os.path.join(root, d, "session.json"))
    )
    if arg in ids:
        session = read_json(os.path.join(root, arg, "session.json"))
        if isinstance(session, dict):
            return session, None
        return None, f"Session '{arg}' is invalid or corrupted."
    matches = [d for d in ids if d.startswith(arg)]
    if len(matches) == 1:
        session = read_json(os.path.join(root, matches[0], "session.json"))
        if isinstance(session, dict):
            return session, None
        return None, f"Session '{matches[0]}' is invalid or corrupted."
    if len(matches) > 1:
        return None, f"Prefix '{arg}' is not unique: {', '.join(matches)}. Use the full id."
    return None, f"Session '{arg}' not found."


def session_path(sid: str) -> str:
    return os.path.join(sessions_root(), sid, "session.json")


def tool_version(name: str) -> str:
    exe = shutil.which(name)
    if not exe:
        return ""
    try:
        p = subprocess.run(
            VERSION_ARGS[name], capture_output=True, text=True, timeout=15
        )
        text = ((p.stdout or "") + "\n" + (p.stderr or "")).strip()
        for line in text.splitlines():
            line = line.strip()
            if line:
                return line[:80]
    except (OSError, subprocess.TimeoutExpired, KeyError):
        pass
    return "?"


def load_rules() -> dict:
    """Read rules/en.yaml. PyYAML is used if available; otherwise a small
    built-in fallback parser keeps kimscan free of external packages."""
    entries = None
    try:
        import yaml  # type: ignore
        with open(RULES_PATH, encoding="utf-8") as fh:
            entries = yaml.safe_load(fh)
    except ImportError:
        entries = parse_yaml_fallback()
    except Exception as exc:  # broken YAML / missing file
        print(f"warning: cannot read rule dictionary: {exc}", file=sys.stderr)
        return {}
    rules = {}
    for item in entries or []:
        if not isinstance(item, dict):
            continue
        tool = str(item.get("tool", "")).strip()
        rule = str(item.get("rule", "")).strip()
        if not tool or not rule:
            continue
        rules[f"{tool}|{rule}"] = {
            "what": str(item.get("what", "")).strip(),
            "why": str(item.get("why", "")).strip(),
            "fix": str(item.get("fix", "")).strip(),
        }
    return rules


def parse_yaml_fallback():
    """Parser for the flat list shape used by en.yaml."""
    try:
        with open(RULES_PATH, encoding="utf-8") as fh:
            lines = fh.readlines()
    except OSError:
        return []
    entries, cur = [], None
    for raw in lines:
        line = raw.rstrip("\n")
        stripped = line.strip()
        if not stripped or stripped.startswith("#"):
            continue
        if stripped.startswith("- "):
            if cur is not None:
                entries.append(cur)
            cur = {}
            stripped = stripped[2:].strip()
        if cur is None or ":" not in stripped:
            continue
        key, _, val = stripped.partition(":")
        val = val.strip()
        if len(val) >= 2 and val[0] == '"' and val[-1] == '"':
            try:
                val = json.loads(val)
            except json.JSONDecodeError:
                val = val[1:-1]
        elif len(val) >= 2 and val[0] == "'" and val[-1] == "'":
            val = val[1:-1].replace("''", "'")
        cur[key.strip()] = val
    if cur is not None:
        entries.append(cur)
    return entries


def load_ledger() -> dict:
    data = read_json(ledger_path())
    return data if isinstance(data, dict) else {}


def save_ledger(ledger: dict) -> None:
    write_json(ledger_path(), ledger)


def ledger_key(kind: str, target: str, fp: str) -> str:
    return f"{kind}|{target}|{fp}"


# --------------------------------------------------------------- report

def print_session(session: dict) -> None:
    verdict = session.get("verdict", "?")
    counts = session.get("counts", {})
    print("=" * 68)
    print(f" KIMSCANNING v1   |   {verdict}")
    print("=" * 68)
    print(f"Session   : {session.get('id')}")
    print(f"Kind      : {session.get('kind')}  ({session.get('profile')})")
    print(f"Target    : {session.get('target')}")
    if session.get("kind") in ("file", "installer"):
        print(f"SHA-256   : {session.get('sha256') or '-'}")
        print(f"Size      : {session.get('size_bytes', '-')} bytes")
        print(f"File type : {session.get('file_type') or '-'}")
    print(f"Time      : {session.get('started')} -> {session.get('finished')}")
    auth = session.get("authorized", {})
    if session.get("kind") in ("web", "server"):
        status = "yes" if auth.get("granted") else "no"
        print(f"Authorized: {status} (scope: {auth.get('scope') or '-'})")
    print(
        "Counts    : "
        f"critical={counts.get('critical', 0)} "
        f"high={counts.get('high', 0)} "
        f"medium={counts.get('medium', 0)} "
        f"low={counts.get('low', 0)}"
    )

    print("\nTOOLS:")
    for scanner in session.get("scanners", []):
        rc = scanner.get("rc")
        rc_text = "-" if rc is None else str(rc)
        print(
            f"  {scanner.get('name', '?'):<10} "
            f"{scanner.get('status', '?'):<8} rc={rc_text:<3} "
            f"{scanner.get('reason', '')}"
        )

    findings = session.get("findings", [])
    print(f"\nFINDINGS ({len(findings)}):")
    if not findings:
        print("  No findings reported.")
        return

    current_file = None
    for n, f in enumerate(display_order(session), 1):
        file = str(f.get("file") or "?")
        if file != current_file:
            print(f"\n  {file}")
            current_file = file
        sev = str(f.get("severity", "unknown")).upper()
        line = f.get("line") or 0
        print(
            f"    [{n}] [{sev}] {f.get('tool')}/{f.get('rule')} "
            f"(line {line}) — status: {f.get('status')}"
        )
        exp = f.get("explanation")
        if isinstance(exp, dict):
            print(f"      WHAT    : {exp.get('what', '')}")
            print(f"      WHY     : {exp.get('why', '')}")
            print(f"      FIX     : {exp.get('fix', '')}")
        else:
            print("      WHAT    : [no explanation]")
            print("      WHY     : [no explanation]")
            print("      FIX     : [no explanation]")
        print(f"      EVIDENCE: {f.get('evidence', '')}")
    print("\n  Mark an action: kimscan status %s <number> accepted" % session.get("id"))


def write_report(session: dict, path: str) -> None:
    counts = session.get("counts", {})
    lines = [
        "# KimScanning Report",
        "",
        f"**Session:** `{session.get('id')}`  ",
        f"**Kind:** {session.get('kind')} ({session.get('profile')})  ",
        f"**Target:** `{session.get('target')}`  ",
        f"**Time:** {session.get('started')} -> {session.get('finished')}  ",
        f"**Verdict:** **{session.get('verdict')}**",
        "",
    ]
    if session.get("kind") in ("file", "installer"):
        lines += [
            f"**SHA-256:** `{session.get('sha256') or '-'}`  ",
            f"**Size:** {session.get('size_bytes', '-')} bytes  ",
            f"**File type:** {session.get('file_type') or '-'}  ",
            "",
        ]
    auth = session.get("authorized", {})
    if session.get("kind") in ("web", "server"):
        lines += [
            f"**Authorized:** {'yes' if auth.get('granted') else 'no'}  ",
            f"**Scope:** `{auth.get('scope') or '-'}`  ",
            "",
        ]

    lines += [
        "## Issue counts",
        "",
        "| Level | Count |",
        "|---|---:|",
        f"| critical | {counts.get('critical', 0)} |",
        f"| high | {counts.get('high', 0)} |",
        f"| medium | {counts.get('medium', 0)} |",
        f"| low | {counts.get('low', 0)} |",
        "",
        "## Tools",
        "",
        "| Tool | Status | RC | Reason |",
        "|---|---|---:|---|",
    ]
    for scanner in session.get("scanners", []):
        reason = str(scanner.get("reason", "")).replace("|", "/")
        rc = scanner.get("rc")
        lines.append(
            f"| {scanner.get('name')} | {scanner.get('status')} | "
            f"{'-' if rc is None else rc} | {reason} |"
        )

    findings = session.get("findings", [])
    lines += ["", f"## Findings ({len(findings)})", ""]
    if not findings:
        lines.append("_No findings reported._")
    else:
        grouped = {}
        for f in findings:
            grouped.setdefault(str(f.get("file") or "?"), []).append(f)
        for file in sorted(grouped):
            lines += [f"### `{file}`", ""]
            rows = sorted(
                grouped[file],
                key=lambda x: (
                    SEV_RANK.get(str(x.get("severity", "unknown")).lower(), 99),
                    str(x.get("tool", "")),
                    int(x.get("line") or 0),
                    str(x.get("rule", "")),
                ),
            )
            for f in rows:
                sev = str(f.get("severity", "unknown")).upper()
                lines += [
                    f"#### [{sev}] `{f.get('tool')}/{f.get('rule')}` — "
                    f"line {f.get('line') or 0}",
                    "",
                    f"- **Status:** {f.get('status')}",
                    f"- **First seen:** {f.get('first_seen')}",
                    f"- **Last seen:** {f.get('last_seen')}",
                ]
                exp = f.get("explanation")
                if isinstance(exp, dict):
                    lines += [
                        f"- **WHAT:** {exp.get('what', '')}",
                        f"- **WHY:** {exp.get('why', '')}",
                        f"- **FIX:** {exp.get('fix', '')}",
                    ]
                else:
                    lines += [
                        "- **WHAT:** [no explanation]",
                        "- **WHY:** [no explanation]",
                        "- **FIX:** [no explanation]",
                    ]
                lines += [f"- **Evidence:** {f.get('evidence', '')}", ""]
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path, "w", encoding="utf-8") as fh:
        fh.write("\n".join(lines).rstrip() + "\n")


# ----------------------------------------------------------------- scanning

def json_emit(obj: dict) -> None:
    print(json.dumps(obj, ensure_ascii=False, separators=(",", ":")), flush=True)


def fail(message: str) -> int:
    print(f"ERROR: {message}", file=sys.stderr)
    return 1


INSTALLER_SUFFIXES = (".sh", ".deb", ".rpm", ".AppImage", ".run", ".bin", ".exe")


def is_installer_path(path: str) -> bool:
    """Supported extensions, or a bare Arch build artifact without an extension."""
    if os.path.basename(path) == "PKGBUILD" or path.endswith(INSTALLER_SUFFIXES):
        return True
    file_exe = shutil.which("file")
    if not file_exe:
        return False
    try:
        result = subprocess.run([file_exe, "-b", path], capture_output=True,
                                text=True, timeout=30)
        return result.returncode == 0 and "ELF" in result.stdout
    except (OSError, subprocess.TimeoutExpired):
        return False


def run_file_checks(path: str, run_malware_checks: bool):
    """Run local checks that gate.py does not provide.

    Return metadata, scanner records, and extra findings. YARA needs a
    rules file; it only runs when KIMSCAN_YARA_RULES points to one.
    """
    metadata = {"sha256": None, "size_bytes": os.path.getsize(path), "file_type": None}
    scanners, findings = [], []

    def missing(name: str):
        scanners.append({"name": name, "status": "skipped", "rc": None,
                         "reason": "available: no"})

    file_exe = shutil.which("file")
    if not file_exe:
        missing("file")
    else:
        try:
            p = subprocess.run([file_exe, "-b", path], capture_output=True,
                               text=True, timeout=30)
            if p.returncode == 0:
                metadata["file_type"] = p.stdout.strip()
                scanners.append({"name": "file", "status": "done", "rc": 0,
                                 "reason": metadata["file_type"] or "done"})
            else:
                scanners.append({"name": "file", "status": "failed", "rc": p.returncode,
                                 "reason": (p.stderr or p.stdout or "file failed").strip()[:300]})
        except (OSError, subprocess.TimeoutExpired) as exc:
            scanners.append({"name": "file", "status": "failed", "rc": None,
                             "reason": str(exc)[:300]})

    sha_exe = shutil.which("sha256sum")
    if not sha_exe:
        missing("sha256sum")
    else:
        try:
            p = subprocess.run([sha_exe, path], capture_output=True, text=True, timeout=30)
            digest = p.stdout.split()[0] if p.returncode == 0 and p.stdout.split() else None
            if digest and len(digest) == 64:
                metadata["sha256"] = digest
                scanners.append({"name": "sha256sum", "status": "done", "rc": 0,
                                 "reason": "done"})
            else:
                scanners.append({"name": "sha256sum", "status": "failed", "rc": p.returncode,
                                 "reason": (p.stderr or p.stdout or "sha256sum failed").strip()[:300]})
        except (OSError, subprocess.TimeoutExpired) as exc:
            scanners.append({"name": "sha256sum", "status": "failed", "rc": None,
                             "reason": str(exc)[:300]})

    for name in ("clamscan", "yara"):
        exe = shutil.which(name)
        if not exe:
            missing(name)
            continue
        if not run_malware_checks:
            scanners.append({"name": name, "status": "skipped", "rc": None,
                             "reason": "only for binaries or installers"})
            continue
        if name == "yara":
            rules = os.environ.get("KIMSCAN_YARA_RULES")
            if not rules or not os.path.isfile(rules):
                scanners.append({"name": "yara", "status": "skipped", "rc": None,
                                 "reason": "no rules file (set KIMSCAN_YARA_RULES)"})
                continue
            command = [exe, rules, path]
        else:
            command = [exe, "--no-summary", path]
        try:
            p = subprocess.run(command, capture_output=True, text=True, timeout=300)
        except (OSError, subprocess.TimeoutExpired) as exc:
            scanners.append({"name": name, "status": "failed", "rc": None,
                             "reason": str(exc)[:300]})
            continue
        output = (p.stdout or p.stderr or "").strip()
        if p.returncode == 0:
            scanners.append({"name": name, "status": "done", "rc": 0, "reason": "done"})
        elif p.returncode == 1:
            scanners.append({"name": name, "status": "done", "rc": 1,
                             "reason": "match found"})
            findings.append({
                "tool": name, "rule": "malware-match", "severity": "high",
                "file": path, "line": 0,
                "message": output[:500] or "malware match detected",
            })
        else:
            scanners.append({"name": name, "status": "failed", "rc": p.returncode,
                             "reason": output[:300] or f"{name} failed"})
    return metadata, scanners, findings


def run_scan(kind: str, argv: list) -> int:
    parser = argparse.ArgumentParser(prog=f"kimscan {kind}", add_help=False)
    parser.add_argument("target")
    parser.add_argument("--authorized", action="store_true")
    parser.add_argument("--scope", default=None)
    parser.add_argument("--json", action="store_true")
    parser.add_argument("--fail-on", choices=["critical", "high", "medium"], default="high")
    parser.add_argument("-h", "--help", action="store_true")
    try:
        args = parser.parse_args(argv)
    except SystemExit:
        return 1

    if args.help:
        print_scan_help(kind)
        return 0

    if kind in ("web", "server") and not args.authorized:
        return fail(
            f"the {kind} scan is an active scan and requires --authorized. "
            "Confirm first that you have written authorization to "
            "scan this target."
        )

    target = args.target
    if kind == "repo":
        target = os.path.abspath(target)
        if not os.path.isdir(target):
            return fail(f"not a directory: {target}")
    elif kind in ("file", "installer"):
        target = os.path.abspath(target)
        if not os.path.isfile(target):
            return fail(f"not a file: {target}")
        if kind == "installer" and not is_installer_path(target):
            return fail("installer must be .sh, .deb, .rpm, .AppImage, .run, .bin, .exe, or PKGBUILD")
    elif kind == "web":
        if not target.startswith(("http://", "https://")):
            return fail("web target must start with http:// or https://")
    else:
        if not target.strip():
            return fail("server target must not be empty")

    if args.scope and not os.path.isfile(args.scope):
        return fail(f"cannot read scope file: {args.scope}")
    if not os.path.isfile(GATE):
        return fail(f"gate.py not found: {GATE}")

    gate_kind = "repo" if kind in ("file", "installer") else kind
    gate_target = target
    staging_dir = None
    if kind in ("file", "installer"):
        # gate.py only accepts a folder for --kind repo (single-file scans
        # are rejected); copy the single file to a temp dir and drop it after.
        try:
            staging_dir = tempfile.mkdtemp(prefix="kimscan-file-")
            staged_file = os.path.join(staging_dir, os.path.basename(target))
            shutil.copy2(target, staged_file)
            gate_target = staging_dir
        except OSError as exc:
            if staging_dir:
                shutil.rmtree(staging_dir, ignore_errors=True)
            return fail(f"cannot prepare the file for the gate: {exc}")

    sid = new_session_id()
    sdir = os.path.join(sessions_root(), sid)
    raw_dir = os.path.join(sdir, "raw")
    gate_out = os.path.join(sdir, ".gate")
    try:
        os.makedirs(raw_dir, exist_ok=True)
    except OSError as exc:
        return fail(f"cannot create the session: {exc}")

    started = now_iso()
    auth = {
        "granted": bool(args.authorized),
        "who": getpass.getuser() if hasattr(getpass, "getuser") else os.environ.get("USER", "?"),
        "when": started,
        "scope": args.scope,
    }

    if args.json:
        json_emit(
            {
                "phase": "start",
                "id": sid,
                "kind": kind,
                "target": target,
                "started": started,
            }
        )

    # gate.py runs as a Python script; if that path is a binary/wrapper
    # (e.g. /usr/local/bin/kimrity-gate), run it directly.
    runner = [sys.executable, GATE] if GATE.endswith(".py") else [GATE]
    cmd = runner + [
        gate_target,
        "--kind",
        gate_kind,
        "--out",
        gate_out,
        "--fail-on",
        args.fail_on,
        "--quiet",
    ]
    if args.authorized:
        cmd.append("--authorized")
    if args.scope:
        cmd += ["--scope", args.scope]

    # Semgrep stores settings below XDG_CONFIG_HOME. Keep Gate's child-tool
    # state inside the session, rather than allowing an inherited host setting
    # to write outside the session (especially important for temporary HOME).
    gate_env = os.environ.copy()
    gate_env["XDG_CONFIG_HOME"] = os.path.join(sdir, ".config")
    try:
        proc = subprocess.run(cmd, capture_output=True, text=True, timeout=3600,
                              env=gate_env)
    except (OSError, subprocess.TimeoutExpired) as exc:
        shutil.rmtree(sdir, ignore_errors=True)
        if staging_dir:
            shutil.rmtree(staging_dir, ignore_errors=True)
        return fail(f"could not run the gate: {exc}")

    gate_json_path = os.path.join(gate_out, "gate.json")
    gate = read_json(gate_json_path)
    if not isinstance(gate, dict):
        detail = (proc.stderr or proc.stdout or "").strip()
        shutil.rmtree(sdir, ignore_errors=True)
        if staging_dir:
            shutil.rmtree(staging_dir, ignore_errors=True)
        return fail(f"gate failed to produce gate.json (rc={proc.returncode}). {detail[:400]}")

    # Move raw evidence into the session.
    raw_src = os.path.join(gate_out, ".raw")
    if os.path.isdir(raw_src):
        for name in os.listdir(raw_src):
            src = os.path.join(raw_src, name)
            dst = os.path.join(raw_dir, name)
            try:
                shutil.move(src, dst)
            except OSError:
                pass
    try:
        shutil.copy2(gate_json_path, os.path.join(raw_dir, "gate.json"))
    except OSError:
        pass
    gate_report = os.path.join(gate_out, "report.md")
    if os.path.isfile(gate_report):
        try:
            shutil.copy2(gate_report, os.path.join(raw_dir, "gate-report.md"))
        except OSError:
            pass
    shutil.rmtree(gate_out, ignore_errors=True)

    file_meta, extra_scanners, extra_findings = {}, [], []
    if kind in ("file", "installer"):
        file_type = ""
        # file(1) classifies source/config files as text; only binaries and
        # explicit installer requests receive the malware scanner attempts.
        try:
            preview = subprocess.run(["file", "-b", target], capture_output=True,
                                     text=True, timeout=30)
            file_type = preview.stdout.lower() if preview.returncode == 0 else ""
        except (OSError, subprocess.TimeoutExpired):
            pass
        file_meta, extra_scanners, extra_findings = run_file_checks(
            target, kind == "installer" or "text" not in file_type
        )
        if staging_dir:
            shutil.rmtree(staging_dir, ignore_errors=True)
            staging_dir = None

    meta = gate.get("meta") or {}
    tools = meta.get("tools") or {}
    errors = gate.get("tool_errors") or {}
    scanners = []
    for name in EXPECTED.get(gate_kind, []):
        if name not in tools:
            scanners.append(
                {"name": name, "status": "skipped", "rc": None,
                 "reason": "not run by the gate"}
            )
        elif name in errors or tools.get(name) is None:
            scanners.append(
                {"name": name, "status": "failed", "rc": 1,
                 "reason": str(errors.get(name, "tool failed to run"))[:300]}
            )
        else:
            scanners.append(
                {"name": name, "status": "done", "rc": 0, "reason": "done"}
            )
    scanners.extend(extra_scanners)

    rules = load_rules()
    ledger = load_ledger()

    # History for the same kind+target, oldest -> newest.
    history = [
        s for s in all_sessions()
        if s.get("kind") == kind and s.get("target") == target and s.get("id") != sid
    ]
    history.sort(key=lambda s: (str(s.get("started") or ""), str(s.get("id") or "")))
    prior = {}
    for old in history:
        old_started = old.get("started") or started
        for pf in old.get("findings", []) or []:
            fp = pf.get("fp")
            if not fp:
                continue
            rec = prior.get(fp)
            first_seen = pf.get("first_seen") or old_started
            if rec is None:
                prior[fp] = {
                    "status": pf.get("status", "new"),
                    "first_seen": first_seen,
                }
            else:
                rec["status"] = pf.get("status", "new")
                if first_seen and (
                    not rec["first_seen"] or str(first_seen) < str(rec["first_seen"])
                ):
                    rec["first_seen"] = first_seen

    finished = now_iso()
    findings = []
    for item in (gate.get("findings", []) or []) + extra_findings:
        tool = str(item.get("tool", "?"))
        rule = str(item.get("rule", "?"))
        file = str(item.get("file", "?"))
        if kind in ("file", "installer") and os.path.basename(file) == os.path.basename(target):
            file = target
        try:
            line = int(item.get("line") or 0)
        except (TypeError, ValueError):
            line = 0
        message = str(item.get("message", ""))[:500]
        fp = hashlib.sha1(
            f"{tool}|{rule}|{file}|{line}".encode("utf-8")
        ).hexdigest()[:12]
        old = prior.get(fp)
        status = old["status"] if old else "new"
        first_seen = old["first_seen"] if old else started
        overwrite = ledger.get(ledger_key(kind, target, fp))
        if isinstance(overwrite, dict) and overwrite.get("status") in STATUSES:
            status = overwrite["status"]
        if status not in STATUSES:
            status = "new"
        evidence = f"{file}:{line} — {message}".strip(" —")
        findings.append(
            {
                "fp": fp,
                "tool": tool,
                "rule": rule,
                "severity": str(item.get("severity", "unknown")).lower(),
                "file": file,
                "line": line,
                "message": message,
                "evidence": evidence,
                "explanation": rules.get(f"{tool}|{rule}"),
                "status": status,
                "first_seen": first_seen,
                "last_seen": finished,
            }
        )

    raw_counts = gate.get("counts") or {}
    for item in extra_findings:
        severity = str(item.get("severity", "unknown")).lower()
        raw_counts[severity] = int(raw_counts.get(severity, 0) or 0) + 1
    verdict = GATE_VERDICT.get(str(gate.get("verdict")), "FAIL")
    if extra_findings:
        verdict = "FAIL"
    session = {
        "id": sid,
        "kind": kind,
        "target": target,
        "file_path": target if kind in ("file", "installer") else None,
        "profile": f"{kind}-standard",
        "authorized": auth,
        "started": started,
        "finished": finished,
        "verdict": verdict,
        "scanners": scanners,
        "counts": {
            "critical": int(raw_counts.get("critical", 0) or 0),
            "high": int(raw_counts.get("high", 0) or 0),
            "medium": int(raw_counts.get("medium", 0) or 0),
            "low": int(raw_counts.get("low", 0) or 0),
        },
        "findings": findings,
    }
    if kind in ("file", "installer"):
        session.update(file_meta)

    write_json(os.path.join(sdir, "session.json"), session)
    write_report(session, os.path.join(sdir, "report.md"))

    code = VERDICT_EXIT.get(session["verdict"], 3)
    if args.json:
        for scanner in scanners:
            json_emit(
                {
                    "phase": "scanner",
                    "name": scanner["name"],
                    "status": scanner["status"],
                    "rc": scanner["rc"],
                    "reason": scanner["reason"],
                }
            )
        json_emit(
            {
                "phase": "done",
                "id": sid,
                "verdict": session["verdict"],
                "counts": session["counts"],
                "exit": code,
            }
        )
    else:
        print_session(session)
    return code


# ---------------------------------------------------------------- commands

def cmd_list(argv: list) -> int:
    parser = argparse.ArgumentParser(prog="kimscan list", add_help=False)
    parser.add_argument("-h", "--help", action="store_true")
    try:
        args = parser.parse_args(argv)
    except SystemExit:
        return 1
    if args.help:
        print("Usage: kimscan list\n\nList all stored sessions.")
        return 0
    sessions = all_sessions()
    if not sessions:
        print("No sessions yet. Run: kimscan repo <folder>")
        return 0
    print(f"{'ID':<18} {'KIND':<7} {'VERDICT':<14} {'C/H/M/L':<12} TARGET")
    for s in sessions:
        c = s.get("counts", {})
        counts = f"{c.get('critical', 0)}/{c.get('high', 0)}/{c.get('medium', 0)}/{c.get('low', 0)}"
        print(
            f"{str(s.get('id')):<18} {str(s.get('kind')):<7} "
            f"{str(s.get('verdict')):<14} {counts:<12} {s.get('target')}"
        )
    return 0


def cmd_show(argv: list) -> int:
    parser = argparse.ArgumentParser(prog="kimscan show", add_help=False)
    parser.add_argument("id")
    parser.add_argument("--json", action="store_true")
    parser.add_argument("-h", "--help", action="store_true")
    try:
        args = parser.parse_args(argv)
    except SystemExit:
        return 1
    if args.help:
        print("Usage: kimscan show <id> [--json]\n\nShow one full session.")
        return 0
    session, err = find_session(args.id)
    if session is None:
        return fail(err or "session not found")
    if args.json:
        print(json.dumps(session, ensure_ascii=False, indent=2))
    else:
        print_session(session)
    return 0


def cmd_status(argv: list) -> int:
    parser = argparse.ArgumentParser(prog="kimscan status", add_help=False)
    parser.add_argument("id")
    parser.add_argument("fp")
    parser.add_argument("status", choices=STATUSES)
    parser.add_argument("-h", "--help", action="store_true")
    try:
        args = parser.parse_args(argv)
    except SystemExit:
        return 1
    if args.help:
        print(
            "Usage: kimscan status <id> <number|fp> new|accepted|fixed\n\n"
            "Change the status of one finding. Use the number shown in the "
            "FINDINGS list (e.g. 3), or the full fingerprint (fp).\n"
            "The status is stored in the session and inherited by later scans "
            "of the same kind+target."
        )
        return 0
    session, err = find_session(args.id)
    if session is None:
        return fail(err or "session not found")
    ref = str(args.fp).strip()
    if ref.isdigit():
        ordered = display_order(session)
        n = int(ref)
        if n < 1 or n > len(ordered):
            return fail(
                f"number {n} is out of range — session {session.get('id')} has "
                f"{len(ordered)} findings numbered 1..{len(ordered)}"
            )
        ref = str(ordered[n - 1].get("fp") or "")
    target_fp = None
    for f in session.get("findings", []) or []:
        if f.get("fp") == ref:
            target_fp = f
            break
    if target_fp is None:
        return fail(f"fp '{ref}' not found in session {session.get('id')}")
    target_fp["status"] = args.status
    write_json(session_path(session["id"]), session)
    write_report(session, os.path.join(sessions_root(), session["id"], "report.md"))
    ledger = load_ledger()
    ledger[ledger_key(str(session.get("kind")), str(session.get("target")), ref)] = {
        "status": args.status,
        "when": now_iso(),
    }
    save_ledger(ledger)
    print(
        f"Status of {args.fp} in session {session['id']} changed to "
        f"'{args.status}'."
    )
    return 0


def cmd_rules(argv: list) -> int:
    parser = argparse.ArgumentParser(prog="kimscan rules", add_help=False)
    parser.add_argument("--missing", action="store_true")
    parser.add_argument("-h", "--help", action="store_true")
    try:
        args = parser.parse_args(argv)
    except SystemExit:
        return 1
    if args.help:
        print(
            "Usage: kimscan rules [--missing]\n\n"
            "List the rule dictionary, or rule ids seen in scans but not "
            "present in the dictionary."
        )
        return 0
    rules = load_rules()
    if not args.missing:
        print(f"Rule dictionary: {len(rules)} entries ({RULES_PATH})")
        for key in sorted(rules):
            tool, _, rule = key.partition("|")
            print(f"  {tool:<10} {rule}")
        return 0

    seen = {}
    for session in all_sessions():
        for f in session.get("findings", []) or []:
            tool = str(f.get("tool") or "")
            rule = str(f.get("rule") or "")
            if not tool or not rule:
                continue
            key = (tool, rule)
            rec = seen.setdefault(key, {"count": 0, "sessions": set()})
            rec["count"] += 1
            rec["sessions"].add(str(session.get("id")))
    missing = sorted(
        (tool, rule, rec) for (tool, rule), rec in seen.items()
        if f"{tool}|{rule}" not in rules
    )
    print(f"Rule dictionary: {len(rules)} entries")
    print(f"Rule ids seen in sessions: {len(seen)}")
    print(f"Rule ids without an explanation: {len(missing)}")
    if not missing:
        print("No missing rule ids — every rule seen is in the dictionary.")
        return 0
    for tool, rule, rec in missing:
        n_sess = len(rec["sessions"])
        print(f"  {tool}/{rule}  ({rec['count']} findings, {n_sess} sessions)")
    return 0


def cmd_doctor(argv: list) -> int:
    parser = argparse.ArgumentParser(prog="kimscan doctor", add_help=False)
    parser.add_argument("-h", "--help", action="store_true")
    try:
        args = parser.parse_args(argv)
    except SystemExit:
        return 1
    if args.help:
        print("Usage: kimscan doctor\n\nCheck which scanning tools are available.")
        return 0
    print("KimScanning check")
    print(f"{'TOOL':<12} {'STATUS':<12} VERSION")
    for name in TOOLS:
        path = shutil.which(name)
        if path:
            print(f"{name:<12} {'available':<12} {tool_version(name)}")
        else:
            print(f"{name:<12} {'available: no':<12} -")
    print()
    print(f"gate.py : {GATE} ({'present' if os.path.isfile(GATE) else 'MISSING'})")
    rules = load_rules()
    print(f"dictionary: {RULES_PATH} ({len(rules)} entries)")
    print(f"data    : {data_root()}")
    return 0


def print_scan_help(kind: str) -> None:
    print(
        f"Usage: kimscan {kind} <target> [--authorized] [--scope S] "
        "[--json] [--fail-on critical|high|medium]"
    )
    if kind == "repo":
        print("\nrepo: local folder/repo. Runs gitleaks + semgrep + trivy.")
    elif kind == "file":
        print("\nfile: a single file. Text files are scanned by the gate; metadata is always recorded.")
    elif kind == "installer":
        print("\ninstaller: .sh/.deb/.rpm/.AppImage/.run/.bin/.exe or PKGBUILD.")
    elif kind == "web":
        print("\nweb: http/https URL. Active scan — --authorized is REQUIRED.")
    else:
        print("\nserver: host/IP. Active scan — --authorized is REQUIRED.")
    print("\n--json prints NDJSON progress to stdout.")


def print_help() -> None:
    print(
        """KimScanning v1 — terminal scanner driven by the KimRity Security Gate

USAGE:
  kimscan repo <folder> [--scope S] [--json] [--fail-on T]
  kimscan file <path> [--json] [--fail-on T]
  kimscan installer <path> [--json] [--fail-on T]
  kimscan web <url> --authorized [--scope S] [--json] [--fail-on T]
  kimscan server <host> --authorized [--scope S] [--json] [--fail-on T]
  kimscan list
  kimscan show <id> [--json]
  kimscan status <id> <fp> new|accepted|fixed
  kimscan rules [--missing]
  kimscan doctor
  kimscan help

EXAMPLES:
  kimscan repo .
  kimscan repo ~/my-project --fail-on medium
  kimscan file ./settings.py
  kimscan installer ./install.sh
  kimscan web https://127.0.0.1 --authorized --scope scope.txt
  kimscan show 20261028T120000Z
  kimscan status 20261028T120000Z a1b2c3d4e5f6 accepted
  kimscan rules --missing

EXIT CODES:
  0  PASS
  1  usage error / permission guard
  2  CONDITIONAL
  3  FAIL

Sessions are stored under $XDG_DATA_HOME/kimscanning/sessions/
(default: ~/.local/share/kimscanning/sessions/).
Finding explanations come from the static rules/en.yaml dictionary — no AI.
"""
    )


def main(argv=None) -> int:
    argv = list(sys.argv[1:] if argv is None else argv)
    if not argv or argv[0] in ("help", "-h", "--help"):
        print_help()
        return 0
    cmd, rest = argv[0], argv[1:]
    if cmd in EXPECTED:
        return run_scan(cmd, rest)
    if cmd == "list":
        return cmd_list(rest)
    if cmd == "show":
        return cmd_show(rest)
    if cmd == "status":
        return cmd_status(rest)
    if cmd == "rules":
        return cmd_rules(rest)
    if cmd == "doctor":
        return cmd_doctor(rest)
    print(f"ERROR: unknown command: {cmd}", file=sys.stderr)
    print("Use `kimscan help` to list the commands.", file=sys.stderr)
    return 1


if __name__ == "__main__":
    sys.exit(main())

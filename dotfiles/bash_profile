# ~/.bash_profile — autostart Hyprland on tty1 only (minimal, KimRity)
# Conditions: physical tty1 console (not SSH, not a graphics session), and
# Hyprland not already running.
if [ -z "${WAYLAND_DISPLAY:-}" ] && [ -z "${DISPLAY:-}" ] \
   && [ -z "${SSH_CONNECTION:-}" ] && [ "$(tty)" = "/dev/tty1" ] \
   && ! pgrep -x Hyprland >/dev/null 2>&1; then
    exec Hyprland
fi

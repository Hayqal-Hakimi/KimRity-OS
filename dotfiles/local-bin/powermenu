#!/bin/sh
# Power menu via wofi.
set -u
choice="$(printf 'Lock\nLog out\nReboot\nPower off' | wofi --dmenu -p 'power')" || exit 0
case "$choice" in
  Lock)        exec hyprlock ;;
  'Log out')   exec hyprctl dispatch exit ;;
  Reboot)      exec systemctl reboot ;;
  'Power off') exec systemctl poweroff ;;
esac

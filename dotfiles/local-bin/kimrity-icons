#!/usr/bin/env bash
# kimrity-icons — map tool -> real icon path for the KimRity workspace clusters.
#
# Source of truth: $KIMRITY_WORKSPACES or ~/.config/kimrity/workspaces.conf
#   preset|label|workspace|tool|command
#
# Output (one line per tool, unique and sorted):
#   tool<TAB>/full/icon/path
#   tool<TAB>--                (no icon found)
#
# Search order, first match wins:
#   1. $HOME/.local/share/kimrity/icons/<tool>.{png,svg,xpm}
#   2. Desktop entry (first Exec token == tool) -> Icon=, then the hicolor theme
#   3. /usr/share/pixmaps and /usr/share/icons/*/*/apps/<tool>.*
#   4. `--`
#
# Cache: ${XDG_CACHE_HOME:-$HOME/.cache}/kimrity/icons.txt
# The cache is invalidated whenever the conf mtime (or size) changes. No network.
set -u

conf="${KIMRITY_WORKSPACES:-$HOME/.config/kimrity/workspaces.conf}"
cache_dir="${XDG_CACHE_HOME:-$HOME/.cache}/kimrity"
cache="$cache_dir/icons.txt"
stamp="$cache_dir/icons.stamp"

conf_mtime=0
conf_size=0
if [ -r "$conf" ]; then
    conf_mtime=$(stat -c %Y -- "$conf" 2>/dev/null) || conf_mtime=0
    conf_size=$(stat -c %s -- "$conf" 2>/dev/null) || conf_size=0
fi

# Cache validity key: same conf + same mtime/size.
key="$conf|$conf_mtime|$conf_size"

if [ -s "$cache" ] && [ -f "$stamp" ] && [ "$(cat -- "$stamp" 2>/dev/null)" = "$key" ]; then
    cat -- "$cache"
    exit 0
fi

# ---- 1. tools referenced by the conf (field 4), unique & sorted ----
tools=""
if [ -r "$conf" ]; then
    tools=$(awk -F'|' '
        /^[[:space:]]*$/ { next }
        /^[[:space:]]*#/ { next }
        NF >= 4 {
            t = $4
            gsub(/^[[:space:]]+|[[:space:]]+$/, "", t)
            sub(/[[:space:]].*$/, "", t)   # legacy row: "kitty -e btop" -> "kitty"
            sub(/\r$/, "", t)
            if (t != "") print t
        }
    ' "$conf" 2>/dev/null | sort -u)
fi

# ---- icon lookup helpers ----
# hicolor theme in the fixed order, then pixmaps.
theme_icon() {
    local name=$1 dir ext
    for dir in \
        /usr/share/icons/hicolor/256x256/apps \
        /usr/share/icons/hicolor/128x128/apps \
        /usr/share/icons/hicolor/64x64/apps \
        /usr/share/icons/hicolor/48x48/apps \
        /usr/share/icons/hicolor/scalable/apps
    do
        for ext in png svg xpm; do
            if [ -f "$dir/$name.$ext" ]; then
                printf '%s' "$dir/$name.$ext"
                return 0
            fi
        done
    done
    for ext in png svg xpm; do
        if [ -f "/usr/share/pixmaps/$name.$ext" ]; then
            printf '%s' "/usr/share/pixmaps/$name.$ext"
            return 0
        fi
    done
    return 1
}

resolve_icon_value() {
    local icon=$1 name
    icon=${icon%\"}; icon=${icon#\"}
    icon=${icon%\'}; icon=${icon#\'}
    icon=${icon%"${icon##*[![:space:]]}"}   # trim trailing whitespace
    [ -n "$icon" ] || return 1

    # Absolute path: use directly when it exists.
    case "$icon" in
        /*)
            if [ -f "$icon" ]; then
                printf '%s' "$icon"
                return 0
            fi
            return 1
            ;;
    esac

    name=${icon##*/}
    case "$name" in
        *.png|*.svg|*.xpm) name=${name%.*} ;;
    esac
    theme_icon "$name"
}

# Find the .desktop whose first Exec token (basename) equals the tool.
desktop_icon() {
    local tool=$1 dir f entry exec first icon
    for dir in /usr/share/applications "$HOME/.local/share/applications"; do
        [ -d "$dir" ] || continue
        for f in "$dir"/*.desktop; do
            [ -f "$f" ] || continue
            # Read Exec= and Icon= from the [Desktop Entry] group only.
            entry=$(awk '
                /^\[/ { grp = $0; next }
                grp == "[Desktop Entry]" && /^Exec=/ && !e { e = substr($0, 6) }
                grp == "[Desktop Entry]" && /^Icon=/ && !i { i = substr($0, 6) }
                END { print e "\n" i }
            ' "$f" 2>/dev/null)
            exec=${entry%%$'\n'*}
            icon=${entry#*$'\n'}
            [ -n "$exec" ] || continue

            first=${exec%%[[:space:]]*}
            first=${first%\"}; first=${first#\"}
            first=${first%\'}; first=${first#\'}
            [ "$(basename -- "$first")" = "$tool" ] || continue

            resolve_icon_value "$icon" && return 0
        done
    done
    return 1
}

# ---- 3. look for a file named <tool>.* ----
named_icon() {
    local tool=$1 f size
    for f in /usr/share/pixmaps/"$tool".*; do
        [ -f "$f" ] || continue
        case "$f" in
            *.png|*.svg|*.xpm) printf '%s' "$f"; return 0 ;;
        esac
    done
    # /usr/share/icons/*/*/apps/<tool>.* — prefer larger sizes so the icon is clear.
    for size in 256x256 128x128 64x64 48x48 32x32 24x24 22x22 scalable 16x16; do
        for f in /usr/share/icons/*/"$size"/apps/"$tool".*; do
            [ -f "$f" ] || continue
            case "$f" in
                *.png|*.svg|*.xpm) printf '%s' "$f"; return 0 ;;
            esac
        done
    done
    return 1
}

resolve_tool() {
    local tool=$1 path ext
    # 1. user-owned icons always win
    for ext in png svg xpm; do
        path="$HOME/.local/share/kimrity/icons/$tool.$ext"
        if [ -f "$path" ]; then
            printf '%s' "$path"
            return 0
        fi
    done
    # 2. desktop entry
    desktop_icon "$tool" && return 0
    # 3. direct file name
    named_icon "$tool" && return 0
    return 1
}

# ---- build the output ----
out=""
if [ -n "$tools" ]; then
    while IFS= read -r tool; do
        [ -n "$tool" ] || continue
        if path=$(resolve_tool "$tool"); then
            out+="$tool"$'\t'"$path"$'\n'
        else
            out+="$tool"$'\t--'$'\n'
        fi
    done <<< "$tools"
fi

# ---- write the cache atomically, then print ----
if mkdir -p "$cache_dir" 2>/dev/null; then
    tmp="$cache.tmp.$$"
    if printf '%s' "$out" > "$tmp" 2>/dev/null && mv -f -- "$tmp" "$cache" 2>/dev/null; then
        printf '%s' "$key" > "$stamp.tmp.$$" 2>/dev/null && \
            mv -f -- "$stamp.tmp.$$" "$stamp" 2>/dev/null
        rm -f -- "$stamp.tmp.$$"
    else
        rm -f -- "$tmp"
    fi
fi

printf '%s' "$out"
exit 0

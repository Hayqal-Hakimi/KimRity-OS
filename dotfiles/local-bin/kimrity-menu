#!/usr/bin/env bash
# kimrity-menu — KimRity main menu (looks first, contents come later)
# Style: wofi dmenu, Nerd Font icons, nested submenus.
set -uo pipefail

WOFI=(wofi --dmenu -i --cache-file /dev/null
      --conf "$HOME/.config/wofi/menu.conf"
      --style "$HOME/.config/wofi/style.css")

pick() {  # $1 prompt; stdin = list
  "${WOFI[@]}" -p "$1"
}

todo() { notify-send "KimRity" "Not wired up yet: $1" 2>/dev/null || true; }

BACK="    Back"

# --------------------------------------------------------------- submenu
sub_learn() {
  sel=$(printf '%s\n' "    SPM" "    Cybersecurity" "    Notes" "$BACK" | pick "Learn")
  case "${sel:-}" in
    *SPM*)          todo "Learn → SPM" ;;
    *Cybersecurity*) todo "Learn → Cybersecurity" ;;
    *Notes*)        todo "Learn → Notes" ;;
    *Back*)         main_menu ;;
  esac
}

sub_trigger() {
  sel=$(printf '%s\n' "    Lab" "    Scan" "    Gate" "$BACK" | pick "Trigger")
  case "${sel:-}" in
    *Lab*)      todo "Trigger → Lab" ;;
    *Scan*)     todo "Trigger → Scan" ;;
    *Gate*)     todo "Trigger → Gate" ;;
    *Back*)     main_menu ;;
  esac
}

sub_style() {
  sel=$(printf '%s\n' "    Wallpaper" "    Theme" "    Waybar" "    Terminal" "$BACK" | pick "Style")
  case "${sel:-}" in
    *Wallpaper*)  todo "Style → Wallpaper" ;;
    *Theme*)      todo "Style → Theme" ;;
    *Waybar*)     todo "Style → Waybar" ;;
    *Terminal*)   todo "Style → Terminal" ;;
    *Back*)       main_menu ;;
  esac
}

sub_setup() {
  sel=$(printf '%s\n' "    Hyprland" "    Waybar" "    Kitty" "    Neovim" "$BACK" | pick "Setup")
  case "${sel:-}" in
    *Hyprland*)  exec kitty -e nvim "$HOME/.config/hypr/hyprland.conf" ;;
    *Waybar*)    exec kitty -e nvim "$HOME/.config/waybar/config.jsonc" ;;
    *Kitty*)     exec kitty -e nvim "$HOME/.config/kitty/kitty.conf" ;;
    *Neovim*)    exec kitty -e nvim "$HOME/.config/nvim/init.lua" ;;
    *Back*)      main_menu ;;
  esac
}

sub_install() {
  sel=$(printf '%s\n' "    Pacman" "    BlackArch" "$BACK" | pick "Install")
  case "${sel:-}" in
    *Pacman*)     exec kitty -e sudo pacman -S --needed ;;
    *BlackArch*)  todo "Install → BlackArch" ;;
    *Back*)       main_menu ;;
  esac
}

sub_remove() {
  sel=$(printf '%s\n' "    Pacman" "$BACK" | pick "Remove")
  case "${sel:-}" in
    *Pacman*)    exec kitty -e sudo pacman -Rns ;;
    *Back*)      main_menu ;;
  esac
}

sub_update() {
  sel=$(printf '%s\n' "    Check updates" "    Upgrade" "$BACK" | pick "Update")
  case "${sel:-}" in
    *Check*)      exec kitty -e pacman -Qu ;;
    *Upgrade*)    exec kitty -e sudo pacman -Syu ;;
    *Back*)       main_menu ;;
  esac
}

about() {
  notify-send "KimRity" "Arch + Hyprland · security workstation
Kernel: $(uname -r)
Gate: /usr/local/bin/kimrity-gate" 2>/dev/null || true
}

# ------------------------------------------------------------------ root
main_menu() {
  sel=$(printf '%s\n' \
    "    Apps" \
    "    Learn" \
    "    Trigger" \
    "    Style" \
    "    Setup" \
    "    Install" \
    "    Remove" \
    "    Update" \
    "    About" \
    "    System" | pick "Go…")

  case "${sel:-}" in
    *Apps*)     exec wofi --show drun --style "$HOME/.config/wofi/style.css" ;;
    *Learn*)    sub_learn ;;
    *Trigger*)  sub_trigger ;;
    *Style*)    sub_style ;;
    *Setup*)    sub_setup ;;
    *Install*)  sub_install ;;
    *Remove*)   sub_remove ;;
    *Update*)   sub_update ;;
    *About*)    about ;;
    *System*)   exec "$HOME/.local/bin/powermenu" ;;
  esac
}

main_menu

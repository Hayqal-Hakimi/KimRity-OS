#!/bin/sh
# Pick from clipboard history (cliphist) through wofi.
# Press SUPER+V again = close (wofi is not a window; SUPER+Q cannot kill it).
set -u

if pgrep -u "$(id -u)" -x wofi >/dev/null 2>&1; then
    pkill -u "$(id -u)" -x wofi
    exit 0
fi

# Missing tool or empty history would pop a blank wofi window that looks hung.
{ command -v cliphist >/dev/null 2>&1 && command -v wl-copy >/dev/null 2>&1; } || {
    notify-send "KimRity" "cliphist/wl-copy missing - no clipboard menu" 2>/dev/null
    exit 1
}
[ -n "$(cliphist list 2>/dev/null)" ] || {
    notify-send "KimRity" "Clipboard history is empty" 2>/dev/null
    exit 0
}

sel="$(cliphist list | wofi --dmenu -i -p 'clip')" || exit 0
[ -n "$sel" ] || exit 0

# Decode into a file first: a failed decode must not blank the real clipboard
# (wl-copy with empty stdin clears it).
tmp="$(mktemp)" || exit 1
trap 'rm -f "$tmp"' EXIT
printf '%s\n' "$sel" | cliphist decode >"$tmp" 2>/dev/null || exit 1
[ -s "$tmp" ] || exit 1
wl-copy <"$tmp"

#!/bin/sh
# Pilih dari sejarah clipboard (cliphist) melalui wofi.
# Tekan SUPER+V lagi sekali = tutup (wofi bukan tetingkap, SUPER+Q tak boleh bunuh).
set -u
if pgrep -u "$(id -u)" -x wofi >/dev/null 2>&1; then
    pkill -u "$(id -u)" -x wofi
    exit 0
fi
sel="$(cliphist list | wofi --dmenu -i -p 'klip')" || exit 0
[ -n "$sel" ] || exit 0
printf '%s' "$sel" | cliphist decode | wl-copy

#!/usr/bin/env python3
"""KimAI v1 - broker kelulusan setempat melalui Unix socket.

Tiada model AI, tiada panggilan rangkaian dan tiada API luar dalam v1.
Fail ini hanya menggunakan pustaka standard Python.
"""

import json
import os
import shlex
import signal
import socket
import stat
import struct
import subprocess
import sys
import threading
import time
import uuid
from datetime import datetime, timezone

try:
    import tomllib
except ImportError:  # Python < 3.11
    tomllib = None

VERSION = "0.1.0"
AI_NOT_CONFIGURED = "AI belum dikonfigurasi"
NOT_RUNNING = "KimAI tidak berjalan"
MAX_LINE = 1024 * 1024
RECENT_LIMIT = 50


class BrokerError(Exception):
    """Ralat yang selamat dipaparkan kepada klien."""


def _home():
    return os.environ.get("HOME") or os.path.expanduser("~")


def socket_path():
    """Pilih laluan socket mengikut XDG_RUNTIME_DIR, /run/user/<uid>, cache."""
    uid = os.getuid()
    xdg = os.environ.get("XDG_RUNTIME_DIR")
    if xdg:
        directory = xdg
        candidate = os.path.join(directory, "kimai.sock")
        if os.path.isdir(directory) and os.access(directory, os.W_OK | os.X_OK):
            return candidate
    run_dir = "/run/user/%d" % uid
    candidate = os.path.join(run_dir, "kimai.sock")
    if os.path.isdir(run_dir) and os.access(run_dir, os.W_OK | os.X_OK):
        return candidate
    return os.path.join(_home(), ".cache", "kimai", "kimai.sock")


def approvals_path():
    base = os.environ.get("XDG_DATA_HOME")
    if not base:
        base = os.path.join(_home(), ".local", "share")
    return os.path.join(base, "kimai", "approvals.jsonl")


def config_path():
    return os.path.join(_home(), ".config", "kimai", "config.toml")


def now_iso():
    return datetime.now(timezone.utc).isoformat(timespec="milliseconds").replace(
        "+00:00", "Z"
    )


_record_lock = threading.Lock()


def append_record(entry):
    """Tambah satu objek JSON ke fail rekod. Hanya append, tidak pernah tulis semula."""
    path = approvals_path()
    os.makedirs(os.path.dirname(path), mode=0o700, exist_ok=True)
    line = json.dumps(entry, ensure_ascii=False, separators=(",", ":")) + "\n"
    payload = line.encode("utf-8")
    with _record_lock:
        fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_APPEND, 0o600)
        try:
            os.write(fd, payload)
            os.fsync(fd)
        finally:
            os.close(fd)


def configured_command():
    """Baca kunci 'command' daripada ~/.config/kimai/config.toml.

    Kunci boleh berada di peringkat atas atau dalam jadual [ai].
    Pulangkan None jika tiada. Naikkan BrokerError jika fail tidak sah.
    """
    path = config_path()
    if not os.path.exists(path):
        return None
    if tomllib is None:
        raise BrokerError("tomllib tidak tersedia; konfigurasi tidak dapat dibaca")
    try:
        with open(path, "rb") as handle:
            data = tomllib.load(handle)
    except (OSError, ValueError) as exc:
        raise BrokerError("Konfigurasi KimAI tidak sah: %s" % exc)
    command = data.get("command")
    if command is None and isinstance(data.get("ai"), dict):
        command = data["ai"].get("command")
    if command is None:
        return None
    if isinstance(command, str):
        if command.strip():
            return command
        return None
    if isinstance(command, list) and command and all(
        isinstance(part, str) for part in command
    ):
        return command
    raise BrokerError("Kunci 'command' mesti rentetan atau senarai rentetan")


def ai_enabled():
    try:
        return configured_command() is not None
    except BrokerError:
        return False


class Broker:
    def __init__(self, started_monotonic):
        self.started = started_monotonic
        self.lock = threading.RLock()
        self.pending = {}
        self.recent = []

    def ping(self):
        return {"pong": True, "version": VERSION}

    def status(self):
        with self.lock:
            pending = len(self.pending)
        return {
            "version": VERSION,
            "uptime_s": round(time.monotonic() - self.started, 3),
            "ai_enabled": ai_enabled(),
            "pending_approvals": pending,
            "socket": socket_path(),
        }

    def ask(self, args):
        prompt = args.get("prompt")
        if not isinstance(prompt, str):
            raise BrokerError("Medan 'prompt' diperlukan")
        command = configured_command()
        if command is None:
            raise BrokerError(AI_NOT_CONFIGURED)
        if isinstance(command, str):
            argv = shlex.split(command)
        else:
            argv = list(command)
        if not argv:
            raise BrokerError("Kunci 'command' kosong")
        try:
            proc = subprocess.run(
                argv,
                input=prompt,
                capture_output=True,
                text=True,
                timeout=120,
            )
        except FileNotFoundError:
            raise BrokerError("Perintah AI tidak dijumpai: %s" % argv[0])
        except subprocess.TimeoutExpired:
            raise BrokerError("Perintah AI tamat masa selepas 120 saat")
        except OSError as exc:
            raise BrokerError("Perintah AI gagal dijalankan: %s" % exc)
        if proc.returncode != 0:
            detail = (proc.stderr or "").strip()
            if detail:
                raise BrokerError(
                    "Perintah AI gagal (kod %d): %s" % (proc.returncode, detail)
                )
            raise BrokerError("Perintah AI gagal (kod %d)" % proc.returncode)
        return {"answer": proc.stdout, "ai_enabled": True}

    def approve_request(self, args):
        tool = args.get("tool")
        action = args.get("action")
        request_args = args.get("args")
        risk = args.get("risk", "")
        reason = args.get("reason", "")
        if not isinstance(tool, str) or not tool.strip():
            raise BrokerError("Medan 'tool' diperlukan")
        if not isinstance(action, str) or not action.strip():
            raise BrokerError("Medan 'action' diperlukan")
        if not isinstance(request_args, dict):
            raise BrokerError("Medan 'args' mesti objek JSON")
        if risk is None:
            risk = ""
        if not isinstance(risk, str):
            raise BrokerError("Medan 'risk' mesti rentetan")
        if reason is None:
            reason = ""
        if not isinstance(reason, str):
            raise BrokerError("Medan 'reason' mesti rentetan")

        request_id = "req-" + uuid.uuid4().hex
        entry = {
            "ts": now_iso(),
            "request_id": request_id,
            "tool": tool,
            "action": action,
            "args": request_args,
            "risk": risk,
            "reason": reason,
            "decision": None,
            "note": "",
        }
        append_record(entry)
        with self.lock:
            self.pending[request_id] = entry
        return {"request_id": request_id}

    def approve_list(self):
        with self.lock:
            pending = [dict(item) for item in self.pending.values()]
            recent = [dict(item) for item in self.recent[-RECENT_LIMIT:]]
        recent.reverse()
        return {"pending": pending, "recent": recent}

    def approve_decide(self, args):
        request_id = args.get("request_id")
        decision = args.get("decision")
        note = args.get("note", "")
        if not isinstance(request_id, str) or not request_id:
            raise BrokerError("Medan 'request_id' diperlukan")
        if decision not in ("lulus", "tolak"):
            raise BrokerError("Keputusan mesti 'lulus' atau 'tolak'")
        if note is None:
            note = ""
        if not isinstance(note, str):
            raise BrokerError("Medan 'note' mesti rentetan")

        with self.lock:
            entry = self.pending.get(request_id)
            if entry is None:
                if any(item.get("request_id") == request_id for item in self.recent):
                    raise BrokerError(
                        "Permintaan %s sudah diputuskan" % request_id
                    )
                raise BrokerError("Permintaan %s tidak dijumpai" % request_id)
            record = {
                "ts": now_iso(),
                "request_id": request_id,
                "tool": entry["tool"],
                "action": entry["action"],
                "args": entry["args"],
                "risk": entry["risk"],
                "reason": entry["reason"],
                "decision": decision,
                "note": note,
            }
            append_record(record)
            del self.pending[request_id]
            self.recent.append(record)
            if len(self.recent) > RECENT_LIMIT * 2:
                del self.recent[: -RECENT_LIMIT]
        return {"request_id": request_id, "decision": decision, "note": note}


def _ok(request_id, result):
    return {"id": request_id, "ok": True, "result": result}


def _error(request_id, message):
    return {"id": request_id, "ok": False, "error": message}


def dispatch(broker, request):
    if not isinstance(request, dict):
        return _error(None, "Permintaan mesti objek JSON")
    request_id = request.get("id")
    op = request.get("op")
    args = request.get("args", {})
    if args is None:
        args = {}
    if not isinstance(op, str) or not op:
        return _error(request_id, "Medan 'op' diperlukan")
    if not isinstance(args, dict):
        return _error(request_id, "Medan 'args' mesti objek JSON")
    try:
        if op == "ping":
            return _ok(request_id, broker.ping())
        if op == "status":
            return _ok(request_id, broker.status())
        if op == "ask":
            return _ok(request_id, broker.ask(args))
        if op == "approve.request":
            return _ok(request_id, broker.approve_request(args))
        if op == "approve.list":
            return _ok(request_id, broker.approve_list())
        if op == "approve.decide":
            return _ok(request_id, broker.approve_decide(args))
        return _error(request_id, "Op tidak dikenali: %s" % op)
    except BrokerError as exc:
        return _error(request_id, str(exc))
    except Exception as exc:  # jangan biarkan daemon mati kerana satu permintaan
        return _error(request_id, "Ralat dalaman: %s" % exc)


def _peer_uid(conn):
    fmt = "3i"
    try:
        data = conn.getsockopt(
            socket.SOL_SOCKET, socket.SO_PEERCRED, struct.calcsize(fmt)
        )
        _pid, uid, _gid = struct.unpack(fmt, data)
        return uid
    except (AttributeError, OSError):
        return None


def _write_response(handle, response):
    handle.write(
        (json.dumps(response, ensure_ascii=False) + "\n").encode("utf-8")
    )
    handle.flush()


def handle_connection(conn, broker, stop_event):
    try:
        conn.settimeout(30.0)
        uid = _peer_uid(conn)
        if uid is None:
            _write_response(
                conn.makefile("wb"),
                _error(None, "Tidak dapat mengesahkan UID klien"),
            )
            return
        if uid != os.getuid():
            _write_response(
                conn.makefile("wb"),
                _error(None, "Akses ditolak: UID klien berbeza"),
            )
            return
        handle = conn.makefile("rwb")
        while not stop_event.is_set():
            try:
                raw = handle.readline(MAX_LINE + 1)
            except (OSError, TimeoutError):
                return
            if not raw:
                return
            if len(raw) > MAX_LINE:
                _write_response(handle, _error(None, "Permintaan terlalu besar"))
                return
            if not raw.strip():
                continue
            try:
                request = json.loads(raw.decode("utf-8"))
            except (UnicodeDecodeError, json.JSONDecodeError) as exc:
                _write_response(handle, _error(None, "JSON tidak sah: %s" % exc))
                continue
            if isinstance(request, dict) and request.get("op") == "shutdown":
                _write_response(
                    handle, _ok(request.get("id"), {"shutdown": True})
                )
                stop_event.set()
                return
            response = dispatch(broker, request)
            _write_response(handle, response)
    except (BrokenPipeError, ConnectionResetError, OSError):
        return
    finally:
        try:
            conn.close()
        except OSError:
            pass


def _socket_is_live(path):
    probe = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    probe.settimeout(0.4)
    try:
        probe.connect(path)
        return True
    except OSError:
        return False
    finally:
        probe.close()


def run_daemon():
    path = socket_path()
    directory = os.path.dirname(path)
    try:
        os.makedirs(directory, mode=0o700, exist_ok=True)
    except OSError as exc:
        print("KimAI gagal menyediakan direktori socket: %s" % exc, file=sys.stderr)
        return 1

    if os.path.lexists(path):
        try:
            is_socket = stat.S_ISSOCK(os.lstat(path).st_mode)
        except OSError:
            is_socket = False
        if not is_socket:
            print(
                "Laluan %s wujud tetapi bukan socket; tidak dihapus" % path,
                file=sys.stderr,
            )
            return 1
        if _socket_is_live(path):
            print("KimAI sudah berjalan di %s" % path, file=sys.stderr)
            return 1
        try:
            os.unlink(path)
        except OSError as exc:
            print("KimAI gagal memadam socket lama: %s" % exc, file=sys.stderr)
            return 1

    old_umask = os.umask(0o077)
    server = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    try:
        server.bind(path)
        os.chmod(path, 0o600)
        server.listen(16)
    except OSError as exc:
        server.close()
        os.umask(old_umask)
        print("KimAI gagal mengikat socket %s: %s" % (path, exc), file=sys.stderr)
        return 1
    finally:
        os.umask(old_umask)

    if stat.S_IMODE(os.stat(path).st_mode) != 0o600:
        print("KimAI gagal menetapkan mod socket 0600", file=sys.stderr)
        server.close()
        return 1

    stop_event = threading.Event()
    broker = Broker(time.monotonic())

    def _handle_signal(_signum, _frame):
        stop_event.set()

    signal.signal(signal.SIGTERM, _handle_signal)
    signal.signal(signal.SIGINT, _handle_signal)

    print(
        "KimAI %s mendengar di %s (mod 0600)" % (VERSION, path),
        file=sys.stderr,
        flush=True,
    )
    server.settimeout(0.5)
    try:
        while not stop_event.is_set():
            try:
                conn, _addr = server.accept()
            except socket.timeout:
                continue
            except OSError:
                break
            thread = threading.Thread(
                target=handle_connection,
                args=(conn, broker, stop_event),
                daemon=True,
            )
            thread.start()
    finally:
        server.close()
        try:
            if os.path.lexists(path) and stat.S_ISSOCK(os.lstat(path).st_mode):
                os.unlink(path)
        except OSError:
            pass
        print("KimAI berhenti.", file=sys.stderr, flush=True)
    return 0


class ClientError(Exception):
    pass


def rpc(op, args=None, timeout=8.0):
    path = socket_path()
    if not os.path.exists(path):
        raise ClientError(NOT_RUNNING)
    request = {"id": uuid.uuid4().hex, "op": op, "args": args or {}}
    client = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    client.settimeout(3.0)
    try:
        client.connect(path)
        client.settimeout(timeout)
        client.sendall(
            (json.dumps(request, ensure_ascii=False) + "\n").encode("utf-8")
        )
        handle = client.makefile("rb")
        raw = handle.readline(MAX_LINE + 1)
        if not raw:
            raise ClientError(NOT_RUNNING)
        if len(raw) > MAX_LINE:
            raise ClientError("Respons KimAI terlalu besar")
        response = json.loads(raw.decode("utf-8"))
        if not isinstance(response, dict):
            raise ClientError("Respons KimAI tidak sah")
        if response.get("id") != request["id"]:
            raise ClientError("Respons KimAI tidak sepadan dengan permintaan")
        return response
    except (OSError, TimeoutError, json.JSONDecodeError, UnicodeDecodeError):
        raise ClientError(NOT_RUNNING)
    finally:
        try:
            client.close()
        except OSError:
            pass


def _print_error(message):
    print(message, file=sys.stderr)


def _not_running():
    _print_error(NOT_RUNNING)
    return 1


def _usage(stream=sys.stdout):
    stream.write(
        "Penggunaan:\n"
        "  kimai start\n"
        "  kimai stop\n"
        "  kimai status\n"
        '  kimai ask "<prompt>"\n'
        "  kimai approve list\n"
        '  kimai approve yes <request_id> [--note "..."]\n'
        '  kimai approve no  <request_id> [--note "..."]\n'
    )


def _parse_note(parts):
    note = ""
    index = 0
    while index < len(parts):
        if parts[index] == "--note" and index + 1 < len(parts):
            note = parts[index + 1]
            index += 2
        else:
            raise ValueError("pilihan tidak dikenali: %s" % parts[index])
    return note


def _format_args(value):
    try:
        return json.dumps(value, ensure_ascii=False, sort_keys=True)
    except (TypeError, ValueError):
        return str(value)


def _show_list(result):
    pending = result.get("pending") or []
    recent = result.get("recent") or []
    if not pending and not recent:
        print("Tiada permintaan kelulusan.")
        return
    if pending:
        print("Menunggu kelulusan (%d):" % len(pending))
        for entry in pending:
            print(
                "  %s  %s:%s  risiko=%s"
                % (
                    entry.get("request_id"),
                    entry.get("tool"),
                    entry.get("action"),
                    entry.get("risk") or "-",
                )
            )
            if entry.get("reason"):
                print("    sebab: %s" % entry["reason"])
            print("    args: %s" % _format_args(entry.get("args")))
            print("    diminta: %s" % entry.get("ts"))
    else:
        print("Tiada permintaan menunggu kelulusan.")
    if recent:
        print("Keputusan terkini (%d):" % len(recent))
        for entry in recent:
            print(
                "  [%s] %s  %s:%s  nota=%s"
                % (
                    entry.get("decision"),
                    entry.get("request_id"),
                    entry.get("tool"),
                    entry.get("action"),
                    entry.get("note") or "-",
                )
            )


def main(argv):
    if len(argv) < 2:
        _usage(sys.stderr)
        return 2
    command = argv[1]
    if command in ("-h", "--help", "help"):
        _usage()
        return 0
    if command == "start":
        if len(argv) != 2:
            _usage(sys.stderr)
            return 2
        return run_daemon()
    if command == "stop":
        try:
            response = rpc("shutdown", timeout=5.0)
        except ClientError:
            return _not_running()
        if not response.get("ok"):
            _print_error(response.get("error", "KimAI gagal berhenti"))
            return 1
        try:
            path = socket_path()
            if os.path.lexists(path) and stat.S_ISSOCK(os.lstat(path).st_mode):
                os.unlink(path)
        except OSError:
            pass
        print("KimAI dihentikan.")
        return 0
    if command == "status":
        try:
            response = rpc("status", timeout=5.0)
        except ClientError:
            return _not_running()
        if not response.get("ok"):
            _print_error(response.get("error", "KimAI gagal memberi status"))
            return 1
        print(
            json.dumps(
                response.get("result", {}), ensure_ascii=False, indent=2, sort_keys=True
            )
        )
        return 0
    if command == "ask":
        if len(argv) < 3:
            _usage(sys.stderr)
            return 2
        prompt = " ".join(argv[2:])
        try:
            response = rpc("ask", {"prompt": prompt}, timeout=300.0)
        except ClientError:
            return _not_running()
        if not response.get("ok"):
            _print_error(response.get("error", AI_NOT_CONFIGURED))
            return 1
        answer = response.get("result", {}).get("answer", "")
        sys.stdout.write(answer)
        if not answer.endswith("\n"):
            sys.stdout.write("\n")
        return 0
    if command == "approve":
        if len(argv) < 3:
            _usage(sys.stderr)
            return 2
        action = argv[2]
        if action == "list":
            if len(argv) != 3:
                _usage(sys.stderr)
                return 2
            try:
                response = rpc("approve.list", timeout=5.0)
            except ClientError:
                return _not_running()
            if not response.get("ok"):
                _print_error(response.get("error", "KimAI gagal menyenaraikan"))
                return 1
            _show_list(response.get("result", {}))
            return 0
        if action in ("yes", "no"):
            if len(argv) < 4:
                _usage(sys.stderr)
                return 2
            request_id = argv[3]
            try:
                note = _parse_note(argv[4:])
            except ValueError as exc:
                _print_error(str(exc))
                return 2
            decision = "lulus" if action == "yes" else "tolak"
            try:
                response = rpc(
                    "approve.decide",
                    {"request_id": request_id, "decision": decision, "note": note},
                    timeout=5.0,
                )
            except ClientError:
                return _not_running()
            if not response.get("ok"):
                _print_error(response.get("error", "KimAI gagal merekod keputusan"))
                return 1
            if decision == "lulus":
                print("Permintaan %s diluluskan." % request_id)
            else:
                print("Permintaan %s ditolak." % request_id)
            return 0
        _usage(sys.stderr)
        return 2
    _usage(sys.stderr)
    return 2


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv))
    except KeyboardInterrupt:
        sys.exit(130)

#!/usr/bin/env python3
"""KimAI v0.2 - local approval broker and event sink over a Unix socket.

No AI model, no network calls and no external API are used here. The broker
only uses the Python standard library.

Two responsibilities:

1. Approval queue - other tools (KimScanning, KimLogPipe) ask permission
   through the socket and the decision always belongs to KimAI.
2. Event sink - KimLogPipe pushes findings as events; KimAI records them
   append-only and raises a desktop notification for high severity.

The broker is designed to run as a systemd user service so it is alive
whenever the user session is alive. It does nothing while idle: no polling,
no timers, no network.
"""

import json
import os
import shlex
import shutil
import signal
import socket
import stat
import struct
import subprocess
import sys
import threading
import time
import uuid
from datetime import datetime, timezone

try:
    import tomllib
except ImportError:  # Python < 3.11
    tomllib = None

VERSION = "0.2.0"
AI_NOT_CONFIGURED = "AI is not configured"
NOT_RUNNING = "KimAI is not running"
MAX_LINE = 1024 * 1024
RECENT_LIMIT = 50
EVENT_LIMIT = 200
EVENT_ROTATE_BYTES = 5 * 1024 * 1024
SEVERITIES = ("low", "medium", "high", "critical")


class BrokerError(Exception):
    """An error that is safe to show to the client."""


def _home():
    return os.environ.get("HOME") or os.path.expanduser("~")


def data_dir():
    base = os.environ.get("XDG_DATA_HOME")
    if not base:
        base = os.path.join(_home(), ".local", "share")
    return os.path.join(base, "kimai")


def socket_path():
    """Pick the socket path from XDG_RUNTIME_DIR, /run/user/<uid>, then cache."""
    uid = os.getuid()
    xdg = os.environ.get("XDG_RUNTIME_DIR")
    if xdg:
        directory = xdg
        candidate = os.path.join(directory, "kimai.sock")
        if os.path.isdir(directory) and os.access(directory, os.W_OK | os.X_OK):
            return candidate
    run_dir = "/run/user/%d" % uid
    candidate = os.path.join(run_dir, "kimai.sock")
    if os.path.isdir(run_dir) and os.access(run_dir, os.W_OK | os.X_OK):
        return candidate
    return os.path.join(_home(), ".cache", "kimai", "kimai.sock")


def approvals_path():
    return os.path.join(data_dir(), "approvals.jsonl")


def events_path():
    return os.path.join(data_dir(), "events.jsonl")


def config_path():
    return os.path.join(_home(), ".config", "kimai", "config.toml")


def now_iso():
    return datetime.now(timezone.utc).isoformat(timespec="milliseconds").replace(
        "+00:00", "Z"
    )


_record_lock = threading.Lock()


def _append_jsonl(path, entry):
    """Append one JSON object to a file. Append only, never rewrite."""
    os.makedirs(os.path.dirname(path), mode=0o700, exist_ok=True)
    line = json.dumps(entry, ensure_ascii=False, separators=(",", ":")) + "\n"
    payload = line.encode("utf-8")
    with _record_lock:
        fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_APPEND, 0o600)
        try:
            os.write(fd, payload)
            os.fsync(fd)
        finally:
            os.close(fd)


def append_record(entry):
    _append_jsonl(approvals_path(), entry)


def _count_lines(path):
    if not os.path.isfile(path):
        return 0
    total = 0
    try:
        with open(path, "rb") as handle:
            for line in handle:
                if line.strip():
                    total += 1
    except OSError:
        return 0
    return total


def _rotate_events():
    """Keep events.jsonl bounded by rotating one generation."""
    path = events_path()
    try:
        if os.path.isfile(path) and os.path.getsize(path) > EVENT_ROTATE_BYTES:
            os.replace(path, path + ".1")
    except OSError:
        pass


def read_events(limit=EVENT_LIMIT):
    path = events_path()
    if not os.path.isfile(path):
        return []
    out = []
    try:
        with open(path, "r", encoding="utf-8", errors="replace") as handle:
            for line in handle:
                line = line.strip()
                if not line:
                    continue
                try:
                    obj = json.loads(line)
                except json.JSONDecodeError:
                    continue
                if isinstance(obj, dict):
                    out.append(obj)
    except OSError:
        return []
    if limit > 0:
        return out[-limit:]
    return out


def notify_enabled():
    return os.environ.get("KIMAI_NOTIFY", "1").strip() not in ("0", "false", "no")


def send_notification(severity, title, body):
    """Fire a desktop notification without blocking the broker loop."""
    urgency = "critical" if severity == "critical" else "normal"

    def _run():
        try:
            subprocess.run(
                [
                    "notify-send",
                    "-a",
                    "KimAI",
                    "-u",
                    urgency,
                    "-c",
                    "security",
                    title,
                    body,
                ],
                capture_output=True,
                timeout=5,
            )
        except (OSError, subprocess.SubprocessError):
            pass

    thread = threading.Thread(target=_run, daemon=True)
    thread.start()


def configured_command():
    """Read the 'command' key from ~/.config/kimai/config.toml.

    The key may sit at the top level or inside an [ai] table. Returns None
    when absent and raises BrokerError when the file is malformed.
    """
    path = config_path()
    if not os.path.exists(path):
        return None
    if tomllib is None:
        raise BrokerError("tomllib is unavailable; the config cannot be read")
    try:
        with open(path, "rb") as handle:
            data = tomllib.load(handle)
    except (OSError, ValueError) as exc:
        raise BrokerError("Invalid KimAI config: %s" % exc)
    command = data.get("command")
    if command is None and isinstance(data.get("ai"), dict):
        command = data["ai"].get("command")
    if command is None:
        return None
    if isinstance(command, str):
        if command.strip():
            return command
        return None
    if isinstance(command, list) and command and all(
        isinstance(part, str) for part in command
    ):
        return command
    raise BrokerError("The 'command' key must be a string or a list of strings")


def ai_enabled():
    try:
        return configured_command() is not None
    except BrokerError:
        return False


class Broker:
    def __init__(self, started_monotonic):
        self.started = started_monotonic
        self.lock = threading.RLock()
        self.pending = {}
        self.recent = []
        self.events_received = _count_lines(events_path())

    def ping(self):
        return {"pong": True, "version": VERSION}

    def status(self):
        with self.lock:
            pending = len(self.pending)
            events = self.events_received
        return {
            "version": VERSION,
            "uptime_s": round(time.monotonic() - self.started, 3),
            "ai_enabled": ai_enabled(),
            "pending_approvals": pending,
            "events_received": events,
            "notify": notify_enabled(),
            "socket": socket_path(),
        }

    def ask(self, args):
        prompt = args.get("prompt")
        if not isinstance(prompt, str):
            raise BrokerError("The 'prompt' field is required")
        command = configured_command()
        if command is None:
            raise BrokerError(AI_NOT_CONFIGURED)
        if isinstance(command, str):
            argv = shlex.split(command)
        else:
            argv = list(command)
        if not argv:
            raise BrokerError("The 'command' key is empty")
        try:
            proc = subprocess.run(
                argv,
                input=prompt,
                capture_output=True,
                text=True,
                timeout=120,
            )
        except FileNotFoundError:
            raise BrokerError("AI command not found: %s" % argv[0])
        except subprocess.TimeoutExpired:
            raise BrokerError("AI command timed out after 120 seconds")
        except OSError as exc:
            raise BrokerError("AI command failed to start: %s" % exc)
        if proc.returncode != 0:
            detail = (proc.stderr or "").strip()
            if detail:
                raise BrokerError(
                    "AI command failed (exit %d): %s" % (proc.returncode, detail)
                )
            raise BrokerError("AI command failed (exit %d)" % proc.returncode)
        return {"answer": proc.stdout, "ai_enabled": True}

    def event(self, args):
        source = args.get("source")
        kind = args.get("kind")
        severity = args.get("severity", "medium")
        summary = args.get("summary")
        payload = args.get("data", {})
        if not isinstance(source, str) or not source.strip():
            raise BrokerError("The 'source' field is required")
        if not isinstance(kind, str) or not kind.strip():
            raise BrokerError("The 'kind' field is required")
        if not isinstance(summary, str) or not summary.strip():
            raise BrokerError("The 'summary' field is required")
        if severity not in SEVERITIES:
            raise BrokerError(
                "The 'severity' field must be one of: %s" % ", ".join(SEVERITIES)
            )
        if payload is None:
            payload = {}
        if not isinstance(payload, dict):
            raise BrokerError("The 'data' field must be a JSON object")

        event_id = "ev-" + uuid.uuid4().hex
        entry = {
            "ts": now_iso(),
            "event_id": event_id,
            "source": source,
            "kind": kind,
            "severity": severity,
            "summary": summary,
            "data": payload,
        }
        notified = False
        if severity in ("high", "critical") and notify_enabled():
            if shutil.which("notify-send"):
                send_notification(severity, "%s: %s" % (source, kind), summary)
                notified = True
            else:
                print(
                    "notify-send is not installed; event recorded without a notification",
                    file=sys.stderr,
                )
        entry["notified"] = notified
        _rotate_events()
        _append_jsonl(events_path(), entry)
        with self.lock:
            self.events_received += 1
        return {"event_id": event_id, "notified": notified}

    def event_list(self, args):
        limit = args.get("limit", 20)
        if not isinstance(limit, int) or limit < 0:
            raise BrokerError("The 'limit' field must be a non-negative integer")
        return {"events": read_events(limit)}

    def approve_request(self, args):
        tool = args.get("tool")
        action = args.get("action")
        request_args = args.get("args")
        risk = args.get("risk", "")
        reason = args.get("reason", "")
        if not isinstance(tool, str) or not tool.strip():
            raise BrokerError("The 'tool' field is required")
        if not isinstance(action, str) or not action.strip():
            raise BrokerError("The 'action' field is required")
        if not isinstance(request_args, dict):
            raise BrokerError("The 'args' field must be a JSON object")
        if risk is None:
            risk = ""
        if not isinstance(risk, str):
            raise BrokerError("The 'risk' field must be a string")
        if reason is None:
            reason = ""
        if not isinstance(reason, str):
            raise BrokerError("The 'reason' field must be a string")

        request_id = "req-" + uuid.uuid4().hex
        entry = {
            "ts": now_iso(),
            "request_id": request_id,
            "tool": tool,
            "action": action,
            "args": request_args,
            "risk": risk,
            "reason": reason,
            "decision": None,
            "note": "",
        }
        append_record(entry)
        with self.lock:
            self.pending[request_id] = entry
        return {"request_id": request_id}

    def approve_list(self):
        with self.lock:
            pending = [dict(item) for item in self.pending.values()]
            recent = [dict(item) for item in self.recent[-RECENT_LIMIT:]]
        recent.reverse()
        return {"pending": pending, "recent": recent}

    def approve_decide(self, args):
        request_id = args.get("request_id")
        decision = args.get("decision")
        note = args.get("note", "")
        if not isinstance(request_id, str) or not request_id:
            raise BrokerError("The 'request_id' field is required")
        if decision not in ("approve", "reject"):
            raise BrokerError("The decision must be 'approve' or 'reject'")
        if note is None:
            note = ""
        if not isinstance(note, str):
            raise BrokerError("The 'note' field must be a string")

        with self.lock:
            entry = self.pending.get(request_id)
            if entry is None:
                if any(item.get("request_id") == request_id for item in self.recent):
                    raise BrokerError("Request %s was already decided" % request_id)
                raise BrokerError("Request %s was not found" % request_id)
            record = {
                "ts": now_iso(),
                "request_id": request_id,
                "tool": entry["tool"],
                "action": entry["action"],
                "args": entry["args"],
                "risk": entry["risk"],
                "reason": entry["reason"],
                "decision": decision,
                "note": note,
            }
            append_record(record)
            del self.pending[request_id]
            self.recent.append(record)
            if len(self.recent) > RECENT_LIMIT * 2:
                del self.recent[: -RECENT_LIMIT]
        return {"request_id": request_id, "decision": decision, "note": note}


def _ok(request_id, result):
    return {"id": request_id, "ok": True, "result": result}


def _error(request_id, message):
    return {"id": request_id, "ok": False, "error": message}


def dispatch(broker, request):
    if not isinstance(request, dict):
        return _error(None, "The request must be a JSON object")
    request_id = request.get("id")
    op = request.get("op")
    args = request.get("args", {})
    if args is None:
        args = {}
    if not isinstance(op, str) or not op:
        return _error(request_id, "The 'op' field is required")
    if not isinstance(args, dict):
        return _error(request_id, "The 'args' field must be a JSON object")
    try:
        if op == "ping":
            return _ok(request_id, broker.ping())
        if op == "status":
            return _ok(request_id, broker.status())
        if op == "ask":
            return _ok(request_id, broker.ask(args))
        if op == "event":
            return _ok(request_id, broker.event(args))
        if op == "event.list":
            return _ok(request_id, broker.event_list(args))
        if op == "approve.request":
            return _ok(request_id, broker.approve_request(args))
        if op == "approve.list":
            return _ok(request_id, broker.approve_list())
        if op == "approve.decide":
            return _ok(request_id, broker.approve_decide(args))
        return _error(request_id, "Unknown op: %s" % op)
    except BrokerError as exc:
        return _error(request_id, str(exc))
    except Exception as exc:  # never let one request kill the daemon
        return _error(request_id, "Internal error: %s" % exc)


def _peer_uid(conn):
    fmt = "3i"
    try:
        data = conn.getsockopt(
            socket.SOL_SOCKET, socket.SO_PEERCRED, struct.calcsize(fmt)
        )
        _pid, uid, _gid = struct.unpack(fmt, data)
        return uid
    except (AttributeError, OSError):
        return None


def _write_response(handle, response):
    handle.write((json.dumps(response, ensure_ascii=False) + "\n").encode("utf-8"))
    handle.flush()


def handle_connection(conn, broker, stop_event):
    try:
        conn.settimeout(30.0)
        uid = _peer_uid(conn)
        if uid is None:
            _write_response(
                conn.makefile("wb"),
                _error(None, "Could not verify the client UID"),
            )
            return
        if uid != os.getuid():
            _write_response(
                conn.makefile("wb"),
                _error(None, "Access denied: client UID differs"),
            )
            return
        handle = conn.makefile("rwb")
        while not stop_event.is_set():
            try:
                raw = handle.readline(MAX_LINE + 1)
            except (OSError, TimeoutError):
                return
            if not raw:
                return
            if len(raw) > MAX_LINE:
                _write_response(handle, _error(None, "The request is too large"))
                return
            if not raw.strip():
                continue
            try:
                request = json.loads(raw.decode("utf-8"))
            except (UnicodeDecodeError, json.JSONDecodeError) as exc:
                _write_response(handle, _error(None, "Invalid JSON: %s" % exc))
                continue
            if isinstance(request, dict) and request.get("op") == "shutdown":
                _write_response(handle, _ok(request.get("id"), {"shutdown": True}))
                stop_event.set()
                return
            response = dispatch(broker, request)
            _write_response(handle, response)
    except (BrokenPipeError, ConnectionResetError, OSError):
        return
    finally:
        try:
            conn.close()
        except OSError:
            pass


def _socket_is_live(path):
    probe = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    probe.settimeout(0.4)
    try:
        probe.connect(path)
        return True
    except OSError:
        return False
    finally:
        probe.close()


def run_daemon():
    path = socket_path()
    directory = os.path.dirname(path)
    try:
        os.makedirs(directory, mode=0o700, exist_ok=True)
    except OSError as exc:
        print("KimAI could not prepare the socket directory: %s" % exc, file=sys.stderr)
        return 1

    if os.path.lexists(path):
        try:
            is_socket = stat.S_ISSOCK(os.lstat(path).st_mode)
        except OSError:
            is_socket = False
        if not is_socket:
            print(
                "%s exists but is not a socket; leaving it alone" % path,
                file=sys.stderr,
            )
            return 1
        if _socket_is_live(path):
            print("KimAI is already running at %s" % path, file=sys.stderr)
            return 1
        try:
            os.unlink(path)
        except OSError as exc:
            print("KimAI could not remove the stale socket: %s" % exc, file=sys.stderr)
            return 1

    old_umask = os.umask(0o077)
    server = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    try:
        server.bind(path)
        os.chmod(path, 0o600)
        server.listen(16)
    except OSError as exc:
        server.close()
        os.umask(old_umask)
        print("KimAI could not bind %s: %s" % (path, exc), file=sys.stderr)
        return 1
    finally:
        os.umask(old_umask)

    if stat.S_IMODE(os.stat(path).st_mode) != 0o600:
        print("KimAI could not set socket mode 0600", file=sys.stderr)
        server.close()
        return 1

    stop_event = threading.Event()
    broker = Broker(time.monotonic())

    def _handle_signal(_signum, _frame):
        stop_event.set()

    signal.signal(signal.SIGTERM, _handle_signal)
    signal.signal(signal.SIGINT, _handle_signal)

    print(
        "KimAI %s listening on %s (mode 0600)" % (VERSION, path),
        file=sys.stderr,
        flush=True,
    )
    server.settimeout(0.5)
    try:
        while not stop_event.is_set():
            try:
                conn, _addr = server.accept()
            except socket.timeout:
                continue
            except OSError:
                break
            thread = threading.Thread(
                target=handle_connection,
                args=(conn, broker, stop_event),
                daemon=True,
            )
            thread.start()
    finally:
        server.close()
        try:
            if os.path.lexists(path) and stat.S_ISSOCK(os.lstat(path).st_mode):
                os.unlink(path)
        except OSError:
            pass
        print("KimAI stopped.", file=sys.stderr, flush=True)
    return 0


class ClientError(Exception):
    pass


def rpc(op, args=None, timeout=8.0):
    path = socket_path()
    if not os.path.exists(path):
        raise ClientError(NOT_RUNNING)
    request = {"id": uuid.uuid4().hex, "op": op, "args": args or {}}
    client = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    client.settimeout(3.0)
    try:
        client.connect(path)
        client.settimeout(timeout)
        client.sendall((json.dumps(request, ensure_ascii=False) + "\n").encode("utf-8"))
        handle = client.makefile("rb")
        raw = handle.readline(MAX_LINE + 1)
        if not raw:
            raise ClientError(NOT_RUNNING)
        if len(raw) > MAX_LINE:
            raise ClientError("The KimAI response is too large")
        response = json.loads(raw.decode("utf-8"))
        if not isinstance(response, dict):
            raise ClientError("The KimAI response is invalid")
        if response.get("id") != request["id"]:
            raise ClientError("The KimAI response does not match the request")
        return response
    except (OSError, TimeoutError, json.JSONDecodeError, UnicodeDecodeError):
        raise ClientError(NOT_RUNNING)
    finally:
        try:
            client.close()
        except OSError:
            pass


def _print_error(message):
    print(message, file=sys.stderr)


def _not_running():
    _print_error(NOT_RUNNING)
    return 1


def _usage(stream=sys.stdout):
    stream.write(
        "Usage:\n"
        "  kimai start\n"
        "  kimai stop\n"
        "  kimai status\n"
        '  kimai ask "<prompt>"\n'
        "  kimai events [--limit N]\n"
        "  kimai approve list\n"
        '  kimai approve yes <request_id> [--note "..."]\n'
        '  kimai approve no  <request_id> [--note "..."]\n'
    )


def _parse_note(parts):
    note = ""
    index = 0
    while index < len(parts):
        if parts[index] == "--note" and index + 1 < len(parts):
            note = parts[index + 1]
            index += 2
        else:
            raise ValueError("unknown option: %s" % parts[index])
    return note


def _parse_limit(parts, default=10):
    limit = default
    index = 0
    while index < len(parts):
        if parts[index] == "--limit" and index + 1 < len(parts):
            try:
                limit = int(parts[index + 1])
            except ValueError:
                raise ValueError("--limit expects an integer")
            if limit < 0:
                raise ValueError("--limit must not be negative")
            index += 2
        else:
            raise ValueError("unknown option: %s" % parts[index])
    return limit


def _format_args(value):
    try:
        return json.dumps(value, ensure_ascii=False, sort_keys=True)
    except (TypeError, ValueError):
        return str(value)


def _show_list(result):
    pending = result.get("pending") or []
    recent = result.get("recent") or []
    if not pending and not recent:
        print("No approval requests.")
        return
    if pending:
        print("Awaiting approval (%d):" % len(pending))
        for entry in pending:
            print(
                "  %s  %s:%s  risk=%s"
                % (
                    entry.get("request_id"),
                    entry.get("tool"),
                    entry.get("action"),
                    entry.get("risk") or "-",
                )
            )
            if entry.get("reason"):
                print("    reason: %s" % entry["reason"])
            print("    args: %s" % _format_args(entry.get("args")))
            print("    requested: %s" % entry.get("ts"))
    else:
        print("No pending approval requests.")
    if recent:
        print("Recent decisions (%d):" % len(recent))
        for entry in recent:
            print(
                "  [%s] %s  %s:%s  note=%s"
                % (
                    entry.get("decision"),
                    entry.get("request_id"),
                    entry.get("tool"),
                    entry.get("action"),
                    entry.get("note") or "-",
                )
            )


def _show_events(limit):
    events = read_events(limit)
    if not events:
        print("No events recorded.")
        return
    for entry in reversed(events):
        print(
            "%s  %-8s  %-14s  %s"
            % (
                entry.get("ts", "-"),
                entry.get("severity", "-"),
                entry.get("kind", "-"),
                entry.get("summary", "-"),
            )
        )


def main(argv):
    if len(argv) < 2:
        _usage(sys.stderr)
        return 2
    command = argv[1]
    if command in ("-h", "--help", "help"):
        _usage()
        return 0
    if command == "start":
        if len(argv) != 2:
            _usage(sys.stderr)
            return 2
        return run_daemon()
    if command == "stop":
        try:
            response = rpc("shutdown", timeout=5.0)
        except ClientError:
            return _not_running()
        if not response.get("ok"):
            _print_error(response.get("error", "KimAI failed to stop"))
            return 1
        try:
            path = socket_path()
            if os.path.lexists(path) and stat.S_ISSOCK(os.lstat(path).st_mode):
                os.unlink(path)
        except OSError:
            pass
        print("KimAI stopped.")
        return 0
    if command == "status":
        try:
            response = rpc("status", timeout=5.0)
        except ClientError:
            return _not_running()
        if not response.get("ok"):
            _print_error(response.get("error", "KimAI failed to report status"))
            return 1
        print(
            json.dumps(
                response.get("result", {}), ensure_ascii=False, indent=2, sort_keys=True
            )
        )
        return 0
    if command == "events":
        try:
            limit = _parse_limit(argv[2:])
        except ValueError as exc:
            _print_error(str(exc))
            return 2
        _show_events(limit)
        return 0
    if command == "ask":
        if len(argv) < 3:
            _usage(sys.stderr)
            return 2
        prompt = " ".join(argv[2:])
        try:
            response = rpc("ask", {"prompt": prompt}, timeout=300.0)
        except ClientError:
            return _not_running()
        if not response.get("ok"):
            _print_error(response.get("error", AI_NOT_CONFIGURED))
            return 1
        answer = response.get("result", {}).get("answer", "")
        sys.stdout.write(answer)
        if not answer.endswith("\n"):
            sys.stdout.write("\n")
        return 0
    if command == "approve":
        if len(argv) < 3:
            _usage(sys.stderr)
            return 2
        action = argv[2]
        if action == "list":
            if len(argv) != 3:
                _usage(sys.stderr)
                return 2
            try:
                response = rpc("approve.list", timeout=5.0)
            except ClientError:
                return _not_running()
            if not response.get("ok"):
                _print_error(response.get("error", "KimAI failed to list requests"))
                return 1
            _show_list(response.get("result", {}))
            return 0
        if action in ("yes", "no"):
            if len(argv) < 4:
                _usage(sys.stderr)
                return 2
            request_id = argv[3]
            try:
                note = _parse_note(argv[4:])
            except ValueError as exc:
                _print_error(str(exc))
                return 2
            decision = "approve" if action == "yes" else "reject"
            try:
                response = rpc(
                    "approve.decide",
                    {"request_id": request_id, "decision": decision, "note": note},
                    timeout=5.0,
                )
            except ClientError:
                return _not_running()
            if not response.get("ok"):
                _print_error(response.get("error", "KimAI failed to record the decision"))
                return 1
            if decision == "approve":
                print("Request %s approved." % request_id)
            else:
                print("Request %s rejected." % request_id)
            return 0
        _usage(sys.stderr)
        return 2
    _usage(sys.stderr)
    return 2


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv))
    except KeyboardInterrupt:
        sys.exit(130)
